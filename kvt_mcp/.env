# MCP сервер для KVT-C - Конфигурация

# Основной IP адрес системы KVT-C
# Если все компоненты на одной машине, установите здесь её IP
# Компоненты будут использовать этот адрес, если не переопределены ниже
KVT_HOST=127.0.0.1

# Компоненты системы (переопределяют KVT_HOST если указаны)
KVT_VISUALIZER_HOST=127.0.0.1
KVT_VISUALIZER_PORT=5000

KVT_POLLER_HOST=127.0.0.1
KVT_POLLER_PORT=5001

KVT_ARCHIVER_HOST=127.0.0.1
KVT_ARCHIVER_PORT=5002

KVT_OPCUA_HOST=127.0.0.1
KVT_OPCUA_PORT=4840

KVT_MQTT_HOST=127.0.0.1
KVT_MQTT_PORT=1883

# Таймауты
KVT_REQUEST_TIMEOUT=10
KVT_CONNECTION_TIMEOUT=5
