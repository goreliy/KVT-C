# MCP сервер для KVT-C

Конфигурация подключения к компонентам системы мониторинга KVT-C.
Скопируйте этот файл в `.env` и отредактируйте значения для вашей системы.

## Основной адрес системы KVT-C

# Основной IP адрес, на котором запущена система KVT-C
# Все компоненты по умолчанию используют этот адрес
# Если компоненты на разных машинах, переопределите каждый отдельно ниже
KVT_HOST=127.0.0.1

## Компоненты системы

### Visualizer (веб-интерфейс)
# Если не указано, использует KVT_HOST
KVT_VISUALIZER_HOST=127.0.0.1
KVT_VISUALIZER_PORT=5000

### Poller (опрос Modbus)
# Если не указано, использует KVT_HOST
KVT_POLLER_HOST=127.0.0.1
KVT_POLLER_PORT=5001

### Archiver (архивирование данных)
# Если не указано, использует KVT_HOST
KVT_ARCHIVER_HOST=127.0.0.1
KVT_ARCHIVER_PORT=5002

### OPC UA сервер
# Если не указано, использует KVT_HOST
KVT_OPCUA_HOST=127.0.0.1
KVT_OPCUA_PORT=4840

### MQTT bridge
# Если не указано, использует KVT_HOST
KVT_MQTT_HOST=127.0.0.1
KVT_MQTT_PORT=1883
# KVT_MQTT_USERNAME=mqtt_user
# KVT_MQTT_PASSWORD=mqtt_password

## Таймауты и пути

# Таймаут обычных HTTP запросов (секунды)
KVT_REQUEST_TIMEOUT=10

# Таймаут установки соединения (секунды)
KVT_CONNECTION_TIMEOUT=5

# Путь к директории данных системы
KVT_DATA_DIR=./data

# Путь к директории конфигурации системы
KVT_CONFIG_DIR=./data/config
