function textInput(value, onchange, style) {
  const input = h('input', { value: value ?? '', style });
  input.addEventListener('input', () => onchange(input.value));
  return input;
}

function numberInput(value, onchange, style) {
  const input = h('input', { type: 'number', value: String(value ?? 0), style });
  input.addEventListener('input', () => onchange(Number(input.value)));
  return input;
}

function selectInput(options, value, onchange) {
  const select = h('select', {}, options.map(([id, text]) => h('option', { value: id, text })));
  select.value = value ?? '';
  select.addEventListener('change', () => onchange(select.value));
  return select;
}

function checkboxInput(value, onchange) {
  const input = h('input', { type: 'checkbox' });
  input.checked = value;
  input.addEventListener('change', () => onchange(input.checked));
  return input;
}

/** Ячейка значения с явным признаком достоверности (ТЗ 13.3). */
function valueCell(view) {
  const state = widgetState(view, null);
  const bad = state !== 'normal';
  const cell = h('td', { class: 'num ' + (bad ? 'q q-bad' : 'q') });
  cell.append(h('span', { class: 'value', text: formatValue(view, {}) }));
  if (bad) cell.append(h('span', { class: 'q-tag', text: qualityMark(state) || 'недостоверно' }));
  // Имитация помечается независимо от качества: вымышленная величина бывает
  // и «достоверной» с точки зрения обмена — обмен-то состоялся.
  if (view && view.simulated) cell.append(h('span', { class: 'sim-tag', text: 'ИМИТАЦИЯ' }));
  return cell;
}

