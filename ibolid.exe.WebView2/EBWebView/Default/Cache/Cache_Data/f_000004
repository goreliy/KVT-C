async function tags({ host, live, toast, reportError }) {
  let filter = '';
  let onlyBad = false;
  let onlyWritable = false;

  const search = h('input', {
    type: 'search', placeholder: 'фильтр по имени, например line1.dev5.*',
    oninput: (e) => { filter = e.target.value.trim(); redraw(); },
  });
  const badBox = h('input', { type: 'checkbox', onchange: (e) => { onlyBad = e.target.checked; redraw(); } });
  const writableBox = h('input', { type: 'checkbox', onchange: (e) => { onlyWritable = e.target.checked; redraw(); } });
  const count = h('span', { class: 'muted' });

  host.append(
    h('h2', { text: 'Теги' }),
    h('div', { class: 'toolbar' }, [
      search,
      h('label', {}, [badBox, ' только недостоверные']),
      h('label', {}, [writableBox, ' только записываемые']),
      h('span', { class: 'spacer' }),
      count,
    ]),
  );

  const body = h('tbody');
  host.append(h('table', {}, [
    h('thead', {}, h('tr', {}, ['Тег', 'Название', 'Значение', 'Качество', 'Обновлено', '']
      .map((t) => h('th', { text: t })))),
    body,
  ]));

  function matches(view) {
    if (onlyBad && view.good) return false;
    if (onlyWritable && !view.writable) return false;
    if (!filter) return true;
    if (filter.includes('*')) {
      const rx = new RegExp('^' + filter.split('*').map(escapeRx).join('.*') + '$');
      return rx.test(view.name);
    }
    const needle = filter.toLowerCase();
    // Поиск идёт и по названию: у импортированных профилей имя тега машинное
    // (`r36864`), и искать «температуру» по нему невозможно.
    return view.name.toLowerCase().includes(needle)
      || (view.title || '').toLowerCase().includes(needle);
  }

  function redraw() {
    const rows = live.all().filter(matches).sort((a, b) => a.name.localeCompare(b.name));
    count.textContent = `${rows.length} из ${live.tags.size}`;
    body.replaceChildren(...rows.slice(0, 500).map((view) => h('tr', {
      class: view.simulated ? 'row-sim' : '',
    }, [
      h('td', { class: 'mono', text: view.name }),
      // Название рядом с именем, а не вместо него: по имени тег ищут в
      // конфигурации и в правилах, а название объясняет, что это за величина.
      h('td', { text: view.title || '' }),
      valueCell(view),
      h('td', { class: view.good ? 'muted' : '', text: view.quality }),
      h('td', { class: 'muted', text: timeText(view.updated_at_us) }),
      h('td', {}, view.writable && hasRole('operator')
        ? h('button', { text: 'записать', onclick: () => promptWrite(view) })
        : null),
    ])));
    if (rows.length > 500) {
      body.append(h('tr', {}, h('td', { colspan: 6, class: 'muted', text: `показаны первые 500 из ${rows.length}` })));
    }
  }

  async function promptWrite(view) {
    const ok = await writeDialog(view);
    if (ok) {
      // Приём команды не выдаётся за исполнение: подтверждением служит
      // следующее чтение тега (ТЗ 13.3).
      toast(`команда по «${view.name}» принята, ожидается подтверждение прибором`, 'ok');
    }
  }

  const onTags = () => redraw();
  live.addEventListener('tags', onTags);
  redraw();
  return { dispose: () => live.removeEventListener('tags', onTags) };
}

/**
 * Окно записи величины в тег (FR-723.1).
 *
 * Показывает текущее значение **с его качеством**: команда, поданная по
 * устаревшему показанию, — частая причина ошибочных действий, и оператор
 * обязан видеть, на что он смотрит.
 */
export async function writeDialog(view) {
  const state = widgetState(view, null);
  const bad = state !== 'normal';
  const input = h('input', {
    value: view.value === null || view.value === undefined ? '' : String(view.value),
    placeholder: 'число, либо да / нет',
  });

  const body = h('div', {}, [
    h('p', { class: 'mono', text: view.name }),
    h('p', {}, [
      'текущее значение: ',
      h('span', { class: bad ? 'q q-bad' : '' }, [
        h('span', { class: 'value', text: formatValue(view, {}) }),
        bad ? h('span', { class: 'q-tag', text: qualityMark(state) || view.quality }) : null,
      ]),
    ]),
    bad
      ? h('p', { class: 'error', text: 'значение недостоверно — убедитесь, что команда уместна' })
      : null,
    h('label', {}, ['новое значение', input]),
  ]);

  return modal({
    title: 'Запись в тег',
    body,
    confirmText: 'Записать',
    danger: true,
    onConfirm: async () => {
      const value = parseWriteValue(input.value);
      if (value === undefined) throw new Error('величина должна быть числом либо «да»/«нет»');
      await api.write(view.name, value);
      return true;
    },
  });
}

function parseWriteValue(text) {
  const t = text.trim().toLowerCase();
  if (['да', 'true', 'вкл', 'on', '1'].includes(t)) return t === '1' ? 1 : true;
  if (['нет', 'false', 'выкл', 'off', '0'].includes(t)) return t === '0' ? 0 : false;
  const n = Number(t.replace(',', '.'));
  return Number.isFinite(n) ? n : undefined;
}

const escapeRx = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

// ── События ─────────────────────────────────────────────────────────

async function events({ host, toast, reportError }) {
  host.append(h('h2', { text: 'События и нарушения' }));

  const active = h('div');
  const log = h('div');
  host.append(h('h3', { text: 'Активные нарушения' }), active, h('h3', { text: 'Журнал событий' }), log);

  async function refresh() {
    const [violations, list] = await Promise.all([api.activeViolations(), api.events(200)]);
    active.replaceChildren(violations.length
      ? violationTable(violations, acknowledge)
      : h('p', { class: 'empty', text: 'активных нарушений нет' }));
    log.replaceChildren(list.length
      ? table(['Время', 'Приоритет', 'Вид', 'Источник', 'Сообщение'],
        list.map((e) => [
          timeText(e.at_us),
          h('span', { class: 'lvl lvl-' + levelClass(e.priority), text: e.priority }),
          e.kind, e.source, e.message,
        ]))
      : h('p', { class: 'empty', text: 'событий нет' }));
  }

  async function acknowledge(violation) {
    const done = await ackDialog(violation);
    if (done) {
      toast(`квитировано: ${violation.tag}`, 'ok');
      await refresh();
    }
  }

  await refresh();
  const timer = setInterval(() => refresh().catch(() => {}), 5000);
  return { dispose: () => clearInterval(timer) };
}

/**
 * Окно квитирования (FR-507.1, FR-507.3).
 *
 * Комментарий для тревог обязателен — это правило сервера, и спрашивать его
 * надо до запроса, а не показывать отказ после. Обстоятельства нарушения
 * приводятся здесь же: квитирование без них превращается в нажатие кнопки.
 */
export async function ackDialog(violation) {
  const needsComment = ['alarm', 'critical'].includes(levelClass(violation.priority));
  const comment = h('textarea', { rows: 3, placeholder: needsComment ? 'причина и принятые меры (обязательно)' : 'примечание' });

  const body = h('div', {}, [
    h('p', { class: 'mono', text: violation.tag }),
    h('table', {}, h('tbody', {}, [
      ['уровень', violation.level],
      ['приоритет', violation.priority],
      ['начало', timeText(violation.started_at_us)],
      ['значение при возникновении', violation.value_at_start],
      ['пиковое значение', violation.peak_value],
      ['порог', violation.limit ?? '—'],
    ].map(([k, v]) => h('tr', {}, [
      h('td', { class: 'muted', text: k }),
      h('td', { text: String(v) }),
    ])))),
    h('label', {}, ['комментарий', comment]),
  ]);

  return modal({
    title: 'Квитирование нарушения',
    body,
    confirmText: 'Квитировать',
    onConfirm: async () => {
      if (needsComment && !comment.value.trim()) {
        throw new Error('для приоритета «тревога» комментарий обязателен');
      }
      await api.acknowledge(violation.tag, comment.value);
      return true;
    },
  });
}

// ── Журналы с диска (разделы 11.7, 11.9) ────────────────────────────

/** Скачивание текста файлом. */
function downloadText(text, filename, type = 'text/csv;charset=utf-8') {
  const url = URL.createObjectURL(new Blob([text], { type }));
  const link = h('a', { href: url, download: filename });
  document.body.append(link);
  link.click();
  link.remove();
  URL.revokeObjectURL(url);
}

/**
 * Журналы: события за период и аудит.
 *
 * Отличается от экрана «События» тем, что читает **диск**, а не оперативный
 * срез: срез живёт от запуска службы, а разбираться приходится с прошлой
 * недели. Обе выборки выгружаются в CSV — с этого начинается сдача объекта.
 */
async function journal({ host, toast, reportError, hasRole }) {
  let tab = 'events';
  const body = h('div');

  const tabs = h('div', { class: 'toolbar' }, [
    h('button', { class: 'primary', text: 'События', onclick: () => switchTo('events') }),
    hasRole('admin')
      ? h('button', { text: 'Аудит', onclick: () => switchTo('audit') })
      : null,
    h('button', { text: 'Нарушения', onclick: () => switchTo('violations') }),
  ]);

  host.append(h('h2', { text: 'Журналы' }), tabs, body);

  function switchTo(next) {
    tab = next;
    for (const b of tabs.querySelectorAll('button')) {
      const active = (b.textContent === 'События' && next === 'events')
        || (b.textContent === 'Аудит' && next === 'audit')
        || (b.textContent === 'Нарушения' && next === 'violations');
      b.classList.toggle('primary', active);
    }
    render();
  }

  async function render() {
    body.replaceChildren(h('p', { class: 'muted', text: 'чтение журнала…' }));
    try {
      if (tab === 'events') await renderEvents();
      else if (tab === 'audit') await renderAudit();
      else await renderViolations();
    } catch (e) {
      body.replaceChildren(h('p', { class: 'empty', text:
        e.status === 503
          ? 'журнал не ведётся: служба запущена без каталога данных (--data-dir)'
          : 'журнал не прочитан: ' + e.message }));
    }
  }

  /** Границы периода в микросекундах по выбору «за сколько». */
  function periodFilter(select) {
    const seconds = Number(select.value);
    if (!seconds) return {};
    const to = Date.now() * 1000;
    return { from_us: to - seconds * 1_000_000, to_us: to };
  }

  async function renderEvents() {
    const period = h('select', {}, [
      ['3600', 'час'], ['86400', 'сутки'], ['604800', 'неделя'],
      ['2592000', 'месяц'], ['0', 'всё время'],
    ].map(([v, t]) => h('option', { value: v, text: t })));
    period.value = '86400';
    const priority = h('select', {}, [
      ['', 'любой приоритет'], ['info', 'от сообщения'], ['warning', 'от предупреждения'],
      ['alarm', 'от тревоги'], ['critical', 'только критические'],
    ].map(([v, t]) => h('option', { value: v, text: t })));
    const source = h('input', { type: 'search', placeholder: 'источник начинается с' });
    const count = h('span', { class: 'muted' });
    const rows = h('tbody');

    const filter = () => ({
      ...periodFilter(period),
      min_priority: priority.value || undefined,
      source: source.value.trim() || undefined,
      limit: 1000,
    });

    async function reload() {
      const r = await api.journalEvents(filter());
      count.textContent = `показано ${r.events.length} из ${r.total} в журнале`;
      rows.replaceChildren(...r.events.map((e) => h('tr', {}, [
        h('td', { class: 'muted', text: timeText(e.at_us) }),
        h('td', {}, h('span', { class: 'lvl lvl-' + levelClass(e.priority), text: e.priority })),
        h('td', { text: e.kind }),
        h('td', { class: 'mono', text: e.source }),
        h('td', { text: e.message }),
        h('td', { class: 'num', text: e.duration_us ? (e.duration_us / 1e6).toFixed(1) + ' с' : '' }),
      ])));
      if (!r.events.length) {
        rows.append(h('tr', {}, h('td', { colspan: 6, class: 'muted', text: 'за выбранный период событий нет' })));
      }
    }

    for (const control of [period, priority]) control.addEventListener('change', () => reload().catch(reportError));
    source.addEventListener('change', () => reload().catch(reportError));

    body.replaceChildren(
      h('div', { class: 'toolbar' }, [
        period, priority, source,
        h('button', { text: 'выгрузить CSV', onclick: async () => {
          try {
            const text = await api.exportCsv('/journal/events/export', { ...filter(), limit: 50000 });
            downloadText(text, 'events.csv');
            toast('журнал событий выгружен', 'ok');
          } catch (e) { reportError(e); }
        } }),
        h('span', { class: 'spacer' }), count,
      ]),
      h('table', {}, [
        h('thead', {}, h('tr', {}, ['Время', 'Приоритет', 'Вид', 'Источник', 'Сообщение', 'Длит.']
          .map((t) => h('th', { text: t })))),
        rows,
      ]),
    );
    await reload();
  }

  async function renderAudit() {
    const user = h('input', { type: 'search', placeholder: 'пользователь' });
    const operation = h('input', { type: 'search', placeholder: 'операция содержит' });
    const object = h('input', { type: 'search', placeholder: 'объект содержит' });
    const period = h('select', {}, [
      ['0', 'всё время'], ['86400', 'сутки'], ['604800', 'неделя'], ['2592000', 'месяц'],
    ].map(([v, t]) => h('option', { value: v, text: t })));
    const count = h('span', { class: 'muted' });
    const rows = h('tbody');

    const filter = () => ({
      ...periodFilter(period),
      user: user.value.trim() || undefined,
      operation: operation.value.trim() || undefined,
      object: object.value.trim() || undefined,
      limit: 1000,
    });

    async function reload() {
      const r = await api.audit(filter());
      count.textContent = `показано ${r.records.length} из ${r.total} в журнале`;
      rows.replaceChildren(...r.records.map((a) => h('tr', {}, [
        h('td', { class: 'muted', text: timeText(a.at_us) }),
        h('td', { class: 'mono', text: a.user }),
        h('td', { text: a.operation }),
        h('td', { class: 'mono', text: a.object }),
        h('td', { text: a.details }),
        // Значения до и после нужны записи в прибор: без них по журналу не
        // восстановить, что именно изменилось (FR-511.1).
        h('td', { class: 'mono', text: (a.before ?? '') + (a.after ? ' → ' + a.after : '') }),
      ])));
      if (!r.records.length) {
        rows.append(h('tr', {}, h('td', { colspan: 6, class: 'muted', text: 'записей по условиям нет' })));
      }
    }

    for (const control of [user, operation, object, period]) {
      control.addEventListener('change', () => reload().catch(reportError));
    }

    body.replaceChildren(
      h('p', { class: 'muted', text:
        'Аудит показывает, кто что делал: входы, записи в приборы, правку конфигурации, '
        + 'управление учётными записями, поиск приборов. Пароли в него не попадают.' }),
      h('div', { class: 'toolbar' }, [
        period, user, operation, object,
        h('button', { text: 'выгрузить CSV', onclick: async () => {
          try {
            const text = await api.exportCsv('/audit/export', { ...filter(), limit: 50000 });
            downloadText(text, 'audit.csv');
            toast('аудит выгружен', 'ok');
          } catch (e) { reportError(e); }
        } }),
        h('span', { class: 'spacer' }), count,
      ]),
      h('table', {}, [
        h('thead', {}, h('tr', {}, ['Время', 'Пользователь', 'Операция', 'Объект', 'Подробности', 'До → после']
          .map((t) => h('th', { text: t })))),
        rows,
      ]),
    );
    await reload();
  }

  async function renderViolations() {
    const r = await api.journalViolations();
    const active = r.violations.filter((v) => !v.acknowledged);
    body.replaceChildren(
      h('p', { class: 'muted', text:
        `всего нарушений в журнале ${r.violations.length}, из них неквитированных ${active.length}` }),
      r.violations.length
        ? table(
          ['Тег', 'Уровень', 'Приоритет', 'Начало', 'Значение', 'Пик', 'Порог', 'Квитировано'],
          r.violations.map((v) => [
            v.tag,
            h('span', { class: 'lvl lvl-' + levelClass(v.priority), text: v.level }),
            v.priority,
            timeText(v.started_at_us),
            v.value_at_start,
            v.peak_value,
            v.limit ?? '—',
            v.acknowledged ? (v.acknowledged_by || 'да') : 'нет',
          ]),
        )
        : h('p', { class: 'empty', text: 'нарушений в журнале нет' }),
    );
  }

  await render();
}

// ── Приборы ─────────────────────────────────────────────────────────

/**
 * Отклик прибора словами.
 *
 * Микросекунды приходят с планировщика: на 115200 бод короткий кадр
 * оборачивается за сотни микросекунд, и округление до миллисекунд показало бы
 * ноль там, где обмен состоялся.
 */
function rttText(us) {
  const value = Number(us);
  if (!Number.isFinite(value) || value <= 0) return '—';
  if (value < 1000) return `${Math.round(value)} мкс`;
  const ms = value / 1000;
  return `${ms < 10 ? ms.toFixed(1).replace('.', ',') : Math.round(ms)} мс`;
}

/**
 * Группы опроса с изменением периода на ходу.
 *
 * Период подбирают на объекте по фактической загрузке линии: заявленные
 * 500 мс на линии из сорока приборов не выдерживаются. Требовать перезапуск
 * службы на каждую попытку означало бы прерывать наблюдение при каждой
 * итерации подбора — поэтому изменение применяется сразу.
 *
 * Временность изменения показана прямо в таблице: подобранное значение
 * теряется при перезапуске, и об этом нужно помнить, а не узнавать.
 */
async function pollGroupsPanel({ host, toast, reportError, hasRole, refresh }) {
  if (!hasRole('engineer')) return;
  const groups = await api.pollGroups().then((r) => r.items).catch(() => null);
  if (!groups || !groups.length) return;

  // Панель раскрыта, если период уже меняли на ходу: временное изменение не
  // должно быть спрятано за свёрнутым заголовком.
  // `open: false` пришлось бы записать атрибутом `open="false"`, а он в HTML
  // всё равно раскрывает блок; отсутствие атрибута выражается только пропуском.
  const box = h('details', {
    class: 'cfg-block',
    open: groups.some((g) => g.changed) ? '' : undefined,
  });
  box.append(h('summary', { text: 'Группы опроса — периоды' }));
  const temporary = groups.filter((g) => g.changed);
  if (temporary.length) {
    box.append(h('p', { class: 'warn-line', text:
      'Изменено на ходу: ' + temporary.map((g) => g.id).join(', ')
      + '. До перезапуска. Чтобы сохранить — задайте период в настройке и примените конфигурацию.' }));
  }

  const rows = groups.map((g) => {
    const field = h('input', {
      type: 'number', min: '0', step: '10', value: String(g.period_ms),
      style: 'width:7em', title: 'ноль — опрос только по запросу',
    });
    const apply = async (value) => {
      try {
        const answer = await api.setPollPeriod(g.id, value);
        toast(`группа «${g.id}»: период ${value ? value + ' мс' : 'только по запросу'}`
          + `, приборов ${answer.devices.length} — ${answer.note}`);
        await refresh();
      } catch (e) {
        reportError(e);
        field.value = String(g.period_ms);
      }
    };
    return [
      g.id,
      g.class,
      g.tags ? `${g.devices} / ${g.tags}` : h('span', { class: 'muted', text: 'не используется' }),
      cadenceText(g.configured_period_ms),
      h('span', {}, [
        field,
        h('button', {
          class: 'small', text: 'применить',
          onclick: () => apply(Math.max(0, Math.round(Number(field.value) || 0))),
        }),
        g.changed
          ? h('button', {
              class: 'small', text: 'вернуть заданный',
              title: 'вернуть период из конфигурации',
              onclick: () => apply(g.configured_period_ms),
            })
          : '',
      ]),
      g.changed ? h('span', { class: 'lvl lvl-warning', text: 'до перезапуска' }) : '',
    ];
  });
  box.append(table(
    ['Группа', 'Класс', 'Приборов / тегов', 'В конфигурации', 'Действует, мс', ''],
    rows,
  ));
  host.append(box);
}

/**
 * Пуск либо остановка канала.
 *
 * Остановка освобождает порт, поэтому спрашивается подтверждение: линия
 * перестаёт опрашиваться целиком, и значения её тегов становятся
 * недостоверными — показать прежние как текущие значило бы дать оператору
 * решать по данным, которых уже нет.
 */
async function switchChannel(channel, { toast, reportError, refresh }) {
  const stopping = channel.running;
  if (stopping) {
    const confirmed = await modal({
      title: `Остановить канал «${channel.id}»?`,
      body: h('div', {}, [
        h('p', {}, [
          'Опрос линии прекратится, порт ',
          h('span', { class: 'mono', text: channel.address || '' }),
          ' освободится. Значения её тегов станут недостоверными.',
        ]),
        h('p', { class: 'muted', text:
          `Приборов на линии: ${channel.devices}. Остальные линии продолжат работать.` }),
        h('p', { class: 'muted', text:
          'Остановка действует до перезапуска службы. Чтобы она сохранилась, '
          + 'снимите признак «опрашивать» у канала в настройке.' }),
      ]),
      confirmText: 'Остановить',
      onConfirm: async () => true,
    });
    if (!confirmed) return;
  }
  try {
    const answer = await api.setChannelRunning(channel.id, !stopping);
    toast(answer.note, 'ok');
    await refresh();
  } catch (e) { reportError(e); }
}

async function devices({ host, live, toast, reportError, hasRole }) {
  const groupsHost = h('div', {});
  const body = h('div', {});
  host.append(h('h2', { text: 'Приборы' }));
  host.append(h('p', { class: 'hint', text:
    'Столбец «опрос» показывает заданный период и измеренный. Расхождение — '
    + 'признак перегруженной линии: такты пропускаются, показания стареют, '
    + 'но приборы при этом исправны. Худший интервал считается за последние '
    + 'десятки опросов, а не за всё время работы: иначе переходный процесс при '
    + 'запуске висел бы на экране как неисправность.' }));
  host.append(groupsHost, body);

  // Панель групп перерисовывается только после применения периода: она
  // содержит поля ввода, и обновление по таймеру затирало бы набранное.
  const rebuildGroups = async () => {
    const fresh = h('div', {});
    await pollGroupsPanel({ host: fresh, toast, reportError, hasRole, refresh: rebuildGroups });
    groupsHost.replaceChildren(fresh);
  };
  await rebuildGroups();

  // Измеренный период — величина живая, поэтому таблицы обновляются сами.
  // Иначе наладчик менял бы период и не видел следствия, пока не перезайдёт.
  const timer = setInterval(() => build().catch(() => {}), 3000);
  await build();
  return { dispose: () => clearInterval(timer) };

  async function build() {
    const fresh = h('div', {});
    await fill(fresh);
    body.replaceChildren(fresh);
  }

  async function fill(host) {
  const [list, channels] = await Promise.all([api.devices(), api.channels()]);

  for (const channel of channels) {
    const own = list.filter((d) => d.channel === channel.id);
    // Порт в заголовке линии: «в какой разъём воткнут прибор» — первый вопрос,
    // когда прибор перестал отвечать, и ответ на него не должен требовать
    // перехода на экран настройки.
    host.append(h('h3', {}, [
      h('span', { text: `${channel.id} — ${channel.transport}` }),
      // Разделитель явный, а не отступом: заголовок копируют в отчёт, и
      // «RTU поверх TCP127.0.0.1:5020» там уже не разобрать.
      h('span', { class: 'muted', text: ' · ' }),
      h('span', { class: 'mono', style: 'font-size:13px', text: channel.address || '—' }),
      channel.simulated
        ? h('span', { class: 'lvl lvl-warning', style: 'margin-left:8px',
            text: 'ИМИТАТОР — величины вымышлены' })
        : '',
      channel.running
        ? ''
        : h('span', { class: 'lvl lvl-alarm', style: 'margin-left:8px', text: 'ОСТАНОВЛЕН' }),
      // Пуск и остановка на месте: на пусконаладке линию останавливают, чтобы
      // перевоткнуть преобразователь, и перезапуск службы ради этого порвал бы
      // опрос остальных линий.
      hasRole('engineer')
        ? h('button', {
            class: 'small', style: 'margin-left:10px',
            text: channel.running ? 'остановить' : 'пустить',
            title: channel.running
              ? 'остановить опрос и освободить порт'
              : 'открыть порт и возобновить опрос',
            onclick: () => switchChannel(channel, { toast, reportError, refresh: build }),
          })
        : '',
    ]));
    host.append(table(
      ['Прибор', 'Состояние', 'Опрос: задано → факт', 'Отклик', 'Обменов', 'Тегов', 'Недостоверных'],
      own.map((d) => {
        const prefix = d.path + '.';
        const tags = live.all().filter((t) => t.name.startsWith(prefix));
        const bad = tags.filter((t) => !t.good).length;
        const wanted = Number(d.period_ms || 0);
        const actual = d.actual_period_ms;
        // Отставание считается с запасом: единичный задержанный такт — это
        // норма планировщика, а не повод красить строку.
        const slow = wanted && actual != null && actual > wanted * 1.5 + 50;
        const cadence = !wanted ? h('span', { class: 'muted', text: 'только по запросу' })
          : actual == null
            ? h('span', { class: 'muted', text: `${cadenceText(wanted)} → ещё не повторялся` })
            : h('span', {
                class: slow ? 'lvl lvl-warning' : '',
                text: `${cadenceText(wanted)} → ${cadenceText(actual)}`
                  + (d.worst_period_ms && d.worst_period_ms > actual * 2
                    ? ` (худший ${cadenceText(d.worst_period_ms)})` : ''),
              });
        return [
          h('a', { href: '#/tags', text: d.path, onclick: () => {} }),
          h('span', {
            // Выключенный прибор — не отказ: красный здесь звал бы чинить
            // прибор, снятый с опроса намеренно.
            class: isSwitchedOff(d)
              ? 'state-off'
              : ('state-' + (d.state === 'работает' ? 'online' : 'offline')),
            text: d.state + (d.simulated ? ' (имитация)' : ''),
          }),
          cadence,
          rttText(d.rtt_us)
            + (d.rtt_peak_us && d.rtt_peak_us > (d.rtt_us || 0) * 2
              ? ` (пик ${rttText(d.rtt_peak_us)})` : ''),
          d.failed ? h('span', { text: `${d.ok} / отказов ${d.failed}` }) : String(d.ok || 0),
          d.tags,
          bad ? h('span', { class: 'lvl lvl-alarm', text: String(bad) }) : '0',
        ];
      }),
    ));
  }
  }
}

// ── Монитор канала: журнал обменов (ТЗ 13.13) ───────────────────────

/**
 * Живой поток обменов Modbus.
 *
 * Главный инструмент пусконаладки. Три свойства, без которых он бесполезен:
 *
 *  * поток **дочитывается** по номеру записи, а не перезапрашивается целиком —
 *    при 200 строках в секунду перезапрос уложил бы интерфейс (FR-713.6);
 *  * вытеснение старых строк показано числом: отсутствие строки не должно
 *    приниматься за отсутствие обмена (FR-713.7);
 *  * строка раскрывается в разбор кадра по полям (FR-713.4, FR-713.8).
 */
async function monitor({ host, toast, reportError, hasRole }) {
  if (!hasRole('engineer')) {
    host.append(h('p', { class: 'empty', text: 'журнал обменов доступен роли «инженер» и выше' }));
    return;
  }

  const filter = { failures_only: false };
  let paused = false;
  let lastSeq = 0;
  let hex = true;
  const rows = [];
  const MAX_ROWS = 2000;

  const channels = await api.channels().catch(() => []);
  const devices = await api.devices().catch(() => []);

  const channelPick = h('select', {}, [h('option', { value: '', text: 'все каналы' }),
    ...channels.map((c) => h('option', { value: c.id, text: c.id }))]);
  const devicePick = h('select', {}, [h('option', { value: '', text: 'все приборы' }),
    ...devices.map((d) => h('option', { value: d.path, text: d.path }))]);
  const functionPick = h('select', {}, [
    h('option', { value: '', text: 'все функции' }),
    ...[[1, '01 флаги'], [2, '02 дискретные'], [3, '03 хранения'], [4, '04 ввода'],
      [5, '05 запись флага'], [6, '06 запись регистра'], [15, '0F запись флагов'], [16, '10 запись регистров']]
      .map(([code, name]) => h('option', { value: code, text: name })),
  ]);
  const addrFrom = h('input', { type: 'number', placeholder: 'адрес от', style: 'width:100px' });
  const addrTo = h('input', { type: 'number', placeholder: 'до', style: 'width:90px' });
  const tagFilter = h('input', { type: 'search', placeholder: 'тег содержит', style: 'width:160px' });
  const failuresOnly = h('input', { type: 'checkbox' });

  const pauseButton = h('button', { text: 'пауза', onclick: () => {
    paused = !paused;
    pauseButton.textContent = paused ? 'продолжить' : 'пауза';
    pauseButton.classList.toggle('primary', paused);
  } });

  const status = h('span', { class: 'muted' });
  const evictedNote = h('span', { class: 'muted' });

  host.append(
    h('h2', { text: 'Монитор канала — журнал обменов' }),
    h('div', { class: 'toolbar' }, [
      channelPick, devicePick, functionPick, addrFrom, addrTo, tagFilter,
      h('label', {}, [failuresOnly, ' только отказы']),
    ]),
    h('div', { class: 'toolbar' }, [
      pauseButton,
      h('button', { text: 'очистить', onclick: () => { rows.length = 0; redraw(); } }),
      h('button', { text: hexLabel(), onclick: (e) => {
        hex = !hex;
        e.target.textContent = hexLabel();
        redraw();
      } }),
      h('button', { text: 'сохранить в файл', onclick: save }),
      h('span', { class: 'spacer' }),
      evictedNote, status,
    ]),
  );

  function hexLabel() { return hex ? 'показать десятично' : 'показать шестнадцатерично'; }

  // Состояние линий над таблицей. Пустой журнал сам по себе ничего не
  // объясняет: чаще всего он пуст потому, что порт не открылся, — и искать
  // тогда надо порт, а не прибор.
  const lines = h('div', {});
  host.append(lines);

  async function refreshLines() {
    let list = [];
    try {
      list = await api.channels();
    } catch { return; }
    const chosen = channelPick.value;
    const shown = chosen ? list.filter((c) => c.id === chosen) : list;
    // Выключенная линия — не поломка: её не опрашивают по решению наладчика.
    // Показывать её красной значило бы звать чинить исправное, а спрятать —
    // выдать снятую галочку за потерянную настройку.
    const off = shown.filter((c) => isSwitchedOff(c));
    const bad = shown.filter((c) => !c.running && !isSwitchedOff(c));
    lines.replaceChildren(...[
      h('table', {}, [
        h('thead', {}, h('tr', {}, ['Линия', 'Порт или адрес', 'Состояние', 'Обменов', 'Отказов', 'Последняя ошибка']
          .map((t) => h('th', { text: t })))),
        h('tbody', {}, shown.map((c) => h('tr', {}, [
          h('td', { text: c.id }),
          h('td', { class: 'mono', text: c.address || '—' }),
          h('td', {}, h('span', {
            class: isSwitchedOff(c) ? 'state-off' : (c.running ? 'state-online' : 'state-offline'),
            text: c.port_state || (c.running ? 'работает' : 'состояние неизвестно'),
          })),
          h('td', { class: 'num', text: String(c.exchanges_ok ?? 0) }),
          h('td', { class: 'num', text: String(c.exchanges_failed ?? 0) }),
          h('td', { class: 'muted', text: c.last_error || '' }),
        ]))),
      ]),
      bad.length
        ? h('div', {}, [
          h('p', { class: 'warn-line', text:
            'Обменов не будет, пока линия не заработает: '
            + bad.map((c) => `${c.id} — ${c.port_state || 'не работает'}`).join('; ') }),
          // Линия без периодического опроса — не поломка, а незаданная
          // настройка, и путь исправления надо назвать: иначе инженер ищет
          // неисправность там, где её нет.
          bad.some((c) => (c.port_state || '').includes('только по запросу'))
            ? h('p', { class: 'hint', text:
              'Все регистры прибора лежат в группе с нулевым периодом — так профили '
              + 'описывают параметры настройки, которые не читают циклически. '
              + 'Чтобы прибор опрашивался: «Настройка приборов» → прибор → «период опроса» '
              + 'выберите группу с ненулевым периодом, либо задайте период самой группе '
              + 'на экране «Приборы».' })
            : null,
        ])
        : null,
      off.length
        ? h('p', { class: 'hint', text:
          'Не опрашиваются по настройке: '
          + off.map((c) => `${c.id} — ${c.port_state}`).join('; ')
          + '. Включить: «Настройка приборов» → линия → галочка «опрашивать», '
          + 'затем «Сохранить» и перезапуск службы на экране «Служба».' })
        : null,
    ].filter(Boolean));
  }
  await refreshLines();
  const linesTimer = setInterval(() => refreshLines().catch(() => {}), 2000);

  const body = h('tbody');
  host.append(h('table', { class: 'monitor' }, [
    h('thead', {}, h('tr', {}, ['Время', 'Прибор', 'Функция', 'Адрес', 'Кол-во', 'Попытка', 'Исход', 'Откл.', 'Кадры']
      .map((t) => h('th', { text: t })))),
    body,
  ]));

  function currentFilter() {
    const f = {};
    if (channelPick.value) f.channel = channelPick.value;
    if (devicePick.value) f.device = devicePick.value;
    if (functionPick.value) f.function = Number(functionPick.value);
    if (addrFrom.value !== '') f.address_from = Number(addrFrom.value);
    if (addrTo.value !== '') f.address_to = Number(addrTo.value);
    if (tagFilter.value.trim()) f.tag = tagFilter.value.trim();
    if (failuresOnly.checked) f.failures_only = true;
    return f;
  }

  // Смена условий отбора начинает поток заново: смешивать строки, отобранные
  // по разным условиям, значит показывать выборку, которой не существует.
  for (const control of [channelPick, devicePick, functionPick, addrFrom, addrTo, tagFilter, failuresOnly]) {
    control.addEventListener('change', () => {
      rows.length = 0; lastSeq = 0; redraw(); poll(); refreshLines();
    });
  }

  async function poll() {
    if (paused) return;
    try {
      const f = currentFilter();
      if (lastSeq) f.after_seq = lastSeq;
      const r = await api.exchanges(f, 500);
      lastSeq = r.last_seq;
      if (r.records.length) {
        // Ответ приходит новейшими первыми; в таблице тоже сверху новое.
        rows.unshift(...r.records);
        if (rows.length > MAX_ROWS) rows.length = MAX_ROWS;
        redraw();
      }
      status.textContent = `обменов ${r.total}, отказов ${r.failures}, в буфере ${r.buffered}`;
      evictedNote.textContent = r.evicted
        ? `вытеснено старых записей: ${r.evicted}`
        : '';
    } catch (e) {
      if (e.status === 401) reportError(e);
    }
  }

  function redraw() {
    body.replaceChildren(...rows.slice(0, 300).map((r) => {
      const row = h('tr', { class: r.ok ? '' : 'row-bad' }, [
        h('td', { class: 'muted', text: timeOnly(r.at_us) }),
        h('td', { class: 'mono', text: r.device }),
        h('td', { text: `${pad2(r.function)} ${r.function_name}` }),
        h('td', { class: 'num', text: hex ? '0x' + pad4(r.address) : String(r.address) }),
        h('td', { class: 'num', text: String(r.quantity) }),
        h('td', { class: 'num', text: r.attempt > 1 ? '#' + r.attempt : '' }),
        h('td', {}, h('span', { class: 'lvl lvl-' + (r.ok ? 'info' : 'alarm'), text: r.outcome })),
        h('td', { class: 'num', text: r.rtt_us ? (r.rtt_us / 1000).toFixed(1) + ' мс' : '—' }),
        h('td', { class: 'mono frames' }, [
          h('div', { text: 'TX ' + (hex ? r.tx_hex : r.tx.join(' ')) }),
          h('div', { class: r.rx.length ? '' : 'error', text: r.rx.length
            ? 'RX ' + (hex ? r.rx_hex : r.rx.join(' '))
            : 'RX (нет ответа)' }),
        ]),
      ]);
      row.style.cursor = 'pointer';
      row.addEventListener('click', () => showFrameDetails(r));
      return row;
    }));
    if (rows.length > 300) {
      body.append(h('tr', {}, h('td', { colspan: 9, class: 'muted', text:
        `показаны первые 300 из ${rows.length} накопленных строк` })));
    }
  }

  async function save() {
    try {
      const text = await api.exchangesExport(currentFilter(), 5000);
      const url = URL.createObjectURL(new Blob([text], { type: 'text/plain;charset=utf-8' }));
      const link = h('a', { href: url, download: 'exchanges.txt' });
      document.body.append(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);
      toast('журнал выгружен', 'ok');
    } catch (e) { reportError(e); }
  }

  await poll();
  const timer = setInterval(poll, 1000);
  return {
    dispose: () => {
      clearInterval(timer);
      clearInterval(linesTimer);
    },
  };
}

/** Разбор кадра по полям (FR-713.4, FR-713.8). */
function showFrameDetails(record) {
  const body = h('div', {}, [
    h('table', {}, h('tbody', {}, [
      ['время', timeText(record.at_us)],
      ['канал', record.channel],
      ['прибор', `${record.device} (адрес ${record.unit_id})`],
      ['источник', record.origin],
      ['группа опроса', record.poll_group || '—'],
      ['класс запроса', record.class],
      ['попытка', '#' + record.attempt],
      ['исход', record.outcome],
      ['время отклика', record.rtt_us ? (record.rtt_us / 1000).toFixed(2) + ' мс' : '—'],
      ['теги', record.tags.length ? record.tags.join(', ') : '—'],
    ].map(([k, v]) => h('tr', {}, [
      h('td', { class: 'muted', text: k }),
      h('td', { class: 'mono', text: String(v) }),
    ])))),
    h('h3', { text: 'Запрос' }),
    frameBreakdown(record.tx, true),
    h('h3', { text: 'Ответ' }),
    record.rx.length
      ? frameBreakdown(record.rx, false)
      : h('p', { class: 'error', text: 'ответа не было' }),
  ]);
  modal({ title: 'Разбор кадра', body, confirmText: 'Закрыть', onConfirm: async () => true });
}

/**
 * Раскладка кадра RTU по полям.
 *
 * Контрольная сумма проверяется и показывается с признаком: расхождение —
 * самый частый и самый неочевидный отказ на длинной линии.
 */
function frameBreakdown(bytes, isRequest) {
  if (!bytes.length) return h('p', { class: 'muted', text: 'пусто' });
  const rows = [];
  const hexOf = (b) => b.toString(16).toUpperCase().padStart(2, '0');

  rows.push(['адрес прибора', hexOf(bytes[0]), String(bytes[0])]);
  if (bytes.length > 1) {
    const fn = bytes[1];
    const exception = (fn & 0x80) !== 0;
    rows.push([
      exception ? 'функция (исключение)' : 'функция',
      hexOf(fn),
      exception ? `${fn & 0x7f} + признак исключения` : String(fn),
    ]);
    if (exception && bytes.length > 2) {
      rows.push(['код исключения', hexOf(bytes[2]), exceptionName(bytes[2])]);
    } else if (isRequest && bytes.length >= 6) {
      const addr = (bytes[2] << 8) | bytes[3];
      const qty = (bytes[4] << 8) | bytes[5];
      rows.push(['начальный адрес', hexOf(bytes[2]) + ' ' + hexOf(bytes[3]), String(addr)]);
      rows.push(['количество либо значение', hexOf(bytes[4]) + ' ' + hexOf(bytes[5]), String(qty)]);
    } else if (!isRequest && bytes.length > 2) {
      rows.push(['число байт данных', hexOf(bytes[2]), String(bytes[2])]);
    }
  }

  // Контрольная сумма — два последних байта кадра RTU.
  if (bytes.length >= 4) {
    const body = bytes.slice(0, bytes.length - 2);
    const got = bytes[bytes.length - 2] | (bytes[bytes.length - 1] << 8);
    const want = crc16(body);
    rows.push([
      'контрольная сумма',
      hexOf(bytes[bytes.length - 2]) + ' ' + hexOf(bytes[bytes.length - 1]),
      got === want ? 'сходится' : `НЕ сходится, ожидалось ${want.toString(16).toUpperCase()}`,
    ]);
  }

  return h('table', {}, h('tbody', {}, rows.map(([k, hexText, decoded]) => h('tr', {}, [
    h('td', { class: 'muted', text: k }),
    h('td', { class: 'mono', text: hexText }),
    h('td', { class: decoded.startsWith('НЕ ') ? 'error' : '', text: decoded }),
  ]))));
}

function exceptionName(code) {
  return {
    1: 'недопустимая функция',
    2: 'недопустимый адрес данных',
    3: 'недопустимое значение данных',
    4: 'отказ прибора',
    6: 'прибор занят',
  }[code] || 'код ' + code;
}

/** Контрольная сумма Modbus RTU — та же, что считает служба. */
function crc16(bytes) {
  let crc = 0xffff;
  for (const b of bytes) {
    crc ^= b;
    for (let i = 0; i < 8; i++) {
      crc = (crc & 1) ? (crc >> 1) ^ 0xa001 : crc >> 1;
    }
  }
  return crc & 0xffff;
}

const pad2 = (n) => String(n).padStart(2, '0');
const pad4 = (n) => n.toString(16).toUpperCase().padStart(4, '0');
const timeOnly = (us) => new Date(us / 1000).toLocaleTimeString('ru-RU', { hour12: false })
  + '.' + String(Math.floor((us / 1000) % 1000)).padStart(3, '0');

// ── Тренды (ТЗ 13.10) ───────────────────────────────────────────────
//
// Экран отвечает на четыре разных вопроса, и каждый требует своего:
// «что сейчас» — живой правый край; «что было ночью» — узкое окно в прошлом с
// отметками событий; «норма ли это» — сравнение с прошлым периодом; «дай числа
// в отчёт» — таблица статистики и выгрузка. Поэтому здесь не одна линия, а
// набор рядов, оси по единицам, курсоры, статистика и сохранённые виды.

/** Преднастроенные периоды в секундах. */
const PERIODS = [
  ['300', '5 мин'], ['900', '15 мин'], ['3600', 'час'], ['21600', '6 часов'],
  ['86400', 'сутки'], ['259200', '3 суток'], ['604800', 'неделя'],
  ['1209600', '2 недели'], ['2592000', '30 суток'],
];

/** Разрешения архива. */
const RESOLUTIONS = [
  ['auto', 'автоматически'], ['raw', 'сырое'], ['minute', 'минута'],
  ['hour', 'час'], ['day', 'сутки'],
];

/** Быстрые периоды: смену и сутки задают чаще любого другого окна. */
const QUICK = [
  ['today', 'сегодня', 'от полуночи до текущего момента'],
  ['yesterday', 'вчера', 'прошедшие сутки целиком'],
  ['shift', 'текущая смена', 'от начала смены (08:00 либо 20:00) до сейчас'],
  ['prev-shift', 'прошлая смена', 'предыдущие двенадцать часов смены'],
];

/** Сдвиг для сравнения с прошлым периодом. */
const COMPARE = [
  ['', 'не сравнивать'], ['86400', 'с прошлыми сутками'],
  ['604800', 'с прошлой неделей'], ['2592000', 'с прошлым месяцем'],
];

const HOUR_US = 3600 * 1e6;

async function trends(ctx) {
  const { host, live, toast, reportError } = ctx;
  host.append(h('div', { class: 'trend-page-head' }, [
    h('div', {}, [
      h('div', { class: 'trend-eyebrow', text: 'АНАЛИЗ ИСТОРИИ' }),
      h('h2', { text: 'Тренды' }),
      h('p', { class: 'muted', text: 'Сопоставляйте сигналы, находите отклонения и сравнивайте периоды.' }),
    ]),
  ]));

  let available = [];
  try {
    available = await api.historyTags();
  } catch {
    host.append(h('p', { class: 'empty', text:
      'Архив не подключён: служба запущена без каталога данных. Запустите её с '
      + '--data-dir, и запись истории начнётся с первого опроса.' }));
    return;
  }
  if (!available.length) {
    host.append(h('p', { class: 'empty', text:
      'В архиве нет ни одного ряда. Запись ведётся с момента первого опроса: '
      + 'точки появятся через один период группы опроса.' }));
    return;
  }

  // Имя ряда — адрес, название — то, что читает человек. Выбирать ряд по
  // одному лишь машинному имени невозможно: у импортированных профилей оно
  // ничего не говорит (FR-709.22).
  const meta = new Map((live ? live.all() : []).map((t) => [t.name, t]));
  const titleOf = (name) => (meta.get(name) || {}).title || '';
  const unitsOf = (name) => (meta.get(name) || {}).units || '';
  const label = (name) => (titleOf(name) ? `${name} — ${titleOf(name)}` : name);
  const deviceOf = (name) => name.split('.').slice(0, 2).join('.');

  // ── Состояние экрана. Отражается в адресе (FR-709.19) ──────────────
  const state = readState(available);
  if (!state.panels.length) state.panels = [{ id: 'panel-1', title: 'График 1', tags: [], hidden: [], colors: {} }];
  state.activePanelId = state.panels.some((panel) => panel.id === state.activePanelId)
    ? state.activePanelId : state.panels[0].id;
  const activePanel = () => state.panels.find((panel) => panel.id === state.activePanelId) || state.panels[0];
  const syncDashboardTags = () => {
    state.tags = new Set(state.panels.flatMap((panel) => panel.tags));
    state.hidden = new Set([
      ...[...state.hidden].filter((tag) => state.tags.has(tag)),
      ...state.panels.flatMap((panel) => panel.hidden || []),
    ].filter((tag) => state.tags.has(tag)));
  };
  syncDashboardTags();
  let response = null;        // последний ответ /history
  let compareResponse = null; // ответ по периоду сравнения
  let panelResponses = new Map();
  let eventMarks = [];
  let cursors = [];           // до двух закреплённых курсоров
  let hover = null;
  // Ширина пикселя графика во времени: допуск попадания курсора в точку.
  // Берётся у графика — считать её здесь второй раз значило бы однажды
  // разойтись с ним и получить две разные правды на одном экране.
  let pixelUs = 0;
  let live_ = state.live;
  let inflight = 0;           // номер последнего запроса: старые не рисуются
  let renderedCharts = [];
  let allDecorated = [];
  let allPast = [];

  // ── Разметка ───────────────────────────────────────────────────────
  const picker = h('div', { class: 'trend-picker-list', role: 'group', 'aria-label': 'Ряды архива' });
  const filter = h('input', {
    type: 'search', style: 'width:240px',
    placeholder: 'фильтр: имя, название, прибор, единица',
  });
  const counter = h('span', { class: 'muted' });
  const periodPick = selectInput(PERIODS, String(state.period), (v) => {
    state.period = Number(v);
    state.from = null;
    state.to = null;
    for (const panel of state.panels) { panel.period = state.period; panel.from = null; panel.to = null; }
    saveState();
    load();
  });
  const resolutionPick = selectInput(RESOLUTIONS, state.resolution, (v) => {
    state.resolution = v;
    saveState();
    load();
  });
  const comparePick = selectInput(COMPARE, String(state.compare || ''), (v) => {
    state.compare = v ? Number(v) : 0;
    saveState();
    load();
  });
  const liveButton = h('button', { text: '' });
  // Логарифмическая шкала: расход от 0,1 до 100 на обычной шкале выглядит
  // прямой у нуля, и вся нижняя треть диапазона неразличима.
  const logButton = h('button', {
    text: 'лог. шкала',
    title: 'логарифмическая шкала — когда величина меняется на порядки',
    onclick: () => {
      state.log = !state.log;
      saveState();
      drawScaleButtons();
      draw();
    },
  });
  const fillButton = h('button', {
    text: 'заливка',
    title: 'заливка под линией; по умолчанию — по числу рядов',
    onclick: () => {
      // Три состояния по кругу: сам, всегда, никогда. Двух мало — «сам»
      // нужен, потому что на одном ряду и на восьми правильный ответ разный.
      state.fill = state.fill === null || state.fill === undefined
        ? true
        : (state.fill ? false : null);
      saveState();
      drawScaleButtons();
      draw();
    },
  });

  const splitButton = h('button', {
    text: 'по полям',
    title: 'каждой единице измерения — своё поле с общей осью времени и общим курсором',
    onclick: () => {
      state.split = !state.split;
      saveState();
      drawScaleButtons();
      draw();
    },
  });
  const STYLES = [
    ['line', 'линией'],
    ['step', 'ступенями'],
    ['bars', 'столбцами'],
    ['points', 'точками'],
  ];
  const stylePick = selectInput(STYLES, state.style, (v) => {
    state.style = v;
    saveState();
    draw();
  });

  function drawScaleButtons() {
    splitButton.className = state.split ? 'primary' : '';
    logButton.className = state.log ? 'primary' : '';
    fillButton.className = state.fill ? 'primary' : '';
    fillButton.textContent = state.fill === null || state.fill === undefined
      ? 'заливка: сама'
      : (state.fill ? 'заливка: всегда' : 'заливка: нет');
  }
  const viewsBox = h('span', { class: 'toolbar', style: 'margin:0;gap:4px' });
  const saveViewButton = h('button', {
    class: 'primary', text: 'Сохранить дашборд',
    title: 'Сохранить панели, ряды, цвета и общий период',
  });
  let savedViews = [];
  const note = h('span', { class: 'muted' });
  const plot = h('div', { class: 'trend-panel-grid' });
  const panelTabs = h('div', { class: 'trend-panel-tabs', role: 'tablist', 'aria-label': 'Графики дашборда' });
  const addPanelButton = h('button', {
    class: 'primary', text: '+ Добавить график',
    title: 'Добавить независимую панель, не заменяя существующие графики',
    // Обработчик клика получает Event; не передаём его как исходную панель
    // (иначе structuredClone(Event) выбрасывает DataCloneError).
    onclick: () => addPanel(),
  });
  const legendBox = h('div', {});
  const statsBox = h('div', { class: 'trend-stats' });
  const readout = h('div', { class: 'trend-readout muted' });
  // Заголовок появляется только на бумаге: распечатанный график без объекта,
  // интервала и разрешения — картинка, к отчёту не пригодная (FR-709.68).
  const printHead = h('div', { class: 'print-only' });
  const seriesPanel = h('div', { class: 'trend-series' }, [
    h('div', { class: 'trend-picker-search' }, [filter, counter]),
    h('div', { class: 'trend-picker-actions' }, [
      h('button', { text: 'Выбрать показанные', onclick: () => {
        const needle = filter.value.trim().toLowerCase();
        for (const t of available) {
          if (!needle || t.toLowerCase().includes(needle)
            || titleOf(t).toLowerCase().includes(needle)
            || unitsOf(t).toLowerCase().includes(needle)) {
            if (!activePanel().tags.includes(t)) activePanel().tags.push(t);
          }
        }
        syncDashboardTags();
        drawPanelTabs();
        fillPicker(); saveState(); load();
      } }),
      h('button', { text: 'Снять выбор', onclick: () => {
        activePanel().tags = []; syncDashboardTags(); drawPanelTabs(); fillPicker(); saveState(); load();
      } }),
    ]),
    picker,
  ]);

  liveButton.addEventListener('click', () => {
    live_ = !live_;
    if (live_) {
      state.from = null; state.to = null;
      for (const panel of state.panels) { panel.from = null; panel.to = null; }
    }
    saveState();
    load();
  });

  host.append(
    h('div', { class: 'toolbar' }, [viewsBox, saveViewButton]),
    h('div', { class: 'trend-dashboard-toolbar' }, [panelTabs, addPanelButton]),
    h('div', { class: 'toolbar' }, [
      h('span', { class: 'muted', text: 'быстро:' }),
      ...QUICK.map(([id, name, hint]) => h('button', {
        text: name, title: hint, onclick: () => applyQuick(id),
      })),
    ]),
    h('div', { class: 'toolbar' }, [
      field('окно по умолчанию', periodPick, 'Общее быстрое окно; в каждой панели ниже можно задать свой период.'),
      field('разрешение', resolutionPick,
        'сырые значения либо агрегаты. «Автоматически» — по ширине графика'),
      field('сравнить', comparePick,
        'наложить те же ряды за прошлый период: разница важнее абсолютных значений'),
      liveButton,
      splitButton,
      field('рисовать', stylePick,
        'ступени честнее для интервальной записи: между выборками значение не менялось плавно'),
      logButton,
      fillButton,
      h('button', { text: '← назад', title: 'сдвинуть окно на период назад',
        onclick: () => shift(-1) }),
      h('button', { text: 'вперёд →', title: 'сдвинуть окно на период вперёд',
        onclick: () => shift(1) }),
      h('button', { text: 'весь период', title: 'сбросить приближение во всех графиках',
        onclick: () => { state.from = null; state.to = null; clearPanelWindows(); saveState(); load(); } }),
      h('span', { class: 'spacer' }),
      h('button', { text: 'выгрузить CSV', onclick: exportCsv }),
      h('button', { text: 'печать', onclick: () => window.print() }),
    ]),
    h('div', { class: 'toolbar' }, [note]),
    printHead,
    legendBox,
    h('div', { class: 'trend-layout' }, [seriesPanel, h('div', { class: 'trend-analysis' }, [plot, readout])]),
    statsBox,
  );

  filter.addEventListener('input', () => fillPicker());
  saveViewButton.addEventListener('click', saveView);
  drawPanelTabs();

  /**
   * Управление с клавиатуры (FR-709.69).
   *
   * Обработчик на документе, а не на графике: у SVG нет фокуса по умолчанию,
   * и требовать щелчка по нему перед каждой стрелкой значит сделать
   * клавиатуру бесполезной. Ввод в поля не перехватывается — иначе в фильтре
   * нельзя было бы набрать «влево».
   */
  const onKey = (e) => {
    const inField = e.target instanceof HTMLElement
      && ['INPUT', 'SELECT', 'TEXTAREA'].includes(e.target.tagName);
    if (inField || e.ctrlKey || e.altKey || e.metaKey) return;
    switch (e.key) {
      case 'ArrowLeft': shift(-1); break;
      case 'ArrowRight': shift(1); break;
      case '+': case '=': zoomBy(0.5); break;
      case '-': zoomBy(2); break;
      case '0': state.from = null; state.to = null; clearPanelWindows(); saveState(); load(); break;
      case 'l': case 'L': case 'д': case 'Д':
        live_ = !live_;
        if (live_) { state.from = null; state.to = null; clearPanelWindows(); }
        saveState();
        drawLiveButton();
        load();
        break;
      case 'Escape': cursors = []; saveState(); draw(); break;
      default: return;
    }
    e.preventDefault();
  };
  document.addEventListener('keydown', onKey);

  fillPicker();
  drawLiveButton();
  drawScaleButtons();
  await refreshViews();
  await load();

  const timer = setInterval(() => { if (live_) load({ quiet: true }); }, 5000);
  return {
    dispose: () => {
      clearInterval(timer);
      // Обработчик висит на документе: оставленный при уходе с экрана, он
      // продолжал бы перехватывать стрелки на всех остальных.
      document.removeEventListener('keydown', onKey);
    },
  };

  // ── Сохранённые виды (FR-709.63) ───────────────────────────────────

  function addPanel(source = null) {
    const number = state.panels.length + 1;
    const panel = source
      ? { ...structuredClone(source), id: `panel-${crypto.randomUUID()}`, title: `${source.title || 'График'} — копия`, colors: { ...(source.colors || {}) } }
      : { id: `panel-${crypto.randomUUID()}`, title: `График ${number}`, period: state.period, tags: [], hidden: [], colors: {} };
    state.panels.push(panel);
    state.activePanelId = panel.id;
    drawPanelTabs();
    fillPicker();
    saveState();
    draw();
  }

  function removePanel(panel) {
    if (state.panels.length < 2) {
      toast('В дашборде оставьте хотя бы один график; можно очистить его ряды', 'warn');
      return;
    }
    state.panels = state.panels.filter((item) => item.id !== panel.id);
    state.activePanelId = state.panels[0].id;
    syncDashboardTags();
    drawPanelTabs();
    fillPicker();
    saveState();
    load();
  }

  function movePanel(panel, step) {
    const index = state.panels.findIndex((item) => item.id === panel.id);
    const destination = index + step;
    if (index < 0 || destination < 0 || destination >= state.panels.length) return;
    [state.panels[index], state.panels[destination]] = [state.panels[destination], state.panels[index]];
    saveState();
    draw();
  }

  function drawPanelTabs() {
    panelTabs.replaceChildren(...state.panels.map((panel, index) => h('button', {
      class: 'trend-panel-tab' + (panel.id === state.activePanelId ? ' active' : ''),
      role: 'tab', 'aria-selected': panel.id === state.activePanelId ? 'true' : 'false',
      text: `${panel.title || `График ${index + 1}`} · ${panel.tags.length}`,
      title: `Выбрать график для добавления рядов · ${panel.tags.length} рядов`,
      onclick: () => {
        state.activePanelId = panel.id;
        drawPanelTabs(); fillPicker(); saveState();
      },
    })));
  }

  async function refreshViews() {
    try {
      savedViews = (await api.trendViews()).items || [];
    } catch {
      // Служба без каталога данных виды не хранит — это не поломка экрана.
      savedViews = [];
    }
    drawViews();
  }

  function drawViews() {
    if (!savedViews.length) {
      viewsBox.replaceChildren(h('span', { class: 'muted', text: 'нет сохранённых дашбордов' }));
      return;
    }
    viewsBox.replaceChildren(
      h('span', { class: 'muted', text: 'дашборды:' }),
      ...savedViews.map((view) => h('span', { class: 'trend-legend-pair' }, [
        h('button', {
          class: 'trend-legend-item',
          text: view.name || view.id,
          title: (view.owner ? 'личный' : 'общий')
            + `: графиков ${(view.panels || []).length || 1}, рядов ${view.tags.length}`,
          onclick: () => applyView(view),
        }),
        h('button', {
          class: 'trend-legend-drop', text: '×', title: 'удалить дашборд',
          onclick: async () => {
            try {
              await api.deleteTrendView(view.id);
              toast(`дашборд «${view.name || view.id}» удалён`, 'ok');
              await refreshViews();
            } catch (e) { reportError(e); }
          },
        }),
      ])),
    );
  }

  function applyView(view) {
    // Ряд, которого больше нет в конфигурации, не роняет открытие вида
    // целиком: он просто не запрашивается, а о пропаже сообщается (FR-709.65).
    const savedPanels = Array.isArray(view.panels) && view.panels.length
      ? view.panels.map((panel, index) => ({
        id: String(panel.id || `panel-${index + 1}`),
        title: String(panel.title || `График ${index + 1}`),
        style: ['line', 'step', 'bars', 'points'].includes(panel.style) ? panel.style : '',
        period: Number.isFinite(Number(panel.period)) && Number(panel.period) > 0 ? Number(panel.period) : (view.period || state.period),
        from: panel.from != null && Number.isFinite(Number(panel.from)) ? Number(panel.from) : null,
        to: panel.to != null && Number.isFinite(Number(panel.to)) ? Number(panel.to) : null,
        tags: [...new Set((panel.tags || []).filter((tag) => available.includes(tag)))],
        hidden: [...new Set((panel.hidden || []).filter((tag) => available.includes(tag)))],
        colors: Object.fromEntries(Object.entries(panel.colors || {}).filter(([, color]) => /^#[0-9a-f]{6}$/i.test(color))),
      }))
      : [{ id: 'panel-1', title: 'График 1', style: '', period: view.period || state.period, from: null, to: null, tags: view.tags.filter((tag) => available.includes(tag)), hidden: view.hidden || [], colors: {} }];
    const alive = [...new Set(savedPanels.flatMap((panel) => panel.tags))];
    const gone = view.tags.filter((t) => !available.includes(t));
    state.panels = savedPanels;
    state.activePanelId = savedPanels[0]?.id || 'panel-1';
    state.tags = new Set(alive);
    state.hidden = new Set([...savedPanels.flatMap((panel) => panel.hidden || []), ...(view.hidden || [])].filter((t) => alive.includes(t)));
    state.period = view.period || state.period;
    state.resolution = view.resolution || state.resolution;
    state.compare = view.compare || 0;
    state.from = null;
    state.to = null;
    live_ = true;
    periodPick.value = String(state.period);
    resolutionPick.value = state.resolution;
    comparePick.value = String(state.compare || '');
    drawPanelTabs(); fillPicker();
    drawLiveButton();
    saveState();
    if (gone.length) {
      toast(`в виде «${view.name || view.id}» больше нет рядов: ${gone.join(', ')}`, 'warn');
    }
    load();
  }

  async function saveView() {
    if (!state.tags.size) { toast('добавьте хотя бы один ряд хотя бы в один график', 'warn'); return; }
    const name = h('input', { style: 'width:260px', placeholder: 'например, «Котельная: подача»' });
    const shared = h('input', { type: 'checkbox' });
    shared.checked = hasRole('engineer');
    shared.disabled = !hasRole('engineer');

    const saved = await modal({
      title: 'Сохранить дашборд трендов',
      body: h('div', {}, [
        h('p', { class: 'muted', text:
          `Сохранятся ${state.panels.length} графиков и ${state.tags.size} рядов, цвета, скрытые ряды и период. `
          + 'Настройки останутся после перезапуска и изменения порядка панелей.' }),
        h('label', {}, ['название', name]),
        h('label', {}, [
          'общий для всех',
          shared,
          h('span', { class: 'muted', style: 'font-size:11px', text:
            hasRole('engineer')
              ? ' — виден всем на объекте; личный виден только вам'
              : ' — общий вид сохраняет роль «инженер» и выше' }),
        ]),
      ]),
      confirmText: 'Сохранить',
      onConfirm: async () => {
        const title = name.value.trim();
        if (!title) throw new Error('вид без названия не найти в перечне');
        const existingView = savedViews.find((view) => view.id === title);
        return api.saveTrendView({
          id: title,
          name: title,
          // Сервер откажет с 409, если общий дашборд успели изменить после
          // загрузки списка; локальные правки при этом остаются в экране.
          expected_revision: existingView ? existingView.revision : null,
          shared: shared.checked,
          tags: [...state.tags],
          hidden: [...state.hidden],
          period: state.period,
          resolution: state.resolution,
          compare: state.compare || 0,
          panels: state.panels.map((panel) => ({
            id: panel.id, title: panel.title, style: panel.style || state.style, tags: panel.tags,
            period: panel.period || null, from: panel.from || null, to: panel.to || null,
            hidden: [...new Set([...(panel.hidden || []), ...[...state.hidden].filter((tag) => panel.tags.includes(tag))])],
            colors: panel.colors || {},
          })),
        });
      },
    });
    if (!saved) return;
    toast(`дашборд «${saved.name || saved.id}» сохранён`, 'ok');
    await refreshViews();
  }

  // ── Быстрые периоды (FR-709.29) ────────────────────────────────────

  function applyQuick(id) {
    const now = new Date();
    const startOfDay = (d) => {
      const x = new Date(d);
      x.setHours(0, 0, 0, 0);
      return x.getTime() * 1000;
    };
    const day = 86400 * 1e6;
    let from;
    let to;
    switch (id) {
      case 'today':
        from = startOfDay(now);
        to = Date.now() * 1000;
        break;
      case 'yesterday':
        from = startOfDay(now) - day;
        to = startOfDay(now);
        break;
      case 'shift':
        from = shiftStart(now);
        to = Date.now() * 1000;
        break;
      case 'prev-shift':
        from = shiftStart(now) - 12 * 3600 * 1e6;
        to = shiftStart(now);
        break;
      default:
        return;
    }
    live_ = id === 'today' || id === 'shift';
    state.from = Math.round(from);
    state.to = Math.round(to);
    clearPanelWindows();
    saveState();
    drawLiveButton();
    load();
  }

  /**
   * Начало текущей смены.
   *
   * Смены двенадцатичасовые от восьми утра — обычная разбивка на объектах.
   * Границы одним местом: их правят под объект, и разнесённые по коду они
   * разошлись бы между «текущей» и «прошлой» сменой.
   */
  function shiftStart(now) {
    const x = new Date(now);
    const hour = x.getHours();
    x.setMinutes(0, 0, 0);
    x.setHours(hour >= 20 ? 20 : hour >= 8 ? 8 : 20);
    let ms = x.getTime();
    if (hour < 8) ms -= 86400 * 1000;
    return ms * 1000;
  }

  // ── Перечень рядов ─────────────────────────────────────────────────

  function fillPicker() {
    const needle = filter.value.trim().toLowerCase();
    const shown = available.filter((t) => !needle
      || t.toLowerCase().includes(needle)
      || titleOf(t).toLowerCase().includes(needle)
      || unitsOf(t).toLowerCase().includes(needle));
    picker.replaceChildren(...shown.map((t, i) => {
      const units = unitsOf(t);
      const check = h('input', { type: 'checkbox', checked: activePanel().tags.includes(t) ? '' : null });
      check.addEventListener('change', () => {
        if (check.checked && !activePanel().tags.includes(t)) activePanel().tags.push(t);
        else if (!check.checked) activePanel().tags = activePanel().tags.filter((tag) => tag !== t);
        syncDashboardTags();
        drawPanelTabs();
        saveState(); load();
        // Перерисовываем только счётчик: сохраняем фокус при быстром выборе.
        updateCounter();
      });
      return h('label', { class: 'trend-picker-row' + (i % 2 ? ' alternate' : ''), title: t }, [
        check,
        h('span', { class: 'trend-picker-copy' }, [
          h('strong', { text: titleOf(t) || t }),
          h('small', { text: `${titleOf(t) ? t + ' · ' : ''}${deviceOf(t)}${units ? ' · ' + units : ''}` }),
        ]),
      ]);
    }));
    updateCounter(shown);
  }

  function updateCounter(shown = null) {
    if (!shown) {
      const needle = filter.value.trim().toLowerCase();
      shown = available.filter((t) => !needle
        || t.toLowerCase().includes(needle)
        || titleOf(t).toLowerCase().includes(needle)
        || unitsOf(t).toLowerCase().includes(needle));
    }
    const selected = activePanel().tags;
    const hidden = selected.filter((t) => !shown.includes(t)).length;
    counter.textContent = (shown.length === available.length
      ? `рядов ${available.length}`
      : `показано ${shown.length} из ${available.length}`)
      + `, в графике «${activePanel().title}»: ${selected.length}`
      + (hidden ? ` (скрыто фильтром ${hidden})` : '');
  }

  // ── Окно времени ───────────────────────────────────────────────────

  function range() {
    if (state.from && state.to) return { from: state.from, to: state.to };
    const to = Date.now() * 1000;
    return { from: to - state.period * 1e6, to };
  }

  function panelRange(panel) {
    if (panel.from && panel.to) return { from: panel.from, to: panel.to };
    if (!panel.period) return range();
    const to = Date.now() * 1000;
    return { from: to - panel.period * 1e6, to };
  }

  function clearPanelWindows() {
    for (const panel of state.panels) { panel.period = null; panel.from = null; panel.to = null; }
  }

  function shift(direction) {
    const { from, to } = range();
    const span = to - from;
    live_ = false;
    state.from = from + direction * span;
    state.to = to + direction * span;
    clearPanelWindows();
    saveState();
    drawLiveButton();
    load();
  }

  /**
   * Приближение и отдаление вокруг середины окна.
   *
   * Именно середины, а не левого края: при отдалении от края правая половина
   * уезжает из виду, и разбираемый участок теряется.
   */
  function zoomBy(factor) {
    const { from, to } = range();
    const middle = (from + to) / 2;
    const half = ((to - from) * factor) / 2;
    zoomTo(middle - half, middle + half);
  }

  function zoomTo(from, to) {
    // Ручное масштабирование выключает живой режим: график, уезжающий
    // из-под курсора во время разбора, — это график, которым нельзя
    // пользоваться (FR-709.57).
    live_ = false;
    state.from = Math.round(from);
    state.to = Math.round(to);
    clearPanelWindows();
    cursors = [];
    saveState();
    drawLiveButton();
    load();
  }

  function zoomPanel(panel, from, to) {
    live_ = false;
    panel.period = null;
    panel.from = Math.round(from);
    panel.to = Math.round(to);
    cursors = [];
    saveState();
    drawLiveButton();
    load();
  }

  function drawLiveButton() {
    liveButton.textContent = live_ ? '⏸ остановить слежение' : '▶ следить за краем';
    liveButton.className = live_ ? 'primary' : '';
    liveButton.title = live_
      ? 'правый край следует за текущим временем'
      : 'включить слежение за правым краем';
  }

  // ── Запрос и отрисовка ─────────────────────────────────────────────

  async function load({ quiet = false } = {}) {
    const chosen = [...state.tags];
    if (!chosen.length) {
      note.textContent = 'выберите хотя бы один ряд';
      plot.replaceChildren(h('p', { class: 'empty', text: 'ряды не выбраны' }));
      legendBox.replaceChildren();
      statsBox.replaceChildren();
      return;
    }
    const union = state.panels.filter((panel) => panel.tags.length).map(panelRange);
    const fallback = range();
    const from = union.length ? Math.min(...union.map((item) => item.from)) : fallback.from;
    const to = union.length ? Math.max(...union.map((item) => item.to)) : fallback.to;
    const ticket = ++inflight;
    if (!quiet) note.textContent = 'запрос…';

    try {
      const width = Math.max(320, plot.clientWidth || 900);
      const columns = Math.min(2, Math.max(1, state.panels.length));
      const maxPoints = Math.min(5000, Math.max(320, Math.floor(width / columns) * 2));
      // Загружаем каждое уникальное окно отдельно: месячный обзор не должен
      // прореживать до нечитаемости короткий график рядом с ним.
      const groups = new Map();
      for (const panel of state.panels) {
        if (!panel.tags.length) continue;
        const window = panelRange(panel);
        const key = `${window.from}:${window.to}`;
        if (!groups.has(key)) groups.set(key, { ...window, tags: new Set(), panels: [] });
        const group = groups.get(key);
        panel.tags.forEach((tag) => group.tags.add(tag));
        group.panels.push(panel);
      }
      const [loadedGroups, events] = await Promise.all([
        Promise.all([...groups.values()].map(async (group) => {
          const tags = [...group.tags];
          const [main, past] = await Promise.all([
            api.history(tags, group.from, group.to, state.resolution, maxPoints),
            state.compare
              ? api.history(tags, group.from - state.compare * 1e6, group.to - state.compare * 1e6,
                state.resolution, maxPoints).catch(() => null)
              : Promise.resolve(null),
          ]);
          return { ...group, main, past };
        })),
        api.events(200).catch(() => []),
      ]);
      // Ответ на устаревший запрос не рисуется: быстрая перенастройка окна
      // иначе даёт мигание чужими данными (FR-709.79).
      if (ticket !== inflight) return;
      panelResponses = new Map();
      const mergedMain = new Map();
      const mergedPast = new Map();
      for (const group of loadedGroups) {
        for (const panel of group.panels) panelResponses.set(panel.id, group);
        for (const series of group.main.series || []) {
          if (!mergedMain.has(series.tag) || group.to - group.from > mergedMain.get(series.tag).span) {
            mergedMain.set(series.tag, { span: group.to - group.from, series });
          }
        }
        for (const series of group.past?.series || []) {
          if (!mergedPast.has(series.tag) || group.to - group.from > mergedPast.get(series.tag).span) {
            mergedPast.set(series.tag, { span: group.to - group.from, series });
          }
        }
      }
      response = { ...(loadedGroups[0]?.main || {}), series: [...mergedMain.values()].map((item) => item.series) };
      compareResponse = state.compare
        ? { ...(loadedGroups.find((group) => group.past)?.past || {}), series: [...mergedPast.values()].map((item) => item.series) }
        : null;
      eventMarks = marksFor(events, chosen, from, to);
      draw();
    } catch (e) {
      if (ticket !== inflight) return;
      // Предыдущий график остаётся на месте: подменять показанные данные
      // пустотой из-за одного неудачного запроса нельзя (FR-709.75).
      note.textContent = 'запрос не удался: ' + (e && e.message ? e.message : e);
      if (!quiet) reportError(e);
    }
  }

  function decorate(series, index, isCompare) {
    const t = meta.get(series.tag) || {};
    const configuredColor = activePanel().colors?.[series.tag];
    return {
      ...series,
      index,
      color: configuredColor || stableSeriesColor(series.tag),
      log: state.log,
      title: t.title || '',
      units: t.units || '',
      limits: t.limits || null,
      discrete: isDiscrete(series, t),
      hidden: state.hidden.has(series.tag),
      compare: isCompare,
    };
  }

  function draw() {
    if (!response) return;
    const { from, to } = range();
    const decorated = response.series.map((s, i) => decorate(s, i, false));
    const past = compareResponse
      ? compareResponse.series.map((s, i) => ({
        // Ряд сравнения совмещается по относительному времени: абсолютное
        // время каждого набора видно в курсоре и легенде (FR-709.62).
        ...decorate(s, i, true),
        points: s.points.map((p) => ({
          ...p,
          start_us: p.start_us + state.compare * 1e6,
          end_us: p.end_us + state.compare * 1e6,
        })),
      }))
      : [];
    allDecorated = decorated;
    allPast = past;
    renderedCharts = [];
    plot.classList.toggle('single', state.panels.length === 1);
    plot.replaceChildren(...state.panels.map((panel, index) => {
      const source = panelResponses.get(panel.id);
      const panelRows = (source?.main.series || []).map((series, rowIndex) => decorate(series, rowIndex, false));
      const panelPastRows = source?.past
        ? source.past.series.map((series, rowIndex) => ({
          ...decorate(series, rowIndex, true),
          points: series.points.map((point) => ({ ...point, start_us: point.start_us + state.compare * 1e6, end_us: point.end_us + state.compare * 1e6 })),
        })) : [];
      const panelWindow = panelRange(panel);
      const rows = panelRows.filter((series) => panel.tags.includes(series.tag))
        .map((series) => ({ ...series, color: panel.colors?.[series.tag] || stableSeriesColor(series.tag) }));
      const panelPast = panelPastRows.filter((series) => panel.tags.includes(series.tag));
      const title = textInput(panel.title || `График ${index + 1}`, (value) => {
        panel.title = value.trim() || `График ${index + 1}`;
        drawPanelTabs(); saveState();
      }, 'min-width:140px;max-width:360px;font-weight:650');
      const panelPeriodOptions = panel.from && panel.to
        ? [['custom', 'Произвольный диапазон'], ...PERIODS]
        : PERIODS;
      const periodControl = selectInput(panelPeriodOptions,
        panel.from && panel.to ? 'custom' : String(panel.period || state.period), (value) => {
        if (value === 'custom') return;
        panel.period = Number(value); panel.from = null; panel.to = null;
        state.from = null; state.to = null; live_ = true;
        saveState(); drawLiveButton(); load();
      });
      const card = h('section', { class: 'trend-panel-card' + (panel.id === state.activePanelId ? ' selected' : '') }, [
        h('header', { class: 'trend-panel-head' }, [
          h('div', { class: 'trend-panel-heading' }, [title, h('span', { class: 'muted', text: `${panel.tags.length} рядов` })]),
          selectInput(STYLES, panel.style || state.style, (value) => {
            panel.style = value; saveState(); draw();
          }),
          h('div', { class: 'trend-panel-actions' }, [
            h('button', { text: '↑', title: 'Переместить график раньше', disabled: index === 0 ? '' : null, onclick: () => movePanel(panel, -1) }),
            h('button', { text: '↓', title: 'Переместить график позже', disabled: index === state.panels.length - 1 ? '' : null, onclick: () => movePanel(panel, 1) }),
            h('button', { text: 'В ряды', title: 'Добавить или убрать теги этого графика', onclick: () => {
              state.activePanelId = panel.id; drawPanelTabs(); fillPicker(); saveState();
              filter.focus();
            } }),
            h('button', { text: 'Дублировать', title: 'Сделать копию графика с рядами и цветами', onclick: () => addPanel(panel) }),
            h('button', { class: 'danger', text: 'Удалить', title: 'Удалить только этот график', onclick: () => removePanel(panel) }),
          ]),
        ]),
        h('div', { class: 'trend-panel-timebar' }, [
          h('span', { class: 'trend-panel-time-icon', text: '◷', 'aria-hidden': 'true' }),
          h('label', { class: 'trend-panel-period' }, [h('span', { class: 'muted', text: 'Период графика' }), periodControl]),
          h('span', { class: 'trend-panel-time-range mono', title: 'Точные границы отображаемого окна', text: `${new Date(panelWindow.from / 1000).toLocaleString('ru-RU')} — ${new Date(panelWindow.to / 1000).toLocaleString('ru-RU')}` }),
        ]),
        h('div', { class: 'trend-panel-summary muted', text: panel.tags.length
          ? panel.tags.map((tag) => titleOf(tag) || tag).join(' · ')
          : 'Ряды не выбраны — нажмите «В ряды», затем отметьте сигналы слева.' }),
      ]);
      const chartArea = h('div', { class: 'trend-panel-chart' });
      const charts = buildCharts(rows, panelPast, panelWindow.from, panelWindow.to, panel.style || state.style,
        (zoomFrom, zoomToValue) => zoomPanel(panel, zoomFrom, zoomToValue));
      renderedCharts.push(...charts);
      if (!index) pixelUs = charts.length ? (charts[0].pixelUs || 0) : 0;
      chartArea.replaceChildren(...charts.map((chart) => chart.node));
      card.append(chartArea);
      return card;
    }));

    drawNote(decorated, from, to);
    drawPrintHead(from, to, decorated);
    hintWhereData(decorated, from, to);
    drawLegend(decorated);
    drawStats(decorated, past, from, to);
    drawReadout(decorated, past);
  }

  /**
   * Разбивка рядов по полям.
   *
   * Единица измерения — единственный признак, по которому величины сравнимы.
   * Логические величины идут в то же поле, что и их соседи: у них своя
   * дорожка внизу поля, отдельного места им не нужно.
   */
  function groupsOf(decorated) {
    if (!state.split) return [{ title: '', series: decorated }];
    const by = new Map();
    for (const s of decorated) {
      const key = s.discrete ? 'логические' : (s.units || 'без единицы');
      if (!by.has(key)) by.set(key, []);
      by.get(key).push(s);
    }
    return [...by.entries()].map(([title, series]) => ({ title, series }));
  }

  /**
   * Поля графика. Ось времени подписана **один раз внизу**: она общая, и
   * повторять её у каждого поля значит трижды отдать место под одно и то же.
   */
  function buildCharts(decorated, past, from, to, panelStyle = state.style, onPanelZoom = zoomTo) {
    const groups = groupsOf(decorated);
    // Высота делится между полями, но не ниже той, на которой график
    // перестаёт быть графиком.
    const height = groups.length > 1
      ? Math.max(130, Math.round(340 / groups.length) + 40)
      : 340;
    const charts = [];
    groups.forEach((group, index) => {
      const last = index === groups.length - 1;
      const names = new Set(group.series.map((s) => s.tag));
      const chart = renderChart(
        [...group.series, ...past.filter((p) => names.has(p.tag))],
        from, to,
        {
          height,
          cursors,
          // Отметки событий — только в нижнем поле: повторённые в каждом, они
          // превращают экран в частокол.
          events: last ? eventMarks : [],
          fill: state.fill,
          style: panelStyle,
          timeAxis: last,
          onCursor: (us, e) => {
            hover = us;
            // Курсор идёт по всем полям сразу: разбор аварии — это сличение
            // величин в один и тот же момент.
            for (const other of renderedCharts) {
              if (other !== chart) other.showCursor(us);
            }
            drawReadout(allDecorated, allPast);
            if (!e) return;
          },
          onZoom: onPanelZoom,
        },
      );
      if (group.title && groups.length > 1) {
        chart.node.prepend(h('div', { class: 'chart-title muted', text: group.title }));
      }
      chart.node.addEventListener('click', (e) => {
        if (hover === null || hover === undefined) return;
        // Первый щелчок ставит курсор, второй — второй курсор, третий сбрасывает.
        if (e.shiftKey || cursors.length === 1) cursors = [...cursors, hover].slice(-2);
        else if (cursors.length >= 2) cursors = [];
        else cursors = [hover];
        saveState();
        draw();
      });
      charts.push(chart);
    });
    return charts;
  }

  function drawNote(decorated, from, to) {
    const resolutions = [...new Set(decorated.map((s) => s.resolution))];
    const auto = decorated.some((s) => s.auto_selected);
    const coarse = decorated.some((s) => s.coarsened);
    const points = decorated.reduce((sum, s) => sum + (s.points ? s.points.length : 0), 0);
    const missing = (response.missing || []).length;
    // `replaceChildren` печатает `null` как слово «null»: пропущенный
    // условный элемент оказывался на экране строкой «огрублено пределомnull».
    // `h` такие отсеивает, а прямая вставка — нет.
    note.replaceChildren(...[
      h('span', { text:
        `${new Date(from / 1000).toLocaleString('ru-RU')} — `
        + `${new Date(to / 1000).toLocaleString('ru-RU')}` }),
      h('span', { class: 'muted', text:
        ` · разрешение ${resolutions.join(', ')}${auto ? ' (выбрано автоматически)' : ''}`
        + ` · точек ${points}${coarse ? ' · огрублено пределом' : ''}`
        + (missing ? ` · без истории: ${missing}` : '') }),
      live_ ? h('span', { class: 'state-online', text: ' · слежение' }) : null,
    ].filter(Boolean));
  }

  /**
   * Пустое окно объясняется, а не показывается пустым графиком (FR-709.74).
   *
   * «Точек 0» отвечает на вопрос «сколько», но не на «где искать». Оператор
   * при этом решает, что архива нет вовсе, и идёт проверять запись — тогда
   * как данные есть, просто за другие сутки.
   */
  async function hintWhereData(decorated, from, to) {
    const empty = decorated.every((s) => !s.points || !s.points.length);
    if (!empty || !decorated.length) return;
    const tag = decorated[0].tag;
    const now = Date.now() * 1000;
    try {
      // Суточная сводка за месяц: по ней видно, в какие сутки запись шла.
      const days = await api.historyDaily(tag, now - 31 * 86400 * 1e6, now);
      const withData = (days || []).filter((d) => d.samples > 0);
      if (!withData.length) {
        note.append(h('span', { class: 'warn-line', text:
          ' · за последний месяц записи по этому ряду нет вовсе' }));
        return;
      }
      const last = withData[withData.length - 1];
      const day = new Date(last.day_start_us / 1000).toLocaleDateString('ru-RU');
      const jump = h('button', {
        class: 'link', text: `перейти к ${day}`,
        onclick: () => {
          live_ = false;
          state.from = last.day_start_us;
          state.to = last.day_start_us + 86400 * 1e6;
          saveState();
          drawLiveButton();
          load();
        },
      });
      note.append(
        h('span', { class: 'warn-line', text:
          ` · за выбранный период точек нет; последние есть за ${day} `
          + `(суток с записью: ${withData.length}) ` }),
        jump,
      );
    } catch {
      // Сводка недоступна — молчим: подсказка не обязана работать всегда.
    }
  }

  function drawPrintHead(from, to, decorated) {
    printHead.replaceChildren(
      // Имя объекта берётся из оболочки: она уже получила его из `/health`,
      // и второй запрос ради заголовка печати — лишний.
      h('h3', { text: (document.querySelector('.instance')?.textContent || 'Объект')
        + ' — тренды' }),
      h('p', { class: 'muted', text:
        `${new Date(from / 1000).toLocaleString('ru-RU')} — `
        + `${new Date(to / 1000).toLocaleString('ru-RU')}`
        + ` · разрешение ${[...new Set(decorated.map((s) => s.resolution))].join(', ')}`
        + ` · напечатано ${new Date().toLocaleString('ru-RU')}` }),
    );
  }

  function drawLegend(decorated) {
    legendBox.replaceChildren(h('div', { class: 'trend-legend' },
      decorated.map((s) => {
        const color = s.color || stableSeriesColor(s.tag);
        const hiddenNow = state.hidden.has(s.tag);
        const lastPoint = [...(s.points || [])].reverse()
          .find((point) => point.samples > 0 && point.bad_fraction < 1);
        const lastValue = !lastPoint ? 'нет данных' : s.discrete
          ? (lastPoint.avg >= 0.5 ? 'ВКЛ' : 'ВЫКЛ')
          : Number(lastPoint.avg).toLocaleString('ru-RU', { maximumFractionDigits: 3 });
        const lastTime = lastPoint
          ? new Date(lastPoint.end_us / 1000).toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' })
          : '';
        const quality = !lastPoint ? 'нет выборки'
          : lastPoint.bad_fraction > 0 ? 'частично недостоверно' : 'достоверно';
        const row = h('button', {
          class: 'trend-legend-item' + (hiddenNow ? ' off' : ''),
          style: `--series-color:${color}`,
          title: (hiddenNow ? 'включить ряд' : 'скрыть ряд')
            + '; с Alt — оставить только его, повторно — вернуть все',
          onclick: (e) => {
            // С Alt — оставить один ряд. На наборе из восьми рядов разобрать
            // один иначе значит семь раз щёлкнуть по легенде, а потом ещё семь,
            // чтобы вернуть как было.
            if (e.altKey) {
              const alone = state.hidden.size === decorated.length - 1 && !hiddenNow;
              state.hidden = new Set(alone
                ? []
                : decorated.filter((o) => o.tag !== s.tag).map((o) => o.tag));
            } else if (hiddenNow) {
              state.hidden.delete(s.tag);
            } else {
              state.hidden.add(s.tag);
            }
            saveState();
            draw();
          },
        }, [
          h('span', { class: 'trend-card-head' }, [
            h('span', { class: 'trend-swatch', style: `--series-color:${color}` }),
            h('span', { class: 'trend-card-name', text: s.title || s.tag }),
            s.units ? h('span', { class: 'trend-card-units', text: s.units }) : null,
          ]),
          h('strong', { class: 'trend-card-value' + (!lastPoint ? ' no-data' : ''), text: lastValue }),
          h('span', { class: 'trend-card-foot' }, [
            h('span', { text: lastTime ? `последнее · ${lastTime}` : 'за период' }),
            h('span', { class: lastPoint?.bad_fraction > 0 ? 'quality-warn' : (lastPoint ? 'quality-ok' : ''), text: quality }),
          ]),
        ]);
        const drop = h('button', {
          class: 'trend-legend-drop', text: '×', title: 'убрать ряд из набора',
          onclick: () => {
            activePanel().tags = activePanel().tags.filter((tag) => tag !== s.tag);
            syncDashboardTags();
            fillPicker();
            saveState();
            load();
          },
        });
        const colorPicker = h('input', {
          type: 'color', value: color, class: 'trend-color-picker',
          title: activePanel().tags.includes(s.tag)
            ? `Изменить цвет «${s.title || s.tag}» в графике «${activePanel().title}»`
            : 'Чтобы изменить цвет ряда, сначала выберите график, где он используется',
          disabled: activePanel().tags.includes(s.tag) ? null : '',
        });
        colorPicker.addEventListener('change', () => {
          activePanel().colors ||= {};
          activePanel().colors[s.tag] = colorPicker.value;
          saveState();
          s.color = colorPicker.value;
          // Меняется цвет, не запрос архива; перерисовываем только полотно.
          draw();
        });
        return h('div', { class: 'trend-legend-pair' }, [row, colorPicker, drop]);
      })));
  }

  function drawStats(decorated, past, from, to) {
    const rows = decorated.filter((s) => !state.hidden.has(s.tag)).map((s) => {
      const st = statistics(s, from, to);
      const pastStat = past.find((p) => p.tag === s.tag);
      const before = pastStat ? statistics(pastStat, from, to) : null;
      const delta = (before && st.avg !== null && before.avg !== null)
        ? st.avg - before.avg : null;
      return [
        h('span', { title: s.tag, text: s.title || s.tag }),
        s.units || '—',
        num(st.min), num(st.max), num(st.avg), num(st.last),
        h('span', {
          class: st.good >= 0.99 ? '' : (st.good >= 0.5 ? 'state-degraded' : 'state-offline'),
          text: (st.good * 100).toFixed(st.good >= 0.99 ? 0 : 1) + ' %',
        }),
        state.compare ? num(delta) : '—',
      ];
    });
    statsBox.replaceChildren(
      h('h3', { text: 'Статистика за видимый интервал' }),
      table(['Ряд', 'Ед.', 'Минимум', 'Максимум', 'Среднее', 'Последнее',
        'Достоверно', 'Δ к прошлому'], rows),
      h('p', { class: 'muted', style: 'font-size:11px', text:
        'Считается по показанному интервалу и по тем точкам, что пришли: среднее '
        + 'по часовым средним и среднее по сырым значениям различаются. '
        + '«Достоверно» — доля времени с исправной связью.' }),
    );
  }

  function drawReadout(decorated, past) {
    const at = (cursors.length ? cursors[cursors.length - 1] : hover);
    if (at === null || at === undefined) {
      readout.textContent = cursors.length
        ? ''
        : 'наведите на график — покажет значения всех рядов; щелчок закрепляет курсор, второй щелчок даёт разность';
      if (!cursors.length) return;
    }
    const parts = [];
    if (cursors.length === 2) {
      const [a, b] = cursors;
      parts.push(h('span', { class: 'mono', text:
        `Δt ${durationText(Math.abs(b - a))}` }));
    }
    const moment = at !== null && at !== undefined ? at : cursors[0];
    if (moment === null || moment === undefined) return;
    parts.push(h('span', { class: 'mono', text: new Date(moment / 1000).toLocaleString('ru-RU') }));

    for (const s of decorated) {
      if (state.hidden.has(s.tag)) continue;
      // Тот же допуск, что у подсказки на графике: строка под графиком,
      // говорящая «нет данных» над сплошной линией, противоречит самому
      // графику.
      const point = valueAt(s, moment, pixelUs * 2);
      const chunk = [
        h('span', { class: 'trend-swatch', style: `--series-color:${s.color || stableSeriesColor(s.tag)}` }),
        h('span', { text: (s.title || s.tag) + ': ' }),
      ];
      if (!point) {
        chunk.push(h('span', { class: 'state-offline', text: 'нет данных' }));
      } else {
        chunk.push(h('span', { class: 'mono', text: fmt(point.avg) + (s.units ? ' ' + s.units : '') }));
        if (point.bad_fraction > 0) {
          chunk.push(h('span', { class: 'state-degraded', text:
            ` (недостоверно ${(point.bad_fraction * 100).toFixed(0)} %)` }));
        }
        if (cursors.length === 2) {
          const other = valueAt(s, cursors[0] === moment ? cursors[1] : cursors[0]);
          if (other) {
            chunk.push(h('span', { class: 'muted mono', text: ` Δ ${fmt(point.avg - other.avg)}` }));
          }
        }
        const before = past.find((p) => p.tag === s.tag);
        if (before) {
          const bp = valueAt(before, moment);
          if (bp) chunk.push(h('span', { class: 'muted mono', text: ` было ${fmt(bp.avg)}` }));
        }
      }
      parts.push(h('span', { class: 'trend-readout-item' }, chunk));
    }
    readout.replaceChildren(...parts);
  }

  // ── Выгрузка ───────────────────────────────────────────────────────

  async function exportCsv() {
    const chosen = [...state.tags].filter((t) => !state.hidden.has(t));
    if (!chosen.length) { toast('выберите хотя бы один ряд', 'warn'); return; }
    const { from, to } = range();
    try {
      const text = await api.exportCsv('/history/export', {
        tags: chosen.join(','), from, to, resolution: state.resolution,
      });
      downloadText(text, 'history.csv');
      toast(`выгружено рядов: ${chosen.length}`, 'ok');
    } catch (e) { reportError(e); }
  }

  // ── Состояние в адресе страницы ────────────────────────────────────

  function readState(all) {
    const params = new URLSearchParams((location.hash.split('?')[1] || ''));
    const wanted = (params.get('tags') || '').split(',').filter((t) => all.includes(t));
    const stored = (() => {
      try { return JSON.parse(localStorage.getItem('ib.trends') || '{}'); } catch { return {}; }
    })();
    const fallback = (stored.tags || []).filter((t) => all.includes(t));
    const hasLinkTags = params.has('tags');
    const panels = !hasLinkTags && Array.isArray(stored.panels)
      ? stored.panels.filter((panel) => panel && typeof panel === 'object').map((panel, index) => ({
        id: String(panel.id || `panel-${index + 1}`),
        title: String(panel.title || `График ${index + 1}`),
        style: ['line', 'step', 'bars', 'points'].includes(panel.style) ? panel.style : '',
        tags: [...new Set((panel.tags || []).filter((tag) => all.includes(tag)))],
        hidden: [...new Set((panel.hidden || []).filter((tag) => all.includes(tag)))],
        colors: Object.fromEntries(Object.entries(panel.colors || {}).filter(([, color]) => /^#[0-9a-f]{6}$/i.test(color))),
      }))
      : [];
    if (!panels.length) {
      const initialTags = wanted.length ? wanted : fallback.length ? fallback : [all[0]];
      panels.push({ id: 'panel-1', title: 'График 1', style: '', tags: [...new Set(initialTags)], hidden: [], colors: {} });
    }
    const initialTags = hasLinkTags ? wanted : panels.flatMap((panel) => panel.tags);
    return {
      tags: new Set(initialTags),
      hidden: new Set((params.get('hidden') || '').split(',').filter(Boolean)
        .concat(panels.flatMap((panel) => panel.hidden))),
      panels: hasLinkTags ? [{ id: 'panel-1', title: 'График 1', style: '', tags: [...new Set(wanted)], hidden: [], colors: {} }] : panels,
      activePanelId: String(stored.activePanelId || panels[0]?.id || 'panel-1'),
      period: Number(params.get('period')) || stored.period || 21600,
      resolution: params.get('resolution') || stored.resolution || 'auto',
      compare: Number(params.get('compare')) || 0,
      from: Number(params.get('from')) || null,
      to: Number(params.get('to')) || null,
      live: params.get('live') !== '0',
      log: params.get('log') === '1' || (!params.has('log') && !!stored.log),
      // Разложить по полям: каждая единица измерения — своё поле с общей
      // осью времени. На шести рядах в трёх единицах одно поле нечитаемо.
      split: params.has('split') ? params.get('split') === '1' : !!stored.split,
      style: params.get('style') || stored.style || 'line',
      // Заливка по умолчанию решается графиком по числу рядов: на одном ряду
      // она помогает, на восьми мешает. `null` — «решай сам».
      fill: params.has('fill') ? params.get('fill') === '1' : (stored.fill ?? null),
    };
  }

  function saveState() {
    const params = new URLSearchParams();
    params.set('tags', [...state.tags].join(','));
    if (state.hidden.size) params.set('hidden', [...state.hidden].join(','));
    params.set('period', String(state.period));
    params.set('resolution', state.resolution);
    if (state.compare) params.set('compare', String(state.compare));
    if (state.from && state.to) {
      params.set('from', String(state.from));
      params.set('to', String(state.to));
    }
    if (!live_) params.set('live', '0');
    if (state.log) params.set('log', '1');
    if (state.split) params.set('split', '1');
    if (state.style && state.style !== 'line') params.set('style', state.style);
    if (state.fill !== null && state.fill !== undefined) {
      params.set('fill', state.fill ? '1' : '0');
    }
    // Замена без записи в историю: иначе кнопка «назад» браузера листала бы
    // каждое движение курсора.
    history.replaceState(null, '', '#/trends?' + params.toString());
    try {
      localStorage.setItem('ib.trends', JSON.stringify({
        tags: [...state.tags], period: state.period, resolution: state.resolution,
        hidden: [...state.hidden], panels: state.panels, activePanelId: state.activePanelId,
        log: state.log, fill: state.fill, split: state.split, style: state.style,
      }));
    } catch { /* хранилище может быть закрыто настройками браузера */ }
  }

  function marksFor(events, chosen, from, to) {
    const devices = new Set(chosen.map(deviceOf));
    return (events || [])
      .filter((e) => e.at_us >= from && e.at_us <= to)
      .filter((e) => chosen.includes(e.source) || devices.has(deviceOf(e.source || '')))
      .map((e) => ({ at_us: e.at_us, priority: e.priority, message: `${e.priority}: ${e.message}` }));
  }
}

/** Логическая ли величина: по единице и по разбросу значений. */
function isDiscrete(series, meta) {
  if (meta && (meta.units === 'бит' || meta.units === 'вкл/выкл')) return true;
  const points = series.points || [];
  if (!points.length) return false;
  return points.every((p) => p.samples === 0
    || (p.min >= 0 && p.max <= 1 && Number.isInteger(p.min) && Number.isInteger(p.max)));
}

const PALETTE_FOR = (i) => [
  '#0072B2', '#E69F00', '#009E73', '#CC79A7', '#D55E00', '#56B4E9',
  '#332288', '#AA4499', '#117733', '#88CCEE', '#DDCC77', '#882255',
][((i % 12) + 12) % 12];

function stableSeriesColor(tag) {
  let hash = 2166136261;
  for (const char of String(tag)) hash = Math.imul(hash ^ char.charCodeAt(0), 16777619);
  return PALETTE_FOR(hash >>> 0);
}

const fmt = (v) => (v === null || v === undefined || !Number.isFinite(v))
  ? '—'
  : v.toLocaleString('ru-RU', { maximumFractionDigits: 3 });

const num = (v) => h('span', { class: 'num mono', text: fmt(v) });

function durationText(us) {
  const s = Math.round(us / 1e6);
  if (s < 60) return `${s} с`;
  const m = Math.floor(s / 60);
  if (m < 60) return `${m} мин ${s % 60} с`;
  const hrs = Math.floor(m / 60);
  if (hrs < 24) return `${hrs} ч ${m % 60} мин`;
  return `${Math.floor(hrs / 24)} сут ${hrs % 24} ч`;
}

// ── Панель опроса, собранная из виджетов ────────────────────────────

/**
 * Обзор опроса линий, приборов и регистров **виджетами**.
 *
 * Панель строится из конфигурации теми же типами, которыми инженер собирает
 * свои схемы, и отрисовывается тем же отрисовщиком. Это не витрина: если
 * встроенная панель показывает состояние опроса неудобно, значит и сделанная
 * инженером схема покажет так же — и правит это один и тот же код.
 *
 * Готовый документ можно выгрузить и открыть в редакторе как заготовку.
 */
async function polling({ host, live, toast, reportError, hasRole }) {
  const [devices, channels, violations, events] = await Promise.all([
    api.devices().catch(() => []),
    api.channels().catch(() => []),
    api.activeViolations().catch(() => []),
    api.events(20).catch(() => []),
  ]);

  const doc = pollingDocument(channels, devices, live);

  host.append(h('div', { class: 'toolbar' }, [
    h('h2', { text: 'Опрос: линии, приборы, регистры', style: 'margin:0' }),
    h('span', { class: 'spacer' }),
    h('span', { class: 'muted', text: `виджетов на панели: ${doc.widgets.length}` }),
    h('button', {
      text: 'открыть как схему в редакторе',
      onclick: async () => {
        // Панель — обычный документ мнемосхемы, и открывается он обычным
        // редактором: отдельного «режима диагностики» не существует.
        try {
          await mnemoStore.save(doc.id, doc);
          location.hash = '#/editor/' + encodeURIComponent(doc.id);
        } catch (e) { reportError(e); }
      },
    }),
  ]));

  const ctx = new RenderContext({
    live,
    violations,
    devices,
    channels,
    events,
    onAction: (spec, instance) => runAction(spec, instance, { toast, reportError, live }),
    // Источник истории для графиков на схеме: сами отрисовщики к API не
    // обращаются, иначе их нельзя было бы показать в редакторе и в проверке.
    history: (tags, from, to, resolution, maxPoints) =>
      api.history(tags, from, to, resolution, maxPoints),
    interactive: true,
  });

  const wrap = h('div', { class: 'mnemo-wrap' });
  const built = renderDocument(doc, ctx);
  wrap.append(built.node);
  host.append(wrap);

  const onTags = () => built.update();
  live.addEventListener('tags', onTags);

  // Состояние приборов и нарушения меняются реже значений и приходят
  // отдельным запросом: обновлять их на каждом пакете значений расточительно.
  const timer = setInterval(async () => {
    try {
      const [d, v, e] = await Promise.all([
        api.devices(), api.activeViolations(), api.events(20),
      ]);
      ctx.devices = new Map(d.map((x) => [x.path, x]));
      ctx.violations = new Map(v.map((x) => [x.tag, x]));
      ctx.events = e;
      built.update();
    } catch { /* сеть могла моргнуть; следующий такт повторит */ }
  }, 4000);

  return {
    dispose: () => {
      live.removeEventListener('tags', onTags);
      clearInterval(timer);
      // График на схеме держит свой таймер обновления архива: схема,
      // закрытая без освобождения, дёргала бы архив вечно.
      built.dispose();
    },
  };
}

/**
 * Собирает документ панели опроса из конфигурации.
 *
 * Раскладка простая и предсказуемая: строка на прибор, слева карточка
 * состояния, справа таблица его регистров. Плотная сетка тут вредна —
 * панель читают в момент разбора неисправности, а не любуются ею.
 */
function pollingDocument(channels, devices, live) {
  const CARD_W = 260, CARD_H = 88, TABLE_W = 420, GAP = 12;
  const widgets = [];
  let y = 56;

  widgets.push({
    id: 'banner', type: 'core.alarm_banner', layer: 'main', z: 0,
    geometry: { x: 16, y: 12, w: CARD_W + GAP + TABLE_W, h: 30 },
    bindings: {}, properties: {},
  });

  for (const channel of channels) {
    const own = devices.filter((d) => d.channel === channel.id);
    widgets.push({
      id: 'ch-' + channel.id, type: 'core.label', layer: 'main', z: 1,
      geometry: { x: 16, y, w: 600, h: 20 },
      bindings: {},
      properties: {
        text: `${channel.id} — ${channel.transport}, приборов ${channel.devices}`
          + (channel.running ? '' : ' — ОСТАНОВЛЕН'),
      },
    });
    y += 26;

    for (const device of own) {
      const tagCount = live.all().filter((t) => t.name.startsWith(device.path + '.')).length;
      const tableHeight = Math.max(CARD_H, Math.min(24 + tagCount * 18, 260));

      widgets.push({
        id: 'card-' + device.path, type: 'core.device_card', layer: 'main', z: 2,
        geometry: { x: 16, y, w: CARD_W, h: CARD_H },
        bindings: { device: { kind: 'device', device: device.path } },
        properties: { title: device.name || device.path },
      });
      widgets.push({
        id: 'regs-' + device.path, type: 'core.table', layer: 'main', z: 2,
        geometry: { x: 16 + CARD_W + GAP, y, w: TABLE_W, h: tableHeight },
        bindings: { rows: { kind: 'tag_set', pattern: device.path + '.*' } },
        properties: { title: 'регистры ' + device.path, show_quality: true },
      });
      y += Math.max(CARD_H, tableHeight) + GAP;
    }
    y += 8;
  }

  widgets.push({
    id: 'events', type: 'core.event_list', layer: 'main', z: 1,
    geometry: { x: 16, y, w: CARD_W + GAP + TABLE_W, h: 140 },
    bindings: {}, properties: {},
  });
  y += 160;

  return {
    schema_version: 1,
    id: 'опрос-объекта',
    name: 'Опрос объекта',
    canvas: { w: 16 + CARD_W + GAP + TABLE_W + 16, h: Math.max(400, y), grid: 4, fit: 'width' },
    layers: [{ id: 'main', name: 'Основной', visible: true }],
    widgets,
    resource_data: {},
  };
}

// ── Настройка приборов Modbus ───────────────────────────────────────

const TRANSPORTS = [
  ['rtu', 'последовательный RTU'],
  ['rtu_over_tcp', 'RTU поверх TCP'],
  ['tcp', 'Modbus TCP (MBAP)'],
  ['rtu_over_udp', 'RTU поверх UDP'],
  ['c2000_ethernet', 'С2000-Ethernet'],
  // Имитатор — такой же вид транспорта, и в перечне он обязателен: без него у
  // канала имитатора выбор оказывался пустым, то есть вид транспорта выглядел
  // незаданным, а правка любого другого поля рисковала его подменить.
  ['simulated', 'встроенный имитатор — величины вымышлены'],
];

/**
 * Какие ключи описывают каждый вид транспорта.
 *
 * Нужны при **смене** вида. Прежде смена сохраняла всё, что было: выбрал
 * «последовательный RTU» после «RTU поверх TCP» — и рядом с портом COM
 * оставались адрес и порт от сети. Служба их отбрасывает, линия идёт в COM, а
 * в файле написан адрес; человек читает файл и ищет неисправность в сети.
 *
 * Перечень повторяет тот, что знает разбор настройки, и сверяется с ним
 * проверкой: разойдись они — редактор выбрасывал бы нужное либо оставлял
 * лишнее, то есть ровно то, от чего заведён.
 */
const TRANSPORT_KEYS = {
  rtu: ['path', 'baud', 'data_bits', 'parity', 'stop_bits'],
  tcp: ['host', 'port'],
  rtu_over_tcp: ['host', 'port'],
  rtu_over_udp: ['remote_host', 'remote_port', 'local_host', 'local_port'],
  c2000_ethernet: ['remote_host', 'remote_port', 'local_host', 'local_port', 'wrapper'],
  simulated: ['units'],
};

/**
 * Описание линии после смены вида транспорта.
 *
 * Общие ключи переносятся: `tcp` и `rtu_over_tcp` описываются одинаково, и
 * заставлять набирать адрес заново незачем. Прочие отбрасываются — и об этом
 * говорится вслух: молча потерянный адрес человек заметит не сразу, а пустое
 * поле видно.
 */
function retypedTransport(before, type) {
  const kept = TRANSPORT_KEYS[type] || [];
  const next = { type };
  const dropped = [];
  for (const [key, value] of Object.entries(before || {})) {
    if (key === 'type') continue;
    if (kept.includes(key)) next[key] = value;
    else dropped.push(key);
  }
  return { transport: next, dropped };
}

const AREAS = [
  ['input', 'регистры ввода (04)'],
  ['holding', 'регистры хранения (03)'],
  ['coil', 'регистры флагов (01)'],
  ['discrete', 'дискретные входы (02)'],
];

const DATA_TYPES = ['u16', 'i16', 'u32', 'i32', 'f32', 'bool', 'bit', 'q8.8', 'bcd', 'ascii'];

/**
 * Настройка каналов, приборов и регистров.
 *
 * Правится **та же** конфигурация, которую читает служба, и проверяется тем же
 * кодом, что `ibolid validate`. Расхождение между «проверил в интерфейсе» и
 * «не запустилось на объекте» — худшее, что может дать такой редактор.
 *
 * Изменения вступают в силу после перезапуска, и об этом сказано прямо:
 * молчание означало бы, что инженер сохранит настройку, увидит прежние
 * значения и решит, что она не сработала.
 */
async function setup({ host, toast, reportError, hasRole }) {
  if (!hasRole('engineer')) {
    host.append(h('p', { class: 'empty', text: 'настройка приборов доступна роли «инженер» и выше' }));
    return;
  }

  let loaded;
  try {
    loaded = await api.config();
  } catch (e) {
    host.append(h('p', { class: 'empty', text:
      'правка конфигурации не подключена: служба запущена без указания файла' }));
    return;
  }

  let doc;
  try {
    doc = JSON.parse(loaded.text);
  } catch (e) {
    host.append(h('p', { class: 'error', text: 'файл конфигурации не разбирается: ' + e.message }));
    host.append(h('pre', { class: 'mono', text: loaded.text.slice(0, 2000) }));
    return;
  }

  // Порты машины: перечень запрашивается при открытии экрана и обновляется
  // кнопкой. Преобразователь USB втыкают во время пусконаладки, и список,
  // снятый однажды, его не покажет.
  let ports = [];
  async function reloadPorts() {
    try {
      ports = (await api.ports()).items;
    } catch { ports = []; }
  }
  await reloadPorts();

  // Профили нужны и мастеру, и выбору у существующего прибора, и сохранению
  // шаблона: перечень держится один на экран.
  let profileList = [];
  try {
    profileList = (await api.profiles()).items;
  } catch { profileList = []; }

  const status = h('span', { class: 'muted' });
  const tree = h('div');
  // Какие строки регистров раскрыты в подробности. Множество по ссылке на
  // объект регистра: по номеру строки раскрытие «съезжало» бы при добавлении и
  // удалении соседних регистров.
  const registerDetailsShown = new Set();

  host.append(
    h('div', { class: 'toolbar' }, [
      h('h2', { text: 'Настройка приборов', style: 'margin:0' }),
      h('span', { class: 'spacer' }),
      h('span', { class: 'muted mono', text: loaded.path }),
    ]),
    h('div', { class: 'toolbar' }, [
      h('button', { text: 'добавить канал', onclick: addChannel }),
      h('button', { text: 'проверить', onclick: check }),
      h('button', { class: 'primary', text: 'сохранить', onclick: save }),
      h('button', { text: 'править как текст', onclick: editRaw }),
      h('button', { text: 'выгрузить весь опрос', onclick: () => {
        // Выгружается **сохранённая** настройка, а не та, что правится на
        // экране: увезти на другой объект то, чего на этом нет, — это перенос
        // не объекта, а черновика.
        window.location.href = api.configExportUrl('');
      }, title: 'все линии, приборы и группы опроса одним файлом; '
              + 'адрес интерфейса, уведомления и пути не переносятся — они у объекта свои' }),
      h('button', { text: 'загрузить линию из файла', onclick: importFragment,
        title: 'принять выгрузку, сделанную на другом объекте' }),
      h('button', { text: 'история', onclick: showHistory,
        title: 'снимки настройки и возврат к любому из них' }),
      h('span', { class: 'spacer' }),
      status,
    ]),
    h('p', { class: 'muted', text:
      'Изменения записываются в файл и вступают в силу после перезапуска службы. '
      + 'Перед каждой записью прежняя настройка уходит в историю — вернуться '
      + 'можно к любому снимку, а не только к последнему.' }),
    tree,
  );

  /// Снимки настройки и возврат к любому из них.
  ///
  /// Возврат — это тоже сохранение: нынешнее состояние сначала уходит в
  /// историю, поэтому ошибиться в выборе снимка не страшно.
  async function showHistory() {
    let revisions;
    try {
      revisions = (await api.configHistory()).revisions;
    } catch (e) {
      reportError(e);
      return;
    }
    if (!revisions.length) {
      toast('история пуста: настройку ещё ни разу не сохраняли', 'ok');
      return;
    }
    const box = h('div', { class: 'cfg-block' });
    box.append(h('p', { class: 'hint', text:
      'Снимок делается перед каждой записью. Возврат к снимку сам попадёт в '
      + 'историю, поэтому его тоже можно отменить.' }));
    box.append(h('table', { class: 'cfg-regs' }, [
      h('thead', {}, h('tr', {}, headerCells(['Снимок', 'Размер', 'Кто и что', '']))),
      h('tbody', {}, revisions.map((r) => h('tr', {}, [
        h('td', { class: 'mono', text: r.id
          + (r.earliest ? ' — самый ранний' : '') }),
        h('td', { class: 'num', text: String(r.bytes) }),
        h('td', { text: r.note || '' }),
        h('td', {}, [
          h('button', { class: 'small', text: 'показать', onclick: async () => {
            try {
              const one = await api.configRevision(r.id);
              const area = h('textarea', { rows: 24, readonly: true,
                style: 'width:100%;font-family:var(--mono);font-size:12px' });
              area.value = one.text;
              await modal({
                title: `Снимок ${r.id}`,
                body: h('div', {}, [
                  h('p', { class: 'muted', text:
                    'Только чтение. Чтобы вернуться к этому состоянию, нажмите «вернуть».' }),
                  area,
                ]),
                confirmText: 'Закрыть',
                onConfirm: async () => true,
              });
            } catch (e) { reportError(e); }
          } }),
          h('button', { class: 'small', text: 'вернуть', onclick: async () => {
            if (!window.confirm(
              `Вернуть настройку к снимку ${r.id}?\n\n`
              + 'Нынешняя уйдёт в историю — возврат можно будет отменить.')) return;
            try {
              await api.configRestore(r.id);
              toast('настройка возвращена; чтобы применить — перезапустите службу', 'ok');
              location.reload();
            } catch (e) { reportError(e); }
          } }),
        ]),
      ]))),
    ]));
    tree.replaceChildren(box);
  }

  /// Загрузка выгруженной линии.
  async function importFragment() {
    const input = h('input', { type: 'file', accept: '.json,application/json' });
    input.addEventListener('change', async () => {
      const file = input.files && input.files[0];
      if (!file) return;
      const text = await file.text();
      // Способ спрашивается до отправки: замена настроенной линии — потеря
      // работы наладчика, и решать это должен он, а не умолчание.
      const mode = window.prompt(
        'Что делать, если линия с таким именем уже есть?\n'
        + '  отказ — ничего не менять (по умолчанию)\n'
        + '  замена — заменить существующую\n'
        + '  переименовать — добавить под новым именем',
        'отказ');
      if (mode === null) return;
      const on = { 'замена': 'replace', 'переименовать': 'rename' }[mode.trim()] || 'refuse';
      try {
        const answer = await api.configImport(text, on);
        const r = answer.report;
        toast(`загружено: линий ${r.channels.length}, приборов ${r.devices.length}`
          + (r.renamed.length ? `, переименовано ${r.renamed.length}` : ''), 'ok');
        location.reload();
      } catch (e) { reportError(e); }
    });
    input.click();
  }

  function redraw() {
    tree.replaceChildren(
      objectBlock(),
      pollGroupsBlock(),
      templatesBlock(),
      ...(doc.channels || []).map(channelBlock),
    );
    if (!doc.channels || !doc.channels.length) {
      tree.append(h('p', { class: 'empty', text: 'каналов нет — добавьте первый' }));
    }
  }

  /**
   * Шаблоны приборов: свои профили объекта.
   *
   * Создать шаблон можно из карточки прибора, а убрать — только отсюда. Без
   * этого блока перекрытие поставочного профиля становилось необратимым из
   * интерфейса: файл лежал бы в каталоге данных, а снять его было бы нечем.
   */
  function templatesBlock() {
    const own = profileList.filter((p) => p.editable);
    // Поставочные показываются здесь же: править их нужно не реже своих —
    // карту регистров импортированного профиля уточняют по месту. Правка
    // создаёт **перекрытие**: файл поставки остаётся нетронутым.
    const bundled = profileList.filter((p) => !p.editable);
    const box = h('details', { class: 'cfg-block', open: own.length ? '' : undefined });
    box.append(h('summary', {
      text: `Шаблоны приборов: своих ${own.length}, из поставки ${bundled.length}`,
    }));
    box.append(h('div', { class: 'toolbar' }, [
      h('button', { class: 'primary', text: 'создать шаблон', onclick: createTemplate }),
      h('span', { class: 'muted', text:
        'либо соберите его из настроенного прибора кнопкой «сохранить как шаблон»' }),
    ]));


    const overriding = own.filter((p) => p.overrides_bundled);
    if (overriding.length) {
      box.append(h('p', { class: 'warn-line', text:
        'Перекрывают профили комплекта поставки: '
        + overriding.map((p) => p.id).join(', ')
        + '. Приборы объекта работают по этим картам регистров, а не по поставочным.' }));
    }

    const row = (p) => [
      h('span', { class: 'mono', text: p.id }),
      p.name,
      String(p.registers),
      p.writable ? String(p.writable) : '',
      (p.poll_groups || []).join(', '),
      h('span', {}, [
        p.overrides_bundled
          ? h('span', { class: 'lvl lvl-warning', text: 'перекрывает поставочный' })
          : '',
        // Карту регистров уточняют на объекте: лишние параметры убирают,
        // забытые дописывают. Без правки это означало бы «удалить и собрать
        // заново из прибора», то есть потерять всё, чего в приборе нет.
        h('button', {
          class: 'small',
          text: p.editable ? 'править' : 'править (перекрытие)',
          title: p.editable
            ? 'изменить карту регистров шаблона'
            : 'правка создаст свой профиль с этим именем; файл поставки останется',
          onclick: () => editTemplate(p),
        }),
        p.editable
          ? h('button', { class: 'small', text: 'удалить', onclick: () => removeTemplate(p) })
          : '',
      ]),
    ];

    const head = ['Шаблон', 'Название', 'Регистров', 'На запись', 'Группы опроса', ''];
    if (own.length) {
      box.append(h('h3', { text: 'Свои' }));
      box.append(table(head, own.map(row)));
    }
    if (bundled.length) {
      box.append(h('h3', { text: 'Из комплекта поставки' }));
      box.append(h('p', { class: 'muted', text:
        'Правка не трогает файл поставки: создаётся свой профиль с тем же именем, '
        + 'и он перекрывает поставочный на всём объекте. Удаление перекрытия '
        + 'возвращает поставочный.' }));
      box.append(table(head, bundled.map(row)));
    }
    return box;
  }


  /**
   * Редактор шаблона прибора.
   *
   * Шаблон, который нельзя править, — половина дела: карту регистров уточняют
   * на объекте, лишние параметры убирают, забытые дописывают. Прежде правка
   * означала «удалить шаблон и собрать заново из прибора», то есть потерять
   * всё, чего в приборе нет.
   *
   * Правится **копия** в памяти, и лишь по «сохранить» уходит на службу: там
   * профиль проверяется тем же кодом, что `ibolid profile check`, и негодный
   * на диск не попадает.
   */
  async function editTemplate(view) {
    // Правка профиля из поставки создаёт перекрытие: файл поставки остаётся,
    // но приборы объекта начинают работать по новой карте. Спросить об этом
    // надо до правки, а не после набора двадцати изменений.
    if (!view.editable) {
      const confirmed = await modal({
        title: `Править профиль поставки «${view.id}»?`,
        body: h('div', {}, [
          h('p', {}, [
            'Файл комплекта поставки не изменится. Будет создан свой профиль с тем же '
            + 'именем в каталоге данных, и он ',
            h('strong', { text: 'перекроет поставочный на всём объекте' }),
            `: все приборы, ссылающиеся на «${view.id}», начнут работать по вашей карте.`,
          ]),
          h('p', { class: 'muted', text:
            `Сейчас в профиле регистров: ${view.registers}. Перекрытие снимается удалением `
            + 'своего профиля — поставочный вернётся в силу.' }),
          h('p', { class: 'muted', text:
            'Если правка нужна одному прибору, а не всем, — вместо этого задайте '
            + 'переопределения в карточке прибора: «Регистры профиля».' }),
        ]),
        confirmText: 'Править с перекрытием',
        cancelText: 'Отмена',
        onConfirm: async () => true,
      });
      if (!confirmed) return;
    }

    let registers;
    try {
      registers = (await api.profileRegisters(view.id)).registers.map((r) => ({ ...r }));
    } catch (e) {
      reportError(e);
      return;
    }

    const idInput = h('input', { value: view.id, readonly: 'readonly', style: 'width:220px' });
    const nameInput = h('input', { value: view.name || view.id, style: 'width:220px' });
    const vendorInput = h('input', { value: view.vendor || '', style: 'width:160px' });
    const filter = h('input', { type: 'search', placeholder: 'фильтр по имени тега' });
    const table = h('div', {});
    const counter = h('span', { class: 'muted' });

    filter.addEventListener('input', () => draw());

    /** Пустой регистр: заполняется тут же, а не в отдельном окне. */
    function blankRegister() {
      // Свободное имя: столкновение имён внутри шаблона — отказ при проверке,
      // и наткнуться на него после набора двадцати регистров обидно.
      let n = registers.length + 1;
      let tag = `новый${n}`;
      while (registers.some((r) => r.tag === tag)) {
        n += 1;
        tag = `новый${n}`;
      }
      return {
        tag,
        name: '',
        area: 'input',
        address: 0,
        data_type: null,
        poll_group: null,
        writable: false,
        units: '',
        bit: null,
        quantity: null,
        length: null,
        frac_bits: null,
        word_order: null,
        byte_order: null,
        min: null,
        max: null,
        description: '',
      };
    }

    const expanded = new Set();

    function draw() {
      const needle = filter.value.trim().toLowerCase();
      const shown = registers.filter((r) => !needle
        || r.tag.toLowerCase().includes(needle)
        || (r.name || '').toLowerCase().includes(needle));

      counter.textContent = shown.length === registers.length
        ? `регистров ${registers.length}`
        : `показано ${shown.length} из ${registers.length}`;

      const rows = [];
      for (const reg of shown) {
        const text = (key, width, placeholder) => {
          const input = h('input', { value: reg[key] ?? '', style: `width:${width}`, placeholder });
          input.addEventListener('input', () => { reg[key] = input.value; });
          return input;
        };
        const num = (key, width, placeholder) => {
          const input = h('input', {
            type: 'number', step: 'any', style: `width:${width}`, placeholder,
            value: reg[key] === null || reg[key] === undefined ? '' : String(reg[key]),
          });
          input.addEventListener('input', () => {
            reg[key] = input.value === '' ? null : Number(input.value);
          });
          return input;
        };

        const row = h('tr', {}, [
          h('td', {}, text('tag', '160px', 'имя тега')),
          h('td', {}, text('name', '150px', 'название')),
          h('td', {}, selectInput(AREAS, reg.area || 'input', (v) => { reg.area = v; })),
          h('td', {}, num('address', '80px', 'адрес')),
          h('td', {}, selectInput(
            [['', 'по умолчанию'], ...DATA_TYPES.map((t) => [t, t])],
            reg.data_type || '', (v) => { reg.data_type = v || null; },
          )),
          h('td', {}, checkboxInput(!!reg.writable, (v) => { reg.writable = v; })),
          h('td', {}, text('units', '52px', 'ед.')),
          h('td', {}, h('button', {
            class: 'small',
            text: expanded.has(reg) ? 'скрыть' : 'ещё',
            onclick: () => {
              if (expanded.has(reg)) expanded.delete(reg);
              else expanded.add(reg);
              draw();
            },
          })),
          h('td', {}, h('button', {
            class: 'danger', text: '×', title: 'удалить регистр',
            onclick: () => {
              registers = registers.filter((x) => x !== reg);
              expanded.delete(reg);
              draw();
            },
          })),
        ]);
        rows.push(row);

        if (expanded.has(reg)) {
          rows.push(h('tr', {}, h('td', { colspan: '9' }, h('div', { class: 'cfg-details' }, [
            h('div', { class: 'toolbar' }, [
              h('span', { class: 'muted', text: 'декодирование:' }),
              field('бит', num('bit', '70px', '—')),
              field('регистров', num('quantity', '80px', 'по типу')),
              field('длина', num('length', '70px', '—')),
              field('дробных бит', num('frac_bits', '80px', '—')),
              // Значения — те же, что понимает формат: `big_endian` и
              // `little_endian`. Короткие «big»/«little» отвергаются разбором,
              // и настройка молча не применилась бы.
              field('порядок слов', selectInput(
                [['', 'старшее первым'], ['little_endian', 'младшее первым']],
                reg.word_order === 'little_endian' ? 'little_endian' : '',
                (v) => { reg.word_order = v || null; },
              )),
              field('порядок байт', selectInput(
                [['', 'старший первым'], ['little_endian', 'младший первым']],
                reg.byte_order === 'little_endian' ? 'little_endian' : '',
                (v) => { reg.byte_order = v || null; },
              )),
            ]),
            h('div', { class: 'toolbar' }, [
              h('span', { class: 'muted', text: 'запись и опрос:' }),
              field('не меньше', num('min', '90px', '—')),
              field('не больше', num('max', '90px', '—')),
              field('группа опроса', (() => {
                const input = h('input', {
                  value: reg.poll_group || '', style: 'width:110px', placeholder: 'как у прибора',
                  title: 'группа, объявленная профилем; пусто — задаст объект',
                });
                input.addEventListener('input', () => { reg.poll_group = input.value.trim() || null; });
                return input;
              })()),
              field('пояснение', text('description', '220px', 'что это за величина')),
            ]),
          ]))));
        }
      }

      table.replaceChildren(h('table', { class: 'cfg-regs' }, [
        h('thead', {}, h('tr', {}, ['Тег', 'Название', 'Область', 'Адрес', 'Тип', 'Запись', 'Ед.', '', '']
          .map((t) => h('th', { text: t })))),
        h('tbody', {}, rows),
      ]));
    }
    draw();

    const body = h('div', {}, [
      h('div', { class: 'toolbar' }, [
        field('идентификатор', idInput),
        field('название', nameInput),
        field('изготовитель', vendorInput),
      ]),
      h('p', { class: 'muted', text:
        'Идентификатор не меняется: по нему на шаблон ссылаются приборы, и смена '
        + 'имени оставила бы их без профиля. Чтобы получить шаблон под другим '
        + 'именем, сохраните прибор шаблоном заново.' }),
      h('div', { class: 'toolbar' }, [
        h('button', { class: 'primary', text: 'добавить регистр', onclick: () => {
          const reg = blankRegister();
          registers.push(reg);
          expanded.add(reg);
          filter.value = '';
          draw();
        } }),
        filter,
        h('span', { class: 'spacer' }),
        counter,
      ]),
      table,
    ]);

    const saved = await modal({
      title: view.editable
        ? `Шаблон «${view.id}»`
        : `Шаблон «${view.id}» — правка создаст перекрытие поставочного`,
      body,
      confirmText: view.editable ? 'Сохранить шаблон' : 'Сохранить перекрытие',
      onConfirm: async () => {
        if (!registers.length) {
          throw new Error('шаблон без регистров бесполезен: добавьте хотя бы один');
        }
        // Столкновения имён внутри шаблона отвергаются здесь, а не после
        // записи: служба вернёт ту же ошибку, но набранная правка пропала бы.
        const seen = new Set();
        for (const r of registers) {
          const tag = (r.tag || '').trim();
          if (!tag) throw new Error('у регистра пустое имя тега');
          if (seen.has(tag)) throw new Error(`имя тега «${tag}» встречается дважды`);
          seen.add(tag);
        }
        return api.saveProfile({
          id: view.id,
          name: nameInput.value.trim() || view.id,
          vendor: vendorInput.value.trim(),
          description: view.description || '',
          strip_prefix: '',
          // Перекрытие подтверждено до начала правки: спрашивать второй раз
          // после набранных изменений значило бы предлагать их потерять.
          override_bundled: !view.editable || !!view.overrides_bundled,
          registers: registers.map((r) => ({
            tag: r.tag.trim(),
            name: r.name || '',
            area: r.area || 'input',
            address: r.address ?? 0,
            data_type: r.data_type || null,
            poll_group: r.poll_group || null,
            writable: !!r.writable,
            units: r.units || '',
            bit: r.bit ?? null,
            quantity: r.quantity ?? null,
            length: r.length ?? null,
            frac_bits: r.frac_bits ?? null,
            word_order: r.word_order || null,
            byte_order: r.byte_order || null,
            min: r.min ?? null,
            max: r.max ?? null,
            description: r.description || '',
          })),
        });
      },
    });
    if (!saved) return;

    profileList = (await api.profiles().catch(() => ({ items: profileList }))).items || profileList;
    toast(`шаблон «${saved.name}» сохранён: регистров ${saved.registers}`, 'ok');
    redraw();
  }

  /** Пустой шаблон: карта регистров набирается с нуля. */
  async function createTemplate() {
    const idInput = h('input', { value: 'свой.новый-прибор', style: 'width:240px' });
    const nameInput = h('input', { value: 'Новый прибор', style: 'width:240px' });
    const vendorInput = h('input', { value: '', style: 'width:200px' });

    const created = await modal({
      title: 'Новый шаблон прибора',
      body: h('div', {}, [
        h('p', { class: 'muted', text:
          'Шаблон создаётся с одним регистром — его и остальные вы зададите в '
          + 'редакторе. Пустой шаблон служба не примет: применить его к прибору '
          + 'всё равно нельзя.' }),
        h('label', {}, ['идентификатор', idInput]),
        h('label', {}, ['название', nameInput]),
        h('label', {}, ['изготовитель', vendorInput]),
      ]),
      confirmText: 'Создать',
      onConfirm: async () => {
        const id = idInput.value.trim();
        if (!id) throw new Error('идентификатор не может быть пустым');
        if (profileList.some((p) => p.id === id)) {
          throw new Error(`шаблон «${id}» уже есть: откройте его правку`);
        }
        return api.saveProfile({
          id,
          name: nameInput.value.trim() || id,
          vendor: vendorInput.value.trim(),
          description: '',
          strip_prefix: '',
          registers: [{
            tag: 'значение', name: '', area: 'input', address: 0,
            data_type: null, poll_group: null, writable: false, units: '',
          }],
        });
      },
    });
    if (!created) return;
    profileList = (await api.profiles().catch(() => ({ items: profileList }))).items || profileList;
    toast(`шаблон «${created.id}» создан — задайте регистры`, 'ok');
    redraw();
    // Сразу открывается правка: шаблон с одним пустым регистром бесполезен,
    // и оставлять инженера искать кнопку «править» незачем.
    await editTemplate(created);
  }

  /** Удаление своего шаблона. */
  async function removeTemplate(profile) {
    // Приборы, ссылающиеся на шаблон, перечисляются до удаления: без шаблона
    // они не загрузятся, и служба откажется стартовать после перезапуска.
    const users = [];
    for (const channel of doc.channels || []) {
      for (const device of channel.devices || []) {
        if (device.profile === profile.id) users.push(`${channel.id}.${device.id}`);
      }
    }

    const done = await modal({
      title: `Удалить шаблон «${profile.id}»?`,
      body: h('div', {}, [
        profile.overrides_bundled
          ? h('p', { class: 'warn-line', text:
              'Шаблон перекрывает профиль комплекта поставки. После удаления вернётся '
              + 'поставочный, и карта регистров приборов изменится.' })
          : null,
        users.length
          ? h('p', { class: 'warn-line', text:
              'На шаблон ссылаются приборы: ' + users.join(', ')
              + (profile.overrides_bundled
                ? '. Они перейдут на поставочный профиль.'
                : '. Без шаблона они не загрузятся, и служба не запустится.') })
          : h('p', { class: 'muted', text: 'Ни один прибор на шаблон не ссылается.' }),
      ]),
      confirmText: 'Удалить шаблон',
      onConfirm: async () => api.deleteProfile(profile.id),
    });
    if (!done) return;

    profileList = (await api.profiles().catch(() => ({ items: profileList }))).items || profileList;
    // Возврат поставочного профиля называется прямо: карта регистров приборов
    // изменилась, и молчать об этом нельзя.
    toast(done.restored_bundled
      ? `шаблон удалён, вернулся поставочный профиль: регистров ${done.restored_bundled.registers}`
      : `шаблон «${profile.id}» удалён`, 'ok');
    redraw();
  }

  /** Период группы по её имени, миллисекунды. */
  function periodOf(groupId) {
    const group = (doc.poll_groups || []).find((g) => g.id === groupId);
    return group ? group.period_ms : null;
  }

  /** Сколько регистров пользуется группой опроса. */
  function groupUsage(groupId) {
    let count = 0;
    for (const channel of doc.channels || []) {
      for (const device of channel.devices || []) {
        if (device.poll_group === groupId) count += 1000000; // прибор целиком
        for (const reg of device.registers || []) {
          if (reg.poll_group === groupId) count += 1;
        }
      }
    }
    return count;
  }

  /**
   * Группы опроса: период задаётся здесь и здесь же меняется.
   *
   * Раньше периоды правились только в файле, то есть «задаваемое» не было
   * «изменяемым». Группа, которой кто-то пользуется, не удаляется: регистр
   * со ссылкой на несуществующую группу не даст службе запуститься.
   */
  /**
   * Параметры объекта и его запуска.
   *
   * Правились только «как текст», то есть руками в JSON. Между тем это ровно
   * те величины, которые меняют на каждом объекте: имя, адрес, порт, номер
   * экземпляра.
   */
  function objectBlock() {
    doc.gateway = doc.gateway || {};
    doc.web = doc.web || {};

    const name = h('input', {
      type: 'text', style: 'width:min(360px,100%)',
      value: doc.gateway.instance_name || '',
      placeholder: 'например, Насосная станция',
    });
    name.addEventListener('input', () => {
      doc.gateway.instance_name = name.value.trim() || undefined;
    });

    // Номер экземпляра: на посту держат несколько объектов сразу, и служба
    // Windows у каждого обязана быть своя — иначе установка второго заменяет
    // первый.
    const instance = h('input', {
      type: 'number', min: '1', max: '99', style: 'width:80px',
      value: String(doc.gateway.instance || 1),
    });
    instance.addEventListener('input', () => {
      const value = Number(instance.value);
      doc.gateway.instance = Number.isFinite(value) && value >= 1 ? value : undefined;
      redraw();
    });

    const enabled = h('input', { type: 'checkbox' });
    enabled.checked = doc.web.enabled !== false;
    enabled.addEventListener('change', () => {
      doc.web.enabled = enabled.checked;
      redraw();
    });

    // Адрес задаётся строкой: на объекте бывает несколько сетевых плат, и
    // «слушать только ту, что смотрит в цех» — обычное требование. Две
    // кнопки рядом закрывают два случая из трёх.
    const bindValue = typeof doc.web.bind === 'string' ? doc.web.bind : 'local';
    const bind = h('input', {
      type: 'text', style: 'width:200px', value: bindValue,
      placeholder: '127.0.0.1, 0.0.0.0 либо адрес платы',
    });
    const setBind = (value) => {
      doc.web.bind = value;
      bind.value = value;
      redraw();
    };
    bind.addEventListener('input', () => {
      doc.web.bind = bind.value.trim() || undefined;
    });
    bind.addEventListener('change', () => redraw());

    const port = h('input', {
      type: 'number', min: '1', max: '65535', style: 'width:110px',
      value: String(doc.web.port || 8080),
    });
    port.addEventListener('input', () => {
      const value = Number(port.value);
      doc.web.port = Number.isFinite(value) && value > 0 ? value : undefined;
    });

    const local = ['local', 'localhost', 'loopback', '127.0.0.1'].includes(
      String(doc.web.bind || 'local').toLowerCase(),
    );
    const shown = String(doc.web.bind || 'local').toLowerCase();
    const anywhere = ['any', 'all', '0.0.0.0', '*'].includes(shown);

    return h('div', { class: 'cfg-block' }, [
      h('h2', { text: 'Объект' }),
      h('div', { class: 'toolbar' }, [
        h('label', { text: 'Имя' }), name,
        h('label', { text: 'Экземпляр №' }), instance,
      ]),
      h('p', { class: 'muted', text:
        'Имя стоит в заголовке окна и в шапке интерфейса. Номер экземпляра '
        + 'различает несколько объектов на одном посту: служба Windows у '
        + 'первого зовётся «ibolid», у остальных — «ibolid-N».' }),

      h('h2', { text: 'Параметры запуска' }),
      h('p', { class: 'muted', text:
        'Адрес, порт и номер экземпляра — это про саму программу, а не про '
        + 'приборы: они переехали на экран «Настройка».' }),
      h('div', { class: 'toolbar' }, [
        h('a', { class: 'button', href: '#/settings', text: 'открыть «Настройку»' }),
      ]),
    ].filter(Boolean));
  }

  function pollGroupsBlock() {
    const groups = doc.poll_groups || [];
    const rows = groups.map((group, gi) => {
      const usage = groupUsage(group.id);
      const wholeDevices = Math.floor(usage / 1000000);
      const registers = usage % 1000000;
      const usageText = [
        wholeDevices ? `приборов целиком: ${wholeDevices}` : null,
        registers ? `регистров: ${registers}` : null,
      ].filter(Boolean).join(', ') || 'не используется';

      const remove = h('button', { class: 'danger', text: 'удалить' });
      if (usage > 0) {
        remove.disabled = true;
        remove.title = 'группа используется; сначала переведите регистры на другую';
      } else if (groups.length <= 1) {
        remove.disabled = true;
        remove.title = 'должна остаться хотя бы одна группа опроса';
      } else {
        remove.addEventListener('click', () => {
          doc.poll_groups.splice(gi, 1);
          redraw();
        });
      }

      return h('tr', {}, [
        h('td', {}, textInput(group.id, (v) => {
          // Переименование тянет за собой ссылки: иначе регистры остались бы
          // указывать на исчезнувшее имя, и конфигурация стала бы негодной.
          const old = group.id;
          const next = v.trim();
          if (!next || next === old) return;
          group.id = next;
          for (const channel of doc.channels || []) {
            for (const device of channel.devices || []) {
              if (device.poll_group === old) device.poll_group = next;
              for (const reg of device.registers || []) {
                if (reg.poll_group === old) reg.poll_group = next;
              }
            }
          }
        }, 'width:130px')),
        h('td', {}, h('span', { class: 'toolbar', style: 'margin:0;gap:4px' }, [
          numberInput(group.period_ms, (v) => { group.period_ms = Math.max(50, v); }, 'width:100px'),
          h('span', { class: 'muted', text: 'мс' }),
        ])),
        h('td', {}, selectInput(
          [['', 'по периоду'], ['fast', 'быстрый'], ['normal', 'обычный'], ['slow', 'медленный']],
          group.class || '', (v) => { group.class = v || undefined; },
        )),
        h('td', { class: 'muted', text: usageText }),
        h('td', {}, remove),
      ]);
    });

    return h('div', { class: 'cfg-block' }, [
      h('div', { class: 'toolbar' }, [
        h('strong', { text: 'Группы опроса' }),
        h('span', { class: 'muted', text: 'период задаётся здесь и действует на все ссылающиеся регистры' }),
        h('span', { class: 'spacer' }),
        h('button', { text: 'добавить группу', onclick: () => {
          doc.poll_groups = doc.poll_groups || [];
          let n = doc.poll_groups.length + 1;
          while (doc.poll_groups.some((g) => g.id === 'группа' + n)) n += 1;
          doc.poll_groups.push({ id: 'группа' + n, period_ms: 1000 });
          redraw();
        } }),
      ]),
      groups.length
        ? h('table', { class: 'cfg-regs' }, [
          h('thead', {}, h('tr', {}, ['Имя', 'Период', 'Класс запроса', 'Где используется', '']
            .map((t) => h('th', { text: t })))),
          h('tbody', {}, rows),
        ])
        : h('p', { class: 'muted', text: 'групп нет — добавьте хотя бы одну' }),
    ]);
  }

