 *
 * Сокращения на экране короткие — иначе четыре поля не умещаются в строку
 * таблицы, — но что за ними стоит, из двух букв не выводится. Поэтому каждое
 * поле носит полное объяснение подсказкой, а над строкой стоит расшифровка:
 * порог, заданный не туда, — это либо ложная тревога каждый такт, либо
 * молчание при настоящей аварии.
 */
const LIMIT_FIELDS = [
  ['lo_alarm', 'НА', 'Нижняя авария: значение ниже — тревога. Самое низкое из четырёх'],
  ['lo_warning', 'НП', 'Нижнее предупреждение: значение ниже — предупреждение'],
  ['hi_warning', 'ВП', 'Верхнее предупреждение: значение выше — предупреждение'],
  ['hi_alarm', 'ВА', 'Верхняя авария: значение выше — тревога. Самое высокое из четырёх'],
