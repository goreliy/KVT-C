async function overview({ host, live }) {
  const [health, channels, devices, violations] = await Promise.all([
    api.health(), api.channels(), api.devices(), api.activeViolations(),
  ]);

  const unack = violations.filter((v) => !v.acknowledged).length;
  const bad = live.all().filter((t) => !t.good).length;

  host.append(
    h('h2', { text: 'Обзор объекта' }),
    h('div', { class: 'cards' }, [
      // Счётчик считает опрашиваемое, а таблица ниже показывает и
      // выключенное: без оговорки «1» над таблицей из двух строк читается
      // как потерянная линия.
      card('Каналов', channels.filter((c) => !isSwitchedOff(c)).length
        + (channels.some(isSwitchedOff)
          ? ` + ${channels.filter(isSwitchedOff).length} выкл.`
          : '')),
      card('Приборов', health.devices),
      card('Тегов', health.tags),
      card('Активных нарушений', violations.length),
      card('Неквитированных', unack),
      card('Недостоверных тегов', bad),
    ]),
  );

  // Выключенный имитатор ничего не имитирует: предупреждение о вымышленных
  // величинах на нём — такая же неправда, как его отсутствие в таблице.
  const simulatedChannels = channels.filter((c) => c.simulated && !isSwitchedOff(c));
  const liveChannels = channels.filter((c) => !isSwitchedOff(c));
  if (simulatedChannels.length) {
    host.append(h('p', { class: 'sim-banner' }, [
      h('strong', { text: 'Данные имитируются.' }),
      h('span', { text: simulatedChannels.length === liveChannels.length
        ? 'Все каналы объекта обслуживает встроенный имитатор: величины вымышлены и к оборудованию отношения не имеют.'
        : `Каналы ${simulatedChannels.map((c) => c.id).join(', ')} обслуживает встроенный имитатор.` }),
    ]));
  }

  host.append(h('h3', { text: 'Каналы' }));
  host.append(table(
    // Порт отдельным столбцом: вид транспорта не отвечает на вопрос «куда
    // подключено», а он возникает первым, когда линия молчит.
    ['Канал', 'Транспорт', 'Порт или адрес', 'Приборов', 'Состояние'],
    channels.map((c) => [
      c.id,
      c.simulated
        ? h('span', {}, [c.transport, ' ', h('span', { class: 'sim-tag', text: 'ИМИТАЦИЯ' })])
        : c.transport,
      h('span', { class: c.simulated ? 'muted mono' : 'mono', text: c.address || '—' }),
      c.devices,
      // Не «остановлен», а чем именно занят порт: «остановлен» одинаково
      // называло и невзятый порт, и выключенную линию, и молчащий прибор —
      // три разные причины с тремя разными действиями.
      h('span', {
        class: isSwitchedOff(c) ? 'state-off' : (c.running ? 'state-online' : 'state-offline'),
        text: c.port_state || (c.running ? 'работает' : 'состояние неизвестно'),
        title: c.last_error || '',
      }),
    ]),
  ));

  if (violations.length) {
    host.append(h('h3', { text: 'Активные нарушения' }));
    host.append(violationTable(violations, () => location.hash = '#/events'));
  }

  host.append(h('h3', { text: 'Приборы' }));
  host.append(table(
    ['Прибор', 'Канал', 'Тегов', 'Состояние'],
    devices.map((d) => [d.path, d.channel, d.tags, h('span', {
      class: isSwitchedOff(d) ? 'state-off' : '',
      text: d.state,
    })]),
  ));
}

function table(headers, rows) {
  return h('table', {}, [
    h('thead', {}, h('tr', {}, headers.map((t) => h('th', { text: t })))),
    h('tbody', {}, rows.map((cells) =>
      h('tr', {}, cells.map((c) => (c instanceof HTMLElement && c.tagName === 'TD') ? c : h('td', {}, [
        c instanceof Node ? c : document.createTextNode(String(c ?? '—')),
      ]))))),
  ]);
}

function violationTable(violations, onAck) {
  return table(
    ['Тег', 'Уровень', 'Приоритет', 'Начало', 'Значение', 'Пик', 'Порог', 'Квитировано'],
    violations.map((v) => [
      v.tag,
      h('span', { class: 'lvl lvl-' + levelClass(v.priority), text: v.level }),
      v.priority,
      timeText(v.started_at_us),
      v.value_at_start,
      v.peak_value,
      v.limit ?? '—',
      v.acknowledged
        ? h('span', { class: 'muted', text: v.acknowledged_by || 'да' })
        : (hasRole('operator')
          ? h('button', { text: 'квитировать', onclick: () => onAck(v) })
          : h('span', { class: 'muted', text: 'нет' })),
    ]),
  );
}

function levelClass(priority) {
  const p = String(priority || '').toLowerCase();
  if (p.includes('крит')) return 'critical';
  if (p.includes('трев') || p === 'alarm') return 'alarm';
  if (p.includes('предупр') || p === 'warning') return 'warning';
  return 'info';
}

