 * сотней строк её никто не увидит.
 */
function limitsLegend() {
  return h('div', { class: 'legend-line' }, [
    h('strong', { text: 'Пороги:' }),
    ...LIMIT_FIELDS.map(([, short, title]) => h('span', { class: 'legend-item', title }, [
      h('code', { text: short }),
      h('span', { text: ' — ' + title.split(':')[0].toLowerCase() }),
