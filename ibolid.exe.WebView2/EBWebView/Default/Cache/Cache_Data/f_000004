      // Сорок однотипных приборов по одному — сорок раз одна и та же форма.
      h('button', { text: 'добавить серию', title: 'несколько однотипных приборов подряд',
        onclick: () => addSeries(channel) }),
      h('button', { text: 'найти на линии', onclick: () => discoverOn(channel) }),
      // Выгрузка идёт из **сохранённой** настройки, а не из той, что правится
      // на экране: выгрузить несохранённое значит увезти на другой объект то,
      // чего на этом нет.
      h('button', { text: 'выгрузить линию',
        title: 'сохранить линию отдельным файлом для переноса на другой объект; '
             + 'выгружается сохранённая настройка',
        onclick: () => { window.location.href = api.configExportUrl(channel.id); } }),
      h('button', { class: 'danger', text: 'удалить канал', onclick: async () => {
        if (await confirmRemoval('канал', channel.id)) {
          doc.channels.splice(ci, 1);
          redraw();
        }
      } }),
    ]);

    const block = h('div', { class: 'cfg-block' }, [
      head,
      ...devices.map((d, di) => deviceBlock(channel, d, di)),
    ]);
    if (!enabled) block.classList.add('cfg-off');
    return block;
  }

  /**
   * Добавление серии однотипных приборов.
   *
   * На объекте это обычный случай: сорок датчиков одной модели с адресами
   * подряд. По одному их заводят сорок раз одной и той же формой, и на
   * тридцатом ошибаются в адресе.
   */
  async function addSeries(channel) {
    const profileSelect = h('select', {}, [
      h('option', { value: '', text: '— без профиля —' }),
      ...profileList.map((p) => h('option', {
        value: p.id, text: `${p.name} — регистров ${p.registers}`,
      })),
    ]);
    const fromInput = h('input', { type: 'number', min: 1, max: 247, value: String(nextUnit(channel)) });
    const toInput = h('input', { type: 'number', min: 1, max: 247, value: String(Math.min(247, nextUnit(channel) + 4)) });
    const prefixInput = h('input', { value: 'дат' });
    const preview = h('p', { class: 'muted' });

    const refresh = () => {
      const from = Number(fromInput.value);
      const to = Number(toInput.value);
      const taken = new Set((channel.devices || []).map((d) => d.unit_id));
      const free = [];
      const busy = [];
      for (let unit = from; unit <= to; unit += 1) {
        (taken.has(unit) ? busy : free).push(unit);
      }
      preview.textContent = from > to
        ? 'начальный адрес больше конечного'
        : `будет добавлено приборов: ${free.length}`
          + (busy.length ? `; адреса заняты и пропущены: ${busy.join(', ')}` : '');
      return { free, busy };
    };
    for (const input of [fromInput, toInput]) input.addEventListener('input', refresh);
    refresh();

    const done = await modal({
      title: `Добавить серию приборов на канал «${channel.id}»`,
      body: h('div', {}, [
        h('p', { class: 'muted', text:
          'Приборы получат имена «приставка-адрес» и один профиль. Занятые адреса '
          + 'пропускаются: два прибора с одним адресом отвечают одновременно, и линия не работает.' }),
        h('label', {}, ['приставка идентификатора', prefixInput]),
        h('label', {}, ['адрес с', fromInput]),
        h('label', {}, ['адрес по', toInput]),
        h('label', {}, ['профиль', profileSelect]),
        preview,
      ]),
      confirmText: 'Добавить',
      onConfirm: async () => {
        const { free } = refresh();
        if (!free.length) throw new Error('ни одного свободного адреса в заданном диапазоне');
        const prefix = prefixInput.value.trim() || 'прибор';
        const used = new Set((channel.devices || []).map((d) => d.id));
        const added = [];
        channel.devices = channel.devices || [];
        for (const unit of free) {
          let id = `${prefix}-${unit}`;
          // Идентификатор уникален по всему объекту, а не только по каналу:
          // столкновение обнаружилось бы отказом загрузки при запуске.
          while (used.has(id) || deviceIdTaken(id)) id = `${id}-2`;
          used.add(id);
          const device = { id, unit_id: unit };
          if (profileSelect.value) device.profile = profileSelect.value;
          channel.devices.push(device);
          added.push(id);
        }
        return added;
      },
    });
    if (!done) return;
    redraw();
    toast(`добавлено приборов: ${done.length}`, 'ok');
  }

  /** Идентификатор прибора занят где-либо на объекте. */
  function deviceIdTaken(id) {
    return (doc.channels || []).some((c) => (c.devices || []).some((d) => d.id === id));
  }

  function transportFields(channel) {
    const t = channel.transport || {};
    const set = (key) => (v) => { channel.transport = { ...channel.transport, [key]: v }; };
    switch (t.type) {
      case 'rtu':
        return [
          // Порт — главное поле последовательного канала, и вводить его
          // вслепую нельзя: опечатка в «COM3» обнаружится только отказом
          // открытия при запуске.
          field('порт', portPicker(t.path || '', set('path'), channel.id),
            'последовательный порт машины: COM3, /dev/ttyUSB0. Один порт — одна линия'),
          field('скорость', selectInput(
            [9600, 19200, 38400, 57600, 115200].map((b) => [String(b), String(b)]),
            String(t.baud ?? 9600),
            (v) => set('baud')(Number(v)),
          )),
          field('чётность', selectInput(
            [['none', 'нет'], ['even', 'чётная'], ['odd', 'нечётная']],
            t.parity || 'none', set('parity'),
          )),
          field('стоп-бит', selectInput([['1', '1'], ['2', '2']],
            String(t.stop_bits ?? 1), (v) => set('stop_bits')(Number(v)))),
        ];
      case 'rtu_over_tcp':
      case 'tcp':
        return [
          field('адрес', textInput(t.host || '127.0.0.1', set('host'))),
          field('порт', numberInput(t.port ?? 502, set('port')),
            'порт TCP, к которому подключаться. У Modbus TCP обычно 502'),
        ];
      case 'rtu_over_udp':
      case 'c2000_ethernet':
        return [
          field('адрес прибора', textInput(t.remote_host || '', set('remote_host'))),
          field('порт прибора', numberInput(t.remote_port ?? 40005, set('remote_port'))),
          field('свой адрес', textInput(t.local_host || '', set('local_host'))),
          field('свой порт', numberInput(t.local_port ?? 40005, set('local_port'))),
        ];
      case 'simulated':
        return [
          // Имитатор описывается перечнем адресов, которые он «обслуживает».
          field('адреса приборов', textInput((t.units || []).join(', '), (v) => {
            const units = v
              .split(/[^0-9]+/)
              .map((x) => Number(x))
              .filter((x) => Number.isInteger(x) && x >= 1 && x <= 247);
            set('units')(units);
          })),
          h('span', { class: 'lvl lvl-warning', text: 'величины вымышлены, это не измерение' }),
        ];
      default:
        return [];
    }
  }

  /**
   * Переопределение одного тега профиля.
   *
   * Запись в `tag_overrides` создаётся при первой правке и удаляется, когда в
   * ней не осталось ни одного отличия: иначе конфигурация распухает записями
   * «ничего не меняем», и разобрать, что на приборе действительно отличается,
   * становится нельзя.
   */
  function overrideOf(device, tag) {
    device.tag_overrides = device.tag_overrides || [];
    let found = device.tag_overrides.find((o) => o.tag === tag);
    if (!found) {
      found = { tag };
      device.tag_overrides.push(found);
    }
    return found;
  }

  /** Убирает переопределение, если в нём ничего не осталось. */
  function pruneOverride(device, tag) {
    const list = device.tag_overrides || [];
    const at = list.findIndex((o) => o.tag === tag);
    if (at < 0) return;
    const entry = list[at];
    const meaningful = Object.keys(entry).some((k) => {
      if (k === 'tag') return false;
      const v = entry[k];
      return !(v === undefined || v === null || v === '' || v === false
        || (k === 'limits' && !Object.keys(v || {}).length));
    });
    if (!meaningful) list.splice(at, 1);
    if (!list.length) delete device.tag_overrides;
  }

  /**
   * Регистры прибора, взятые из профиля.
   *
   * Профиль общий на все приборы своего типа, а нужное на конкретном приборе —
   * своё: из 174 регистров опрашивают пять, пороги ставят по месту, запись
   * разрешают одному тегу. Правкой профиля этого делать нельзя — она подействует
   * на все приборы объекта, — поэтому здесь правятся переопределения.
   */
  function profileRegistersBlock(channel, device) {
    if (!device.profile) return null;
    const box = h('details', { class: 'cfg-block' });
    // Не «загрузка…»: пока блок свёрнут, ничего не грузится, и подпись,
    // обещающая загрузку, читается как зависший запрос.
    const summary = h('summary', { text: `Регистры профиля «${device.profile}» — раскрыть` });
    box.append(summary);
    const body = h('div', {});
    box.append(body);

    // Карта запрашивается при первом раскрытии: у прибора их бывает полторы
    // сотни, и рисовать таблицу для каждого прибора заранее — уложить экран.
    let loadedMap = null;
    const ensure = async () => {
      if (loadedMap) return;
      summary.textContent = `Регистры профиля «${device.profile}» — загрузка…`;
      try {
        loadedMap = (await api.profileRegisters(device.profile)).registers || [];
      } catch (e) {
        summary.textContent = `Регистры профиля «${device.profile}» — не прочитаны`;
        body.replaceChildren(h('p', { class: 'warn-line', text:
          'Карта регистров профиля недоступна: ' + (e && e.message ? e.message : e)
          + '. Профиль не установлен либо служба запущена без каталога профилей.' }));
        return;
      }
      draw();
    };
    box.addEventListener('toggle', () => { if (box.open) ensure(); });

    const filter = h('input', { type: 'search', placeholder: 'фильтр по имени тега' });
    filter.addEventListener('input', () => draw());

    /**
     * Период группы регистра в миллисекундах.
     *
     * Старшинство то же, что у службы: группа прибора перекрывает группу тега,
     * группа тега — группу профиля, а одноимённая группа объекта перекрывает
     * профильную. Разойдись это правило со службой — редактор показывал бы
     * период, с которым опрос не пойдёт.
     */
    function periodOf(reg, over) {
      const name = device.poll_group || over.poll_group || reg.poll_group;
      if (!name) return undefined;
      const own = (doc.poll_groups || []).find((g) => g.id === name);
      if (own) return Number(own.period_ms);
      // Группы нет у объекта — значит она пришла из профиля.
      return reg.poll_group === name && reg.period_ms !== undefined
        ? Number(reg.period_ms) : undefined;
    }

    /** Будет ли регистр читаться регулярно. */
    function isPolled(reg, over) {
      if (over.disabled) return false;
      const period = periodOf(reg, over);
      return period !== undefined && period > 0;
    }

    function draw() {
      if (!loadedMap) return;
      const overrides = device.tag_overrides || [];
      const off = overrides.filter((o) => o.disabled).length;
      const changed = overrides.length - off;
      // Считается **опрос**, а не отсутствие галочки. Регистр в группе с
      // нулевым периодом включён, но не читается никогда: называть его
      // опрашиваемым значит противоречить состоянию канала, где написано
      // «опрос не задан», — и неправ будет этот экран, тот, по которому
      // настраивают.
      const polled = loadedMap.filter((r) =>
        isPolled(r, overrides.find((o) => o.tag === r.tag) || {})).length;
      const idle = loadedMap.length - off - polled;
      summary.textContent = `Регистры профиля «${device.profile}»: всего ${loadedMap.length}`
        + `, опрашивается ${polled}`
        + (idle ? `, включено без опроса ${idle}` : '')
        + (changed ? `, переопределений ${changed}` : '');

      const needle = filter.value.trim().toLowerCase();
      const shown = loadedMap.filter((r) => !needle || r.tag.toLowerCase().includes(needle)
        || (r.name || '').toLowerCase().includes(needle));

      const rows = shown.map((reg) => {
        const over = overrides.find((o) => o.tag === reg.tag) || {};
        const poll = h('select', {}, [
          h('option', { value: '', text: 'как в профиле' + (reg.poll_group ? ` (${reg.poll_group})` : '') }),
          ...(doc.poll_groups || []).map((g) => h('option', { value: g.id, text: `${g.id} — ${g.period_ms} мс` })),
        ]);
        poll.value = over.poll_group || '';
        poll.disabled = !!device.poll_group;
        poll.title = device.poll_group
          ? 'период задан для прибора целиком, группа тега не действует'
          : '';
        poll.addEventListener('change', () => {
          const o = overrideOf(device, reg.tag);
          o.poll_group = poll.value || undefined;
          pruneOverride(device, reg.tag);
          draw();
        });

        const polled = h('input', { type: 'checkbox' });
        polled.checked = !over.disabled;
        const period = periodOf(reg, over);
        // Отметка, поставленная на регистр из группы «только по запросу»,
        // ничего не включает. Сказать об этом надо здесь, а не оставлять
        // наладчику гадать, почему величина не появляется.
        polled.title = over.disabled
          ? 'поставить — опрашивать этот регистр на данном приборе'
          : period === 0
            ? `группа «${device.poll_group || over.poll_group || reg.poll_group}» задана `
              + 'с нулевым периодом — только по запросу. Отметка ничего не опрашивает: '
              + 'задайте группе период либо выберите другую группу'
            : period === undefined
              ? 'группа регистра не задана ни на объекте, ни в профиле — регистр не опрашивается'
              : 'снять — не опрашивать этот регистр на данном приборе';
        polled.addEventListener('change', () => {
          const o = overrideOf(device, reg.tag);
          o.disabled = polled.checked ? undefined : true;
          pruneOverride(device, reg.tag);
          draw();
        });

        const writable = h('input', { type: 'checkbox' });
        writable.checked = over.writable === undefined ? !!reg.writable : !!over.writable;
        writable.title = reg.writable
          ? 'профиль разрешает запись; снять — запретить на этом приборе'
          : 'профиль запись не разрешает; поставить — разрешить на этом приборе';
        writable.addEventListener('change', () => {
          const o = overrideOf(device, reg.tag);
          // Совпадение с профилем не хранится: запись «как в профиле»
          // засоряла бы конфигурацию и скрывала действительные отличия.
          o.writable = writable.checked === !!reg.writable ? undefined : writable.checked;
          pruneOverride(device, reg.tag);
          draw();
        });

        const num = (key, title, width = '62px') => {
          const input = h('input', {
            type: 'number', step: 'any', style: `width:${width}`, title, placeholder: title,
            value: over[key] === undefined ? '' : String(over[key]),
          });
          input.addEventListener('input', () => {
            const o = overrideOf(device, reg.tag);
            o[key] = input.value === '' ? undefined : Number(input.value);
            pruneOverride(device, reg.tag);
          });
          return input;
        };

        const limits = h('span', { class: 'toolbar', style: 'margin:0;gap:3px' });
        for (const [key, short, title] of LIMIT_FIELDS) {
          const input = h('input', {
            type: 'number', step: 'any', title, placeholder: short, style: 'width:56px',
            value: (over.limits && over.limits[key] !== undefined) ? String(over.limits[key]) : '',
          });
          input.addEventListener('input', () => {
            const o = overrideOf(device, reg.tag);
            o.limits = o.limits || {};
            if (input.value === '') delete o.limits[key];
            else o.limits[key] = Number(input.value);
            if (!Object.keys(o.limits).length) delete o.limits;
            pruneOverride(device, reg.tag);
          });
          limits.append(input);
        }

        const role = h('input', {
          style: 'width:90px', placeholder: 'роль', value: over.write_role || '',
          title: 'роль, без которой запись не допускается',
        });
        role.addEventListener('input', () => {
          const o = overrideOf(device, reg.tag);
          o.write_role = role.value.trim() || undefined;
          pruneOverride(device, reg.tag);
        });

        const units = h('input', {
          style: 'width:64px', placeholder: reg.units || 'ед.', value: over.units || '',
          title: 'единица измерения; пусто — как в профиле',
        });
        units.addEventListener('input', () => {
          const o = overrideOf(device, reg.tag);
          o.units = units.value.trim() || undefined;
          pruneOverride(device, reg.tag);
        });

        // Название на этом приборе: профиль даёт общее имя типа прибора, а на
        // объекте у величины своё — «Температура подачи» и «Температура
        // обратки» на двух одинаковых приборах.
        const titleInput = h('input', {
          style: 'width:150px', placeholder: reg.name || 'название', value: over.title || '',
          title: 'название величины на этом приборе; пусто — как в профиле',
        });
        titleInput.addEventListener('input', () => {
          const o = overrideOf(device, reg.tag);
          o.title = titleInput.value.trim() || undefined;
          pruneOverride(device, reg.tag);
        });

        const tr = h('tr', {}, [
          h('td', {}, polled),
          h('td', { class: 'mono', text: reg.tag, title: reg.name || '' }),
          h('td', {}, titleInput),
          h('td', { text: reg.area }),
          h('td', { class: 'num', text: String(reg.address) }),
          h('td', { text: reg.data_type || '' }),
          h('td', {}, poll),
          h('td', {}, writable),
          h('td', {}, num('write_min', 'мин')),
          h('td', {}, num('write_max', 'макс')),
          h('td', {}, role),
          h('td', {}, limits),
          h('td', {}, units),
          h('td', {}, num('deadband', 'зона', '58px')),
        ]);
        // Отключённый регистр виден не только снятой отметкой: строка гаснет,
        // иначе в таблице из 174 строк отличие не заметно. Включённый, но не
        // опрашиваемый гаснет так же: с точки зрения данных разницы нет,
        // величина не появится ни в том, ни в другом случае.
        if (!isPolled(reg, over)) tr.classList.add('cfg-off');
        return tr;
      });

      body.replaceChildren(
        h('p', { class: 'hint', text:
          'Профиль общий на все приборы своего типа. Всё, что нужно только этому '
          + 'прибору, задаётся здесь и попадает в «tag_overrides», а не в профиль: '
          + 'правка профиля подействовала бы на все приборы объекта.' }),
        h('div', { class: 'toolbar' }, [
          filter,
          h('span', { class: 'spacer' }),
          h('button', { class: 'small', text: 'опрашивать все', onclick: () => {
            for (const o of device.tag_overrides || []) delete o.disabled;
            for (const r of loadedMap) pruneOverride(device, r.tag);
            draw();
          } }),
          h('button', { class: 'small', text: 'не опрашивать ничего', title:
            'снять опрос со всех регистров профиля и включить нужные по одному',
            onclick: () => {
              for (const r of loadedMap) overrideOf(device, r.tag).disabled = true;
              draw();
            } }),
        ]),
        limitsLegend(),
        h('table', { class: 'cfg-regs' }, [
          h('thead', {}, h('tr', {}, headerCells(['Опрос', 'Тег', 'Название', 'Область',
            'Адрес', 'Тип', 'Группа', 'Запись', 'Мин', 'Макс', 'Роль', 'Пороги', 'Ед.', 'Зона']))),
          h('tbody', {}, rows),
        ]),
        shown.length === loadedMap.length ? null
          : h('p', { class: 'muted', text: `показано ${shown.length} из ${loadedMap.length}` }),
      );
    }

    return box;
  }

  function deviceBlock(channel, device, di) {
    const registers = device.registers || [];
    const enabled = device.enabled !== false;
    const head = h('div', { class: 'toolbar' }, [
      h('span', { text: 'Прибор' }),
      // Прибор, снятый на ремонт, отключают, а не удаляют: удаление уносит
      // пороги, переопределения и привязки на мнемосхемах, и после ремонта их
      // набирают заново.
      field('опрашивать', checkboxInput(enabled, (v) => {
        device.enabled = v ? undefined : false;
        redraw();
      })),
      field('идентификатор', textInput(device.id, (v) => { device.id = v; })),
      field('имя', textInput(device.name || '', (v) => { device.name = v || undefined; })),
      field('адрес на шине', numberInput(device.unit_id ?? 1, (v) => { device.unit_id = v; })),
      // Канал прибора меняется выбором: раньше ошибочно заведённый прибор
      // приходилось удалять и создавать заново на другой линии.
      field('канал', selectInput(
        (doc.channels || []).map((c) => [c.id, c.id]),
        channel.id,
        (v) => moveDevice(channel, di, v),
      )),
      // Порт линии рядом с прибором. Задаётся он у канала — порт один на всю
      // линию, и у прибора его быть не может, — но видеть, куда прибор
      // подключён, надо здесь: именно с этого начинают, когда он молчит.
      field('порт линии', h('span', {
        class: 'mono', style: 'align-self:center',
        title: 'задаётся у канала: порт один на всю линию',
        text: channelAddress(channel),
      })),
      field('профиль', profileNamePicker(device)),
      // Период опроса прибора целиком: у прибора с профилем регистров бывает
      // полторы сотни, и «опрашивать этот прибор реже» не должно превращаться
      // в полтораста переопределений.
      field('период опроса', selectInput(
        [['', 'как задано у регистров'],
          ...(doc.poll_groups || []).map((g) => [g.id, `${g.id} — ${g.period_ms} мс`])],
        device.poll_group || '',
        (v) => { device.poll_group = v || undefined; redraw(); },
      )),
      h('span', { class: 'spacer' }),
      h('button', { text: 'добавить регистр', onclick: () => {
        registers.push({
          tag: `${channel.id}.${device.id}.новый${registers.length + 1}`,
          poll_group: (doc.poll_groups && doc.poll_groups[0] && doc.poll_groups[0].id) || 'fast',
          area: 'input',
          address: 0,
        });
        device.registers = registers;
        redraw();
      } }),
      // Настроенный прибор превращается в шаблон одной операцией: следующий
      // такой же добавится одним выбором, а не набором карты регистров заново.
      registers.length
        ? h('button', { text: 'сохранить как шаблон', onclick: () => saveAsTemplate(channel, device) })
        : null,
      // Второй такой же прибор отличается только адресом на шине. Заводить его
      // формой заново — переписывать вручную то, что уже настроено.
      h('button', { text: 'копировать', title: 'такой же прибор со свободным адресом',
        onclick: () => copyDevice(channel, device) }),
      h('button', { class: 'danger', text: 'удалить прибор', onclick: async () => {
        if (await confirmRemoval('прибор', device.id)) {
          channel.devices.splice(di, 1);
          redraw();
        }
      } }),
    ]);

    // Поведение при отказах и опознавательный регистр — настройки, к которым
    // обращаются редко, но без которых чужой прибор не наладить. Свёрнуты,
    // чтобы не заслонять главное, и открыты, если отличаются от умолчаний.
    const tuning = deviceTuningBlock(device);

    const rows = registers.map((reg, ri) => h('tr', {}, [
      h('td', {}, textInput(reg.tag, (v) => { reg.tag = v; }, 'width:200px')),
      // Название рядом с именем: имя тега машинное и попадает в мнемосхемы и
      // правила, а название объясняет человеку, что это за величина.
      h('td', {}, textInput(reg.title || '', (v) => { reg.title = v || undefined; }, 'width:160px')),
      // Действующий период показывается рядом: при заданном периоде прибора
      // группа регистра не действует, и молчать об этом нельзя — инженер
      // менял бы группу и не понимал, почему период не меняется.
      h('td', {}, device.poll_group
        ? h('span', { class: 'muted', title: 'период задан для прибора целиком',
            text: `${device.poll_group} — ${periodOf(device.poll_group) ?? '?'} мс` })
        : selectInput(
          (doc.poll_groups || []).map((g) => [g.id, `${g.id} — ${g.period_ms} мс`]),
          reg.poll_group, (v) => { reg.poll_group = v; })),
      h('td', {}, selectInput(AREAS, reg.area || 'input', (v) => { reg.area = v; })),
      h('td', {}, numberInput(reg.address ?? 0, (v) => { reg.address = v; }, 'width:90px')),
      h('td', {}, selectInput(
        [['', 'по умолчанию'], ...DATA_TYPES.map((t) => [t, t])],
        reg.data_type || '', (v) => { reg.data_type = v || undefined; })),
      h('td', {}, checkboxInput(!!reg.writable, (v) => { reg.writable = v || undefined; redraw(); })),
      h('td', {}, limitsInput(reg)),
      h('td', {}, textInput(reg.units || '', (v) => { reg.units = v || undefined; }, 'width:56px')),
      // Подробности — в раскрывающейся строке: параметров декодирования девять,
      // в одну строку они не помещаются, а без них не завести ни битовый тег,
      // ни 32-разрядное число с обратным порядком слов.
      h('td', {}, h('button', {
        class: 'small', text: registerDetailsShown.has(reg) ? 'скрыть' : 'править',
        onclick: () => {
          if (registerDetailsShown.has(reg)) registerDetailsShown.delete(reg);
          else registerDetailsShown.add(reg);
          redraw();
        },
      })),
      h('td', {}, h('button', { class: 'danger', text: '×', title: 'удалить регистр', onclick: () => {
        registers.splice(ri, 1);
        registerDetailsShown.delete(reg);
        redraw();
      } })),
    ])).flatMap((tr, ri) => {
      const reg = registers[ri];
      if (!registerDetailsShown.has(reg)) return [tr];
      return [tr, h('tr', {}, h('td', { colspan: '11' }, registerDetails(reg)))];
    });

    const block = h('div', { class: 'cfg-device' }, [
      head,
      profileRegistersBlock(channel, device),
      registers.length
        ? h('div', {}, [
          limitsLegend(),
          h('table', { class: 'cfg-regs' }, [
            h('thead', {}, h('tr', {}, headerCells(['Тег', 'Название', 'Группа опроса', 'Область',
              'Адрес', 'Тип', 'Запись', 'Пороги', 'Ед.', 'Подробно', '']))),
            h('tbody', {}, rows),
          ]),
        ])
        : device.profile
          ? h('p', { class: 'muted', text:
              'своих регистров нет — прибор опрашивается по профилю. '
              + 'Кнопкой «добавить регистр» дополняют карту профиля своим адресом.' })
          : h('p', { class: 'muted', text: 'регистров нет' }),
      tuning,
    ]);
    // Отключённый прибор виден сразу: иначе «почему нет данных» разбирают на
    // линии, тогда как прибор просто снят с опроса.
    if (!enabled) block.classList.add('cfg-off');
    return block;
  }

  /**
   * Куда подключена линия — теми же словами, что на прочих экранах.
   *
   * Считается по конфигурации, а не берётся из состояния службы: экран
   * настройки правит файл, и показывать здесь работающую линию значило бы
   * показывать не то, что правится.
   */
  function channelAddress(channel) {
    const t = channel.transport || {};
    switch (t.type) {
      case 'rtu': {
        const parity = { none: 'N', even: 'E', odd: 'O' }[t.parity || 'none'] || 'N';
        return `${t.path || '— порт не выбран —'}, ${t.baud ?? 9600} ${t.data_bits ?? 8}${parity}${t.stop_bits ?? 1}`;
      }
      case 'tcp':
      case 'rtu_over_tcp':
        return `${t.host || '—'}:${t.port ?? 502}`;
      case 'rtu_over_udp':
      case 'c2000_ethernet':
        return `${t.remote_host || '—'}:${t.remote_port ?? 40005}`
          + ` ← свой порт ${t.local_port ?? 40005}`;
      case 'simulated':
        return 'имитатор — порта нет';
      default:
        return '—';
    }
  }

  /** Копия прибора со свободным адресом на шине. */
  function copyDevice(channel, device) {
    const copy = JSON.parse(JSON.stringify(device));
    const taken = new Set((channel.devices || []).map((d) => d.unit_id));
    let unit = device.unit_id;
    while (taken.has(unit) && unit < 247) unit += 1;
    copy.unit_id = unit;
    copy.id = freeDeviceId(channel, device.id);
    // Имена тегов несут имя прибора: без переписывания копия столкнулась бы с
    // исходником по именам тегов, и конфигурация не загрузилась бы.
    const from = `${channel.id}.${device.id}.`;
    const to = `${channel.id}.${copy.id}.`;
    for (const reg of copy.registers || []) {
      if (reg.tag.startsWith(from)) reg.tag = to + reg.tag.slice(from.length);
    }
    channel.devices.push(copy);
    redraw();
    toast(`добавлен «${copy.id}», адрес ${copy.unit_id}`, 'ok');
  }

  /** Свободный идентификатор вида «дат-12-2». */
  function freeDeviceId(channel, base) {
    const used = new Set((channel.devices || []).map((d) => d.id));
    for (let n = 2; n < 1000; n += 1) {
      const candidate = `${base}-${n}`;
      if (!used.has(candidate)) return candidate;
    }
    return `${base}-копия`;
  }

  /**
   * Поведение прибора при отказах и опознавательный регистр.
   *
   * Умолчания подобраны под приборы «Болид»; чужой прибор нередко требует
   * иного — больше повторов на длинной линии, реже пробы у медленного прибора,
   * другой опознавательный регистр. Без этих полей такой прибор настраивают
   * правкой файла, то есть в обход интерфейса.
   */
  function deviceTuningBlock(device) {
    const policy = device.policy || {};
    const probe = device.probe || {};
    const differs = Object.keys(policy).length > 0 || Object.keys(probe).length > 0;
    const box = h('details', { class: 'cfg-block', open: differs ? '' : undefined });
    box.append(h('summary', {
      text: differs ? 'Отказы и опознание — задано вручную' : 'Отказы и опознание — по умолчанию',
    }));

    const num = (label, key, fallback, title) => {
      const input = h('input', {
        type: 'number', step: 'any', style: 'width:90px', title,
        placeholder: String(fallback),
        value: policy[key] === undefined ? '' : String(policy[key]),
      });
      input.addEventListener('input', () => {
        device.policy = device.policy || {};
        if (input.value === '') delete device.policy[key];
        else device.policy[key] = Number(input.value);
        if (!Object.keys(device.policy).length) delete device.policy;
      });
      return field(label, input);
    };

    box.append(h('div', { class: 'toolbar' }, [
      num('повторов', 'max_retries', 2,
        'сколько раз повторить запрос до признания отказа'),
      num('до «сомнителен»', 'suspect_after_failures', 3,
        'отказов подряд, после которых прибор считается сомнительным'),
      num('до «недоступен»', 'offline_after_failures', 3,
        'ещё столько отказов — и прибор снимается с регулярного опроса'),
      num('успехов на возврат', 'recover_successes', 2,
        'успешных обменов подряд для полного восстановления'),
      num('вес прибора', 'weight', 1,
        'доля времени линии: медленному прибору дают больше, второстепенному меньше'),
    ]));
    box.append(h('div', { class: 'toolbar' }, [
      field('область опознания', selectInput(
        [['', 'по умолчанию (регистры ввода)'], ...AREAS],
        probe.area || '',
        (v) => {
          if (!v) { delete device.probe; redraw(); return; }
          device.probe = { area: v, address: (device.probe && device.probe.address) ?? 36864 };
        },
      )),
      field('адрес опознания', (() => {
        const input = h('input', {
          type: 'number', style: 'width:110px', placeholder: '36864',
          title: 'регистр, по которому проверяется живость прибора',
          value: probe.address === undefined ? '' : String(probe.address),
        });
        input.addEventListener('input', () => {
          if (input.value === '') { delete device.probe; return; }
          device.probe = {
            area: (device.probe && device.probe.area) || 'input',
            address: Number(input.value),
          };
        });
        return input;
      })()),
      h('span', { class: 'muted', text:
        'у приборов «Болид» — регистр ввода 36864; пусто означает его же' }),
    ]));
    return box;
  }

  /**
   * Подробности регистра: декодирование, запись, архив.
   *
   * Эти поля формат поддерживал с самого начала, а задать их можно было только
   * правкой файла — то есть в обход интерфейса. Без `bit` не завести тег на
   * бит регистра хранения, без `word_order` 32-разрядное число читается
   * мусором, без `write_min`/`write_max` запись уходит на прибор без проверки.
   */
  function registerDetails(reg) {
    const num = (label, key, placeholder, title, width = '86px') => {
      const input = h('input', {
        type: 'number', step: 'any', style: `width:${width}`, placeholder, title,
        value: reg[key] === undefined ? '' : String(reg[key]),
      });
      input.addEventListener('input', () => {
        if (input.value === '') delete reg[key];
        else reg[key] = Number(input.value);
      });
      return field(label, input);
    };

    const decoding = h('div', { class: 'toolbar' }, [
      h('span', { class: 'muted', text: 'декодирование:' }),
      num('регистров', 'quantity', 'по типу',
        'сколько регистров занимает величина; обычно выводится из типа'),
      num('бит', 'bit', '—',
        'номер бита в слове: 0…15. Нужен типам bit и для битовых полей'),
      num('длина', 'length', '—', 'длина строки в регистрах для типа ascii'),
      num('дробных бит', 'frac_bits', '—', 'для типа q8.8 и подобных'),
      // Значения — те же, что понимает формат конфигурации: `big_endian` и
      // `little_endian`. Короткие «big»/«little» разбор отвергает, и заданный
      // порядок слов молча не применялся бы — а 32-разрядное число с чужим
      // порядком читается мусором.
      field('порядок слов', selectInput(
        [['big_endian', 'старшее слово первым'], ['little_endian', 'младшее слово первым']],
        reg.word_order || 'big_endian',
        (v) => { reg.word_order = v === 'big_endian' ? undefined : v; },
      )),
      field('порядок байт', selectInput(
        [['big_endian', 'старший байт первым'], ['little_endian', 'младший байт первым']],
        reg.byte_order || 'big_endian',
        (v) => { reg.byte_order = v === 'big_endian' ? undefined : v; },
      )),
    ]);

    const writing = h('div', { class: 'toolbar' }, [
      h('span', { class: 'muted', text: 'запись:' }),
      num('не меньше', 'write_min', '—',
        'запись меньшей величины отвергается до выхода на шину'),
      num('не больше', 'write_max', '—',
        'запись большей величины отвергается до выхода на шину'),
      field('роль', textInput(reg.write_role || '',
        (v) => { reg.write_role = v.trim() || undefined; }, 'width:110px')),
      reg.writable
        ? null
        : h('span', { class: 'muted', text: 'запись не разрешена — эти поля не действуют' }),
    ]);

    const archive = h('div', { class: 'toolbar' }, [
      h('span', { class: 'muted', text: 'архив и качество:' }),
      num('зона нечувствительности', 'deadband', '—',
        'изменение меньше этой величины в архив не пишется'),
      num('устаревает через, мс', 'stale_after_ms', '—',
        'после этого срока без обновления значение считается устаревшим', '110px'),
    ]);

    return h('div', { class: 'cfg-details' }, [decoding, writing, archive]);
  }

  function limitsInput(reg) {
    const wrap = h('div', { class: 'toolbar', style: 'margin:0;gap:4px' });
    for (const [key, short, title] of LIMIT_FIELDS) {
      const input = h('input', {
        type: 'number', step: 'any', title, placeholder: short, style: 'width:62px',
        value: (reg.limits && reg.limits[key] !== undefined) ? String(reg.limits[key]) : '',
      });
      input.addEventListener('input', () => {
        reg.limits = reg.limits || {};
        if (input.value === '') delete reg.limits[key];
        else reg.limits[key] = Number(input.value);
        if (!Object.keys(reg.limits).length) delete reg.limits;
      });
      wrap.append(input);
    }
    return wrap;
  }

  /**
   * Выбор последовательного порта.
   *
   * Список — настоящие порты машины с указанием, что за устройство и занят ли
   * порт. Ввод имени руками остаётся: порт может появиться позже (сервер и
   * преобразователь USB — разные машины при удалённой настройке), и запретить
   * это значило бы сделать настройку невозможной.
   */
  function portPicker(value, onchange, ownChannel) {
    const select = h('select', { style: 'min-width:220px' });
    const manual = h('input', {
      value, placeholder: 'имя порта', style: 'width:120px', hidden: 'hidden',
    });

    function fill() {
      const options = [h('option', { value: '', text: '— не выбран —' })];
      for (const p of ports) {
        // Порт, занятый **другим** каналом, помечается: назначить его второму
        // каналу можно, но второй канал просто не поднимется.
        const taken = p.used_by && p.used_by !== ownChannel ? ` — занят каналом «${p.used_by}»` : '';
        const busy = p.busy && !p.used_by ? ' — занят другой программой' : '';
        const what = p.description ? ` (${p.description})` : '';
        options.push(h('option', {
          value: p.name,
          text: `${p.name} — ${p.kind}${what}${taken}${busy}`,
        }));
      }
      // Имя из конфигурации, которого в системе нет, показывается отдельно:
      // молча подставить пустое значение — потерять настройку.
      if (value && !ports.some((p) => p.name === value)) {
        options.push(h('option', { value, text: `${value} — в системе не найден` }));
      }
      options.push(h('option', { value: '__manual__', text: 'ввести имя вручную…' }));
      select.replaceChildren(...options);
      select.value = value || '';
    }
    fill();

    select.addEventListener('change', () => {
      if (select.value === '__manual__') {
        manual.hidden = false;
        manual.focus();
        return;
      }
      manual.hidden = true;
      onchange(select.value);
    });
    manual.addEventListener('input', () => onchange(manual.value.trim()));

    const refresh = h('button', {
      text: '⟳', title: 'обновить перечень портов',
      style: 'padding:4px 8px',
      onclick: async () => { await reloadPorts(); redraw(); },
    });

    return h('span', { class: 'toolbar', style: 'margin:0;gap:4px' }, [select, manual, refresh]);
  }

  function addChannel() {
    doc.channels = doc.channels || [];
    doc.channels.push({
      id: 'line' + (doc.channels.length + 1),
      transport: { type: 'rtu_over_tcp', host: '127.0.0.1', port: 5020 },
      request_timeout_ms: 500,
      devices: [],
    });
    redraw();
  }

  /**
   * Добавление прибора.
   *
   * Главное здесь — **профиль**: он несёт готовую карту регистров, и вписывать
   * полсотни адресов руками не нужно. Профиль выбирается из перечня
   * установленных, а не вводится по памяти: опечатка в идентификаторе
   * обнаружилась бы только при следующем запуске службы.
   */
  async function addDevice(channel, preset = {}) {
    const profiles = profileList;

    const idInput = h('input', { value: preset.id || suggestDeviceId(channel) });
    const nameInput = h('input', { value: preset.name || '' });
    const unitInput = h('input', { type: 'number', min: 1, max: 247, value: String(preset.unit_id ?? nextUnit(channel)) });
    const profileSelect = h('select', {}, [
      h('option', { value: '', text: '— без профиля, регистры задам сам —' }),
      ...profiles.map((p) => h('option', {
        value: p.id,
        // Перекрытие называется прямо в перечне: выбирая профиль по имени из
        // поставки, инженер должен видеть, что действует не поставочная карта.
        text: `${p.name} — регистров ${p.registers}`
          + (p.writable ? `, из них на запись ${p.writable}` : '')
          + (p.overrides_bundled ? ' [свой, перекрывает поставочный]'
            : p.editable ? ' [свой]' : ''),
      })),
    ]);
    if (preset.profile) profileSelect.value = preset.profile;

    const preview = h('div', { class: 'muted', style: 'max-height:220px;overflow:auto' });

    async function showPreview() {
      const id = profileSelect.value;
      if (!id) {
        preview.replaceChildren(h('p', { class: 'muted', text:
          'Без профиля прибор добавится пустым, и регистры надо будет задать вручную.' }));
        return;
      }
      preview.replaceChildren(h('p', { class: 'muted', text: 'загрузка карты регистров…' }));
      try {
        const r = await api.profileRegisters(id);
        const rows = r.registers.slice(0, 200).map((reg) => h('tr', {}, [
          h('td', { class: 'mono', text: reg.tag }),
          h('td', { text: reg.name || '' }),
          h('td', { text: reg.area }),
          h('td', { class: 'num', text: String(reg.address) }),
          h('td', { text: reg.data_type || '' }),
          h('td', { text: reg.writable ? 'запись' : '' }),
        ]));
        preview.replaceChildren(...[
          h('p', { class: 'muted', text:
            `Будет добавлено регистров: ${r.registers.length}. `
            + 'Имена тегов получат приставку «канал.прибор».' }),
          h('table', { class: 'cfg-regs' }, [
            h('thead', {}, h('tr', {}, ['Тег', 'Название', 'Область', 'Адрес', 'Тип', ''].map((t) => h('th', { text: t })))),
            h('tbody', {}, rows),
          ]),
          r.registers.length > 200
            ? h('p', { class: 'muted', text: `…показаны первые 200 из ${r.registers.length}` })
            : null,
        ].filter(Boolean));
      } catch (e) {
        preview.replaceChildren(h('p', { class: 'error', text: 'карта регистров не получена: ' + e.message }));
      }
    }
    profileSelect.addEventListener('change', showPreview);

    const body = h('div', {}, [
      h('label', {}, ['идентификатор прибора', idInput]),
      h('label', {}, ['название', nameInput]),
      h('label', {}, ['адрес на шине (1…247)', unitInput]),
      h('label', {}, ['профиль', profileSelect]),
      h('h3', { text: 'Карта регистров' }),
      preview,
    ]);
    showPreview();

    const done = await modal({
      title: `Новый прибор на канале «${channel.id}»`,
      body,
      confirmText: 'Добавить',
      onConfirm: async () => {
        const id = idInput.value.trim();
        if (!id) throw new Error('идентификатор не может быть пустым');
        const unit = Number(unitInput.value);
        if (!Number.isInteger(unit) || unit < 1 || unit > 247) {
          throw new Error('адрес на шине задаётся числом 1…247');
        }
        // Совпадение адресов на одной линии — не опечатка, а неработающий
        // объект: два прибора с одним адресом отвечают одновременно.
        if ((channel.devices || []).some((d) => d.unit_id === unit)) {
          throw new Error(`адрес ${unit} на этой линии уже занят`);
        }
        if ((doc.channels || []).some((c) => (c.devices || []).some((d) => d.id === id))) {
          throw new Error(`прибор с идентификатором «${id}» уже есть`);
        }
        return { id, unit, profile: profileSelect.value, name: nameInput.value.trim() };
      },
    });
    if (!done) return;

    const device = { id: done.id, unit_id: done.unit };
    if (done.name) device.name = done.name;
    if (done.profile) {
      // С профилем регистры не переписываются в конфигурацию: она **ссылается**
      // на профиль. Скопировать их значило бы потерять связь с профилем, и
      // исправление карты регистров пришлось бы разносить по всем приборам.
      device.profile = done.profile;
    } else {
      device.registers = [];
    }
    channel.devices = channel.devices || [];
    channel.devices.push(device);
    redraw();
    toast(done.profile
      ? `прибор «${done.id}» добавлен по профилю`
      : `прибор «${done.id}» добавлен, задайте регистры`, 'ok');
  }

  /**
   * Перенос прибора на другой канал.
   *
   * Имена тегов, объявленных прямо у прибора, начинаются с имени канала, и
   * при переносе их надо переписать: иначе тег `line1.dev5.state` остался бы
   * на канале `line2`, и по имени стало бы непонятно, где прибор находится.
   */
  function moveDevice(from, index, toChannelId) {
    if (from.id === toChannelId) return;
    const to = (doc.channels || []).find((c) => c.id === toChannelId);
    if (!to) return;
    const device = from.devices[index];

    if ((to.devices || []).some((d) => d.unit_id === device.unit_id)) {
      toast(`на канале «${toChannelId}» адрес ${device.unit_id} уже занят`, 'err');
      redraw();
      return;
    }

    const oldPrefix = `${from.id}.${device.id}.`;
    const newPrefix = `${toChannelId}.${device.id}.`;
    for (const reg of device.registers || []) {
      if (reg.tag.startsWith(oldPrefix)) {
        reg.tag = newPrefix + reg.tag.slice(oldPrefix.length);
      }
    }

    from.devices.splice(index, 1);
    to.devices = to.devices || [];
    to.devices.push(device);
    redraw();
    toast(`прибор «${device.id}» перенесён на канал «${toChannelId}»`, 'ok');
  }

  /** Выбор профиля у существующего прибора. */
  function profileNamePicker(device) {
    const select = h('select', {}, [
      h('option', { value: '', text: '— без профиля —' }),
      ...profileList.map((p) => h('option', {
        value: p.id,
        text: `${p.name} (${p.registers})`
          + (p.overrides_bundled ? ' — свой, перекрывает поставочный' : p.editable ? ' — свой' : ''),
      })),
    ]);
    if (device.profile && !profileList.some((p) => p.id === device.profile)) {
      // Профиль из конфигурации, которого нет в поставке: показывается как
      // есть, иначе сохранение молча потеряло бы ссылку.
      select.append(h('option', { value: device.profile, text: `${device.profile} — не установлен` }));
    }
    select.value = device.profile || '';
    select.addEventListener('change', () => {
      device.profile = select.value || undefined;
      redraw();
    });
    return select;
  }

  /** Сохранение прибора шаблоном — пользовательским профилем (ТЗ 8.2). */
  async function saveAsTemplate(channel, device) {
    const registers = device.registers || [];
    const prefix = `${channel.id}.${device.id}.`;
    const suggestedId = 'свой.' + (device.id || 'прибор')
      .toLowerCase()
      .replace(/[^a-zа-я0-9-]+/gi, '-')
      .replace(/^-+|-+$/g, '');

    const idInput = h('input', { value: suggestedId });
    const nameInput = h('input', { value: device.name || device.id });
    const vendorInput = h('input', { value: '' });
    const descInput = h('input', { value: '' });

    const preview = h('table', { class: 'cfg-regs' }, [
      h('thead', {}, h('tr', {}, ['Тег в шаблоне', 'Область', 'Адрес', 'Тип', 'Запись']
        .map((t) => h('th', { text: t })))),
      h('tbody', {}, registers.slice(0, 100).map((r) => h('tr', {}, [
        // Приставка «канал.прибор.» снимается: с ней шаблон был бы применим
        // к одному прибору на одном канале, то есть бесполезен.
        h('td', { class: 'mono', text: r.tag.startsWith(prefix) ? r.tag.slice(prefix.length) : r.tag }),
        h('td', { text: r.area || 'input' }),
        h('td', { class: 'num', text: String(r.address ?? 0) }),
        h('td', { text: r.data_type || '' }),
        h('td', { text: r.writable ? 'да' : '' }),
      ]))),
    ]);

    const body = h('div', {}, [
      h('p', { class: 'muted', text:
        `Шаблон соберётся из ${registers.length} регистров прибора. Приставка «${prefix}» `
        + 'снимается: её подставит конфигурация того прибора, к которому шаблон применят.' }),
      h('label', {}, ['идентификатор шаблона', idInput]),
      h('label', {}, ['название', nameInput]),
      h('label', {}, ['изготовитель', vendorInput]),
      h('label', {}, ['описание', descInput]),
      h('h3', { text: 'Что войдёт в шаблон' }),
      preview,
      registers.length > 100
        ? h('p', { class: 'muted', text: `…показаны первые 100 из ${registers.length}` })
        : null,
    ]);

    const request = (overrideBundled) => ({
      id: idInput.value.trim(),
      name: nameInput.value.trim(),
      vendor: vendorInput.value.trim(),
      description: descInput.value.trim(),
      strip_prefix: prefix,
      override_bundled: overrideBundled,
      registers: registers.map((r) => ({
        tag: r.tag,
        name: r.name || '',
        area: r.area || 'input',
        address: r.address ?? 0,
        data_type: r.data_type || null,
        poll_group: r.poll_group || null,
        writable: !!r.writable,
        units: r.units || '',
        limits: r.limits || null,
      })),
    });

    const saved = await modal({
      title: 'Сохранить прибор как шаблон',
      body,
      confirmText: 'Сохранить шаблон',
      onConfirm: async () => {
        if (!idInput.value.trim()) throw new Error('идентификатор шаблона не может быть пустым');
        try {
          return await api.saveProfile(request(false));
        } catch (e) {
          // Имя занято профилем комплекта поставки. Перекрытие — законный
          // способ поправить карту регистров на объекте, но оно действует на
          // все приборы, и спросить об этом обязательно: прибор с четырьмя
          // регистрами вместо ста семидесяти четырёх выглядит неисправным, а
          // не подменённым, и искать будут прибор.
          if (e && e.code === 'PROFILE_WOULD_OVERRIDE') {
            const confirmed = await modal({
              title: 'Перекрыть профиль комплекта поставки?',
              body: h('div', {}, [
                h('p', { class: 'warn-line', text: e.message }),
                h('p', {}, [
                  'Файл поставки останется на диске, но все приборы объекта, ссылающиеся на ',
                  h('span', { class: 'mono', text: idInput.value.trim() }),
                  ', начнут работать по этой карте регистров.',
                ]),
                h('p', { class: 'muted', text:
                  'Перекрытие снимается удалением сохранённого шаблона: поставочный профиль '
                  + 'вернётся в силу.' }),
              ]),
              confirmText: 'Перекрыть',
              cancelText: 'Выбрать другое имя',
              onConfirm: async () => true,
            });
            if (!confirmed) throw new Error('имя оставлено занятым: шаблон не сохранён');
            return api.saveProfile(request(true));
          }
          throw e;
        }
      },
    });
    if (!saved) return;

    profileList = (await api.profiles().catch(() => ({ items: profileList }))).items || profileList;
    toast(`шаблон «${saved.name}» сохранён: регистров ${saved.registers}`
      + (saved.overrides_bundled ? ' — перекрывает поставочный' : ''), 'ok');

    // Предложение перевести прибор на свежий шаблон: иначе у объекта окажется
    // и шаблон, и его дословная копия в конфигурации, и расходиться они
    // начнут при первой же правке.
    const switchOver = await modal({
      title: 'Перевести прибор на шаблон?',
      body: h('div', {}, [
        h('p', {}, [
          'Регистры прибора можно заменить ссылкой на шаблон ',
          h('span', { class: 'mono', text: saved.id }),
          '. Тогда правка карты регистров в шаблоне будет действовать на все приборы, ',
          'а не на один.',
        ]),
        h('p', { class: 'muted', text:
          'Если оставить как есть, у объекта будут и шаблон, и его копия в конфигурации.' }),
      ]),
      confirmText: 'Перевести на шаблон',
      cancelText: 'Оставить как есть',
      onConfirm: async () => true,
    });
    if (switchOver) {
      device.profile = saved.id;
      delete device.registers;
      redraw();
      toast(`прибор «${device.id}» переведён на шаблон`, 'ok');
    } else {
      redraw();
    }
  }

  function suggestDeviceId(channel) {
    const used = new Set((channel.devices || []).map((d) => d.id));
    for (let i = 1; i < 1000; i++) {
      const id = 'dev' + i;
      if (!used.has(id)) return id;
    }
    return 'dev';
  }

  function nextUnit(channel) {
    const used = new Set((channel.devices || []).map((d) => d.unit_id));
    for (let i = 1; i <= 247; i++) if (!used.has(i)) return i;
    return 1;
  }

  /**
   * Поиск приборов на линии (раздел 7.3).
   *
   * Опрос на время поиска останавливается: линия полудуплексная, и держать
   * два запроса в полёте нельзя. Поэтому диапазон по умолчанию небольшой —
   * перебор всех 247 адресов с таймаутом занял бы минуты простоя.
   */
  async function discoverOn(channel) {
    const from = h('input', { type: 'number', min: 1, max: 247, value: '1', style: 'width:90px' });
    const to = h('input', { type: 'number', min: 1, max: 247, value: '16', style: 'width:90px' });
    const probe = h('input', { type: 'number', value: '36864', style: 'width:120px' });
    const result = h('div');

    const body = h('div', {}, [
      h('p', { class: 'muted', text:
        'Поиск занимает линию: на это время опрос приостанавливается. '
        + 'Просматриваются адреса подряд, каждый с таймаутом.' }),
      h('div', { class: 'toolbar' }, [
        h('label', { class: 'cfg-field' }, [h('span', { text: 'адреса с' }), from]),
        h('label', { class: 'cfg-field' }, [h('span', { text: 'по' }), to]),
        h('label', { class: 'cfg-field' }, [h('span', { text: 'опознавательный регистр' }), probe]),
      ]),
      result,
    ]);

    await modal({
      title: `Поиск приборов на канале «${channel.id}»`,
      body,
      confirmText: 'Искать',
      cancelText: 'Закрыть',
      closeOnConfirm: false,
      onConfirm: async () => {
        result.replaceChildren(h('p', { class: 'muted', text: 'идёт поиск…' }));
        const r = await api.discover(channel.id, Number(from.value), Number(to.value), Number(probe.value));
        const answered = r.found.filter((d) => d.answered);
        result.replaceChildren(
          h('p', {}, [
            `просмотрено адресов ${r.scanned}, ответили ${answered.length}`,
          ]),
          answered.length
            ? h('table', {}, [
              h('thead', {}, h('tr', {}, ['Адрес', 'Опозн. регистр', 'Профиль', 'Состояние', ''].map((t) => h('th', { text: t })))),
              h('tbody', {}, answered.map((d) => h('tr', {}, [
                h('td', { class: 'num', text: String(d.unit_id) }),
                h('td', { class: 'num', text: d.probe_value === null || d.probe_value === undefined ? '—' : String(d.probe_value) }),
                // Прибор ответил, но профиль не опознан — это не повод молчать:
                // наладчик выберет профиль сам либо заведёт прибор без него.
                h('td', { text: d.profiles.length ? d.profiles.join(', ') : 'не опознан' }),
                h('td', { text: d.known ? 'уже в конфигурации' : d.outcome }),
                h('td', {}, d.known ? null : h('button', {
                  text: 'добавить',
                  onclick: async () => {
                    await addDevice(channel, {
                      unit_id: d.unit_id,
                      profile: d.profiles[0] || '',
                      id: 'dev' + d.unit_id,
                    });
                  },
                })),
              ]))),
            ])
            : h('p', { class: 'muted', text:
              'ни один адрес не ответил. Проверьте линию, скорость обмена и диапазон адресов.' }),
        );
        return true;
      },
    });
  }

  async function confirmRemoval(kind, id) {
    return !!(await modal({
      title: `Удаление: ${kind}`,
      body: h('p', {}, [`Удалить ${kind} `, h('span', { class: 'mono', text: id }),
        '? Изменение вступит в силу после сохранения и перезапуска.']),
      confirmText: 'Удалить',
      danger: true,
      onConfirm: async () => true,
    }));
  }

  async function check() {
    try {
      const r = await api.checkConfig(JSON.stringify(doc, null, 2));
      showCheck(r);
      return r;
    } catch (e) { reportError(e); return null; }
  }

  function showCheck(r) {
    status.replaceChildren();
    if (r.ok) {
      status.append(h('span', { class: 'state-online', text:
        `годна: каналов ${r.channels}, приборов ${r.devices}, тегов ${r.tags}` }));
    } else {
      status.append(h('span', { class: 'error', text: 'ошибки: ' + r.errors.join('; ') }));
    }
    for (const w of r.warnings || []) {
      status.append(h('div', { class: 'muted', text: 'замечание: ' + w }));
    }
  }

  async function save() {
    const text = JSON.stringify(doc, null, 2);
    try {
      const r = await api.saveConfig(text);
      showCheck(r);
      // «Перезапустите службу» без способа это сделать — тупик: у инженера на
      // объекте нет ни консоли, ни прав на диспетчер служб.
      toast('конфигурация сохранена; чтобы применить — экран «Служба» → перезапустить', 'ok');
    } catch (e) { reportError(e); }
  }

  /// Правка текстом — на случай полей, которых нет в формах.
  async function editRaw() {
    const area = h('textarea', { rows: 24, style: 'width:100%;font-family:var(--mono);font-size:12px' });
    area.value = JSON.stringify(doc, null, 2);
    const done = await modal({
      title: 'Конфигурация текстом',
      body: h('div', {}, [
        h('p', { class: 'muted', text: 'Проверяется тем же кодом, что и запуск службы.' }),
        area,
      ]),
      confirmText: 'Принять',
      onConfirm: async () => {
        let parsed;
        try { parsed = JSON.parse(area.value); }
        catch (e) { throw new Error('не разбирается как JSON: ' + e.message); }
        const r = await api.checkConfig(JSON.stringify(parsed, null, 2));
        if (!r.ok) throw new Error(r.errors.join('; '));
        doc = parsed;
        return r;
      },
    });
    if (done) { redraw(); showCheck(done); toast('изменения приняты, не забудьте сохранить', 'ok'); }
  }

  redraw();
  showCheck(loaded.check);
}

// ── Учётные записи (раздел 15.1) ────────────────────────────────────

const ROLES = [
  ['viewer', 'наблюдатель — только просмотр'],
  ['operator', 'оператор — квитирование и команды'],
  ['engineer', 'инженер — настройка и журнал обменов'],
  ['admin', 'администратор — всё, включая учётные записи'],
];

const roleName = (role) => (ROLES.find(([id]) => id === role) || [role, role])[1].split(' — ')[0];

/**
 * Администрирование учётных записей.
 *
 * Экран доступен администратору. Два правила закреплены и на сервере, и здесь:
 * нельзя удалить последнего администратора и нельзя удалить самого себя —
 * система, оставшаяся без администратора, изнутри не восстанавливается.
 */
async function users({ host, toast, reportError, hasRole }) {
  if (!hasRole('admin')) {
    host.append(h('p', { class: 'empty', text: 'управление учётными записями доступно администратору' }));
    // Свой пароль сменить может любой вошедший — это не администрирование.
    host.append(h('div', { class: 'toolbar' }, [
      h('button', { text: 'сменить свой пароль', onclick: () => changeOwnPassword(toast, reportError) }),
    ]));
    return;
  }

  const list = h('div');
  host.append(
    h('div', { class: 'toolbar' }, [
      h('h2', { text: 'Учётные записи', style: 'margin:0' }),
      h('span', { class: 'spacer' }),
      h('button', { text: 'сменить свой пароль', onclick: () => changeOwnPassword(toast, reportError) }),
      h('button', { class: 'primary', text: 'создать', onclick: create }),
    ]),
    list,
  );

  async function refresh() {
    const r = await api.users();
    list.replaceChildren(
      table(
        ['Имя', 'Роль', 'Состояние', ''],
        r.users.map((u) => [
          h('span', { class: 'mono', text: u.login + (u.login === r.me ? ' (это вы)' : '') }),
          roleSelect(u, r),
          userState(u),
          h('div', { class: 'toolbar', style: 'margin:0' }, [
            h('button', { text: 'задать пароль', onclick: () => setPassword(u) }),
            u.locked ? h('button', { text: 'снять блокировку', onclick: () => unlock(u) }) : null,
            deleteButton(u, r),
          ]),
        ]),
      ),
      h('p', { class: 'muted', text:
        'Учётные записи хранятся в каталоге данных, свёртками argon2id. '
        + 'Открытый пароль не сохраняется нигде и не попадает в журналы.' }),
    );
  }

  function roleSelect(user, all) {
    const select = h('select', {}, ROLES.map(([id, text]) => h('option', { value: id, text })));
    select.value = user.role;
    // Последнего администратора нельзя понизить: это правило сервера, и
    // показать его надо до нажатия, а не после отказа.
    const lastAdmin = user.role === 'admin' && all.admins <= 1;
    if (lastAdmin) {
      select.disabled = true;
      select.title = 'последний администратор — понижение оставит систему без администратора';
    }
    select.addEventListener('change', async () => {
      try {
        await api.setUserRole(user.login, select.value);
        toast(`роль «${user.login}» изменена`, 'ok');
        await refresh();
      } catch (e) { reportError(e); select.value = user.role; }
    });
    return select;
  }

  function userState(user) {
    const parts = [];
    if (user.locked) parts.push(h('span', { class: 'lvl lvl-alarm', text: 'заблокирована' }));
    if (user.must_change_password) parts.push(h('span', { class: 'lvl lvl-warning', text: 'пароль требует смены' }));
    if (user.failed_attempts) parts.push(h('span', { class: 'muted', text: `неудачных попыток: ${user.failed_attempts}` }));
    if (!parts.length) parts.push(h('span', { class: 'muted', text: 'в порядке' }));
    return h('div', {}, parts);
  }

  function deleteButton(user, all) {
    const self = user.login === all.me;
    const lastAdmin = user.role === 'admin' && all.admins <= 1;
    const button = h('button', { class: 'danger', text: 'удалить' });
    if (self) { button.disabled = true; button.title = 'нельзя удалить запись, под которой работаешь'; }
    else if (lastAdmin) { button.disabled = true; button.title = 'последний администратор'; }
    else button.addEventListener('click', () => remove(user));
    return button;
  }

  async function create() {
    const login = h('input', { autocomplete: 'off' });
    const pass = h('input', { type: 'password', autocomplete: 'new-password' });
    const role = h('select', {}, ROLES.map(([id, text]) => h('option', { value: id, text })));
    role.value = 'operator';
    const body = h('div', {}, [
      h('label', {}, ['имя пользователя', login]),
      h('label', {}, ['пароль', pass]),
      h('label', {}, ['роль', role]),
    ]);
    const done = await modal({
      title: 'Новая учётная запись', body, confirmText: 'Создать',
      onConfirm: async () => {
        if (!login.value.trim()) throw new Error('имя пользователя не может быть пустым');
        await api.createUser(login.value.trim(), pass.value, role.value);
        return true;
      },
    });
    if (done) { toast('учётная запись создана', 'ok'); await refresh(); }
  }

  async function setPassword(user) {
    const pass = h('input', { type: 'password', autocomplete: 'new-password' });
    const again = h('input', { type: 'password', autocomplete: 'new-password' });
    const body = h('div', {}, [
      h('p', { class: 'mono', text: user.login }),
      h('p', { class: 'muted', text:
        'Назначенный пароль помечается требующим смены: вы его знаете, '
        + 'и до смены владельцем запись не является личной.' }),
      h('label', {}, ['новый пароль', pass]),
      h('label', {}, ['ещё раз', again]),
    ]);
    const done = await modal({
      title: 'Назначение пароля', body, confirmText: 'Задать', danger: true,
      onConfirm: async () => {
        if (pass.value !== again.value) throw new Error('пароли не совпадают');
        await api.resetPassword(user.login, pass.value);
        return true;
      },
    });
    if (done) { toast(`пароль «${user.login}» назначен`, 'ok'); await refresh(); }
  }

  async function unlock(user) {
    try {
      await api.unlockUser(user.login);
      toast(`блокировка «${user.login}» снята`, 'ok');
      await refresh();
    } catch (e) { reportError(e); }
  }

  async function remove(user) {
    const body = h('div', {}, [
      h('p', {}, [`Удалить учётную запись `, h('span', { class: 'mono', text: user.login }), '?']),
      h('p', { class: 'muted', text: 'Открытые сеансы этого пользователя закроются немедленно.' }),
    ]);
    const done = await modal({
      title: 'Удаление учётной записи', body, confirmText: 'Удалить', danger: true,
      onConfirm: async () => { await api.deleteUser(user.login); return true; },
    });
    if (done) { toast(`удалена: ${user.login}`, 'ok'); await refresh(); }
  }

  await refresh();
}

/** Смена собственного пароля (FR-765.5). Доступна любому вошедшему. */
async function changeOwnPassword(toast, reportError) {
  const current = h('input', { type: 'password', autocomplete: 'current-password' });
  const next = h('input', { type: 'password', autocomplete: 'new-password' });
  const again = h('input', { type: 'password', autocomplete: 'new-password' });
  const body = h('div', {}, [
    h('label', {}, ['текущий пароль', current]),
    h('label', {}, ['новый пароль', next]),
    h('label', {}, ['новый пароль ещё раз', again]),
  ]);
  try {
    const done = await modal({
      title: 'Смена пароля', body, confirmText: 'Сменить',
      onConfirm: async () => {
        if (next.value !== again.value) throw new Error('новые пароли не совпадают');
        await api.changeOwnPassword(current.value, next.value);
        return true;
      },
    });
    if (done) toast('пароль сменён', 'ok');
  } catch (e) { reportError(e); }
}

// ── Мнемосхемы ──────────────────────────────────────────────────────

/**
 * Хранилище схем.
 *
 * Схемы принадлежат **объекту** и лежат на сервере: нарисованная на одном
 * посту схема обязана открываться на соседнем, а переустановка браузера не
 * должна уничтожать работу наладчика.
 *
 * Браузер остаётся запасным путём — служба может быть запущена без каталога
 * данных, и тогда рисовать всё равно надо. Происхождение схемы при этом
 * показывается на экране: «только на этом посту» — не мелкая подробность.
 */
export const mnemoStore = {
  key: 'ibolid.mnemo',
  /** Доступно ли серверное хранилище. Выясняется первым обращением. */
  server: null,

  localAll() {
    try { return JSON.parse(localStorage.getItem(this.key) || '{}'); } catch { return {}; }
  },

  /** Перечень схем: с сервера, а при его отсутствии — из браузера. */
  async list() {
    try {
      const r = await api.mnemoList();
      this.server = true;
      return r.items.map((i) => ({ ...i, local: false }));
    } catch (e) {
      this.server = false;
      const all = this.localAll();
      return Object.keys(all).sort().map((id) => ({
        id,
        name: all[id].name || id,
        widgets: (all[id].widgets || []).length,
        updated_at_us: 0,
        bytes: 0,
        local: true,
      }));
    }
  },

  async get(id) {
    try {
      const r = await api.mnemoGet(id);
      this.server = true;
      return { doc: JSON.parse(r.text), local: false, check: r.check };
    } catch (e) {
      const doc = this.localAll()[id];
      if (!doc) throw e;
      this.server = false;
      return { doc, local: true, check: null };
    }
  },

  /** Сохранение. Возвращает признак «легло на сервер». */
  async save(id, doc) {
    const text = JSON.stringify(doc, null, 2);
    try {
      const check = await api.mnemoSave(id, text);
      this.server = true;
      return { local: false, check };
    } catch (e) {
      // Отказ проверки — не повод писать в браузер: документ негоден, и
      // «сохранилось локально» скрыло бы ошибку схемы.
      if (e.status === 422) throw e;
      const all = this.localAll();
      all[id] = doc;
      localStorage.setItem(this.key, JSON.stringify(all));
      this.server = false;
      return { local: true, check: null };
    }
  },

  async remove(id) {
    try {
      await api.mnemoDelete(id);
    } catch {
      const all = this.localAll();
      delete all[id];
      localStorage.setItem(this.key, JSON.stringify(all));
    }
  },
};

async function mnemoList({ host, toast, reportError, hasRole }) {
  host.append(h('h2', { text: 'Мнемосхемы' }));

  const items = await mnemoStore.list();

  host.append(h('div', { class: 'toolbar' }, [
    hasRole('engineer')
      ? h('button', { class: 'primary', text: 'создать схему', onclick: () => location.hash = '#/editor' })
      : null,
    hasRole('engineer') ? h('label', { class: 'muted' }, [
      'открыть файл ',
      h('input', {
        type: 'file', accept: '.json,application/json',
        onchange: async (e) => {
          const file = e.target.files[0];
          if (!file) return;
          try {
            const doc = JSON.parse(await file.text());
            const id = doc.id || file.name.replace(/\.json$/i, '');
            const r = await mnemoStore.save(id, doc);
            toast(r.local ? 'схема сохранена только на этом посту' : 'схема сохранена на сервере',
              r.local ? 'info' : 'ok');
            location.hash = '#/mnemo/' + encodeURIComponent(id);
          } catch (err) {
            reportError(err);
          }
        },
      }),
    ]) : null,
    h('span', { class: 'spacer' }),
    // Где лежат схемы — не мелкая подробность: от этого зависит, увидит ли
    // их соседний пост и переживут ли они переустановку браузера.
    mnemoStore.server === false
      ? h('span', { class: 'sim-tag', text: 'ТОЛЬКО НА ЭТОМ ПОСТУ' })
      : h('span', { class: 'muted', text: 'хранятся на сервере' }),
  ]));

  if (mnemoStore.server === false) {
    host.append(h('p', { class: 'muted', text:
      'Служба запущена без каталога данных, поэтому схемы лежат в этом браузере: '
      + 'на другом посту их не видно, а очистка данных сайта их уничтожит. '
      + 'Запустите службу с ключом --data-dir, чтобы схемы принадлежали объекту.' }));
  }

  if (!items.length) {
    host.append(h('p', { class: 'empty', text: 'схем пока нет — создайте новую либо откройте файл' }));
    return;
  }

  host.append(h('div', { class: 'mnemo-list' }, items.map((item) =>
    h('a', { href: '#/mnemo/' + encodeURIComponent(item.id) }, [
      h('div', { text: item.name }),
      h('div', { class: 'muted', text: `${item.widgets} виджетов`
        + (item.updated_at_us ? ' · ' + timeText(item.updated_at_us) : '') }),
      item.local ? h('div', {}, h('span', { class: 'sim-tag', text: 'локально' })) : null,
    ]))));
}

/**
 * Выбирает вариант схемы под ширину окна.
 *
 * Правило то же, что у ступеней оформления: берётся вариант с наибольшим
 * порогом, не превышающим ширину. Подходящего нет — берётся самый узкий:
 * показать хоть что-то лучше, чем пустой экран.
 *
 * Схема без группы — сама по себе: связывать её с чем-то по догадке значило бы
 * открыть на телефоне не тот экран.
 */
async function pickVariant(loaded, asked) {
  const group = loaded.doc.responsive && loaded.doc.responsive.group;
  if (!group) return { id: asked, loaded };
  let list = [];
  try {
    list = await api.mnemoList();
  } catch {
    return { id: asked, loaded };
  }
  const variants = [];
  for (const item of list) {
    if (item.id === asked) {
      variants.push({ id: asked, loaded, min: loaded.doc.responsive.min_width || 0 });
      continue;
    }
    // Порог хранится в самом документе, и без него вариант не выбрать.
    try {
      const other = await mnemoStore.get(item.id);
      const r = other.doc.responsive;
      if (r && r.group === group) {
        variants.push({ id: item.id, loaded: other, min: r.min_width || 0 });
      }
    } catch { /* недоступный вариант просто не участвует в выборе */ }
  }
  if (variants.length < 2) return { id: asked, loaded };
  const width = window.innerWidth;
  const fitting = variants.filter((v) => v.min <= width);
  const best = fitting.length
    ? fitting.reduce((a, b) => (b.min > a.min ? b : a))
    : variants.reduce((a, b) => (b.min < a.min ? b : a));
  return best;
}

async function mnemo(ctx) {
  const { host, args, live, toast, reportError, hasRole } = ctx;
  if (!args.length) return mnemoList(ctx);

  const asked = args[0];
  let loaded;
  try {
    loaded = await mnemoStore.get(asked);
  } catch (e) {
    host.append(h('p', { class: 'empty', text: `схема «${asked}» не найдена` }));
    return;
  }

  // Вариант под ширину окна (ТЗ FR-713). Схема щита на телефоне читается
  // лупой; уменьшенная втрое она не становится схемой для телефона, а
  // становится нечитаемой. Поэтому вариант рисуют отдельно, а показывается
  // тот, что подходит.
  const chosen = await pickVariant(loaded, asked);
  const id = chosen.id;
  if (chosen.id !== asked) loaded = chosen.loaded;
  const doc = loaded.doc;

  const [violations, devices, channels, recent] = await Promise.all([
    api.activeViolations().catch(() => []),
    api.devices().catch(() => []),
    api.channels().catch(() => []),
    api.events(20).catch(() => []),
  ]);
  const render = new RenderContext({
    live,
    violations,
    devices,
    channels,
    events: recent,
    resources: doc.resource_data || {},
    onAction: (spec, instance) => runAction(spec, instance, { toast, reportError, live }),
    // Источник истории для графиков на схеме: сами отрисовщики к API не
    // обращаются, иначе их нельзя было бы показать в редакторе и в проверке.
    history: (tags, from, to, resolution, maxPoints) =>
      api.history(tags, from, to, resolution, maxPoints),
    onTrendOpen: (tags, from, to) => {
      const back = {
        hash: location.hash,
        scrollTop: host.scrollTop,
        scrollLeft: host.scrollLeft,
        at: Date.now(),
      };
      try { sessionStorage.setItem('ib.mnemo.trend-return', JSON.stringify(back)); } catch { /* private mode */ }
      const params = new URLSearchParams({
        tags: tags.join(','), from: String(from), to: String(to),
        period: String(Math.max(60, Math.round((to - from) / 1e6))), live: '0',
      });
      location.hash = '#/trends?' + params.toString();
    },
  });

  host.append(h('div', { class: 'toolbar' }, [
    h('h2', { text: doc.name || id, style: 'margin:0' }),
    loaded.local ? h('span', { class: 'sim-tag', text: 'ТОЛЬКО НА ЭТОМ ПОСТУ' }) : null,
    // Подменённый вариант называется: человек открывал одну схему, а видит
    // другую, и молчать об этом значит показать не то, что просили.
    chosen.id !== asked
      ? h('span', { class: 'muted', title: `вместо «${asked}»: вариант под ширину окна`,
          text: `вариант «${chosen.id}»` })
      : null,
    // Замечания проверки показываются и в просмотре: схема с привязкой к
    // несуществующему тегу выглядит рабочей, пока не понадобится значение.
    loaded.check && loaded.check.warnings.length
      ? h('span', { class: 'muted', title: loaded.check.warnings.join('\n'),
          text: `замечаний: ${loaded.check.warnings.length}` })
      : null,
    h('span', { class: 'spacer' }),
    hasRole('engineer')
      ? h('a', { href: '#/editor/' + encodeURIComponent(id), text: 'править' })
      : null,
  ]));

  const wrap = h('div', { class: 'mnemo-wrap' });
  const built = renderDocument(doc, render);
  wrap.append(built.node);
  host.append(wrap);

  // При возврате из подробного графика сохраняем место на мнемосхеме, чтобы
  // оператор вернулся к тому же агрегату, а не к началу длинного щита.
  try {
    const back = JSON.parse(sessionStorage.getItem('ib.mnemo.trend-return') || 'null');
    if (back && back.hash === location.hash && Date.now() - back.at < 10 * 60 * 1000) {
      host.scrollTop = back.scrollTop || 0;
      host.scrollLeft = back.scrollLeft || 0;
      sessionStorage.removeItem('ib.mnemo.trend-return');
    }
  } catch { /* состояние возврата необязательно */ }

  const onTags = () => built.update();
  live.addEventListener('tags', onTags);
  return {
    dispose: () => {
      live.removeEventListener('tags', onTags);
      built.dispose();
    },
  };
}

/**
 * Выполнение действия виджета (13.4.8, 13.4.21).
 *
 * Записываемое значение вычисляется **до** вопроса оператору: спросить
 * «Записать?» и записать не то — хуже, чем не спросить вовсе. Поэтому
 * источники значения разбираются здесь, а вопрос называет уже вычисленное
 * число (FR-723.27).
 */
async function runAction(spec, instance, { toast, reportError, live }) {
  const params = spec.params || {};
  // Имена — из формата документа. Прежние `write_tag` и `open_mnemo`
  // остаются понятными: схемы с ними могли попасть на объект правкой файла.
  const action = ({ write_tag: 'write', open_mnemo: 'navigate' })[spec.action] || spec.action;

  if (action !== 'write' && action !== 'toggle') {
    return runOther(action, spec, params, { toast, reportError });
  }

  const view = live && live.get ? live.get(params.tag) : null;
  const source = spec.action === 'toggle' ? 'toggle' : (params.source || 'const');
  const decided = await decideValue(source, params, view, { toast });
  if (decided === null) return;
  const { value, label } = decided;

  const limits = writeLimits(params, view);
  if (limits.reason) { toast(limits.reason, 'err'); return; }
  if (value < limits.min || value > limits.max) {
    // Проверка до отправки: команда, отвергнутая службой, доходит до
    // оператора отказом без пояснения, а здесь причина названа сразу.
    toast(`${value} вне допустимых границ ${limits.min}…${limits.max} для «${params.tag}»`, 'err');
    return;
  }

  // Вопрос задаётся только по явному признаку.
  //
  // Умолчание — не спрашивать: кнопку на щите нажимают, чтобы что-то
  // произошло, и вопрос на каждое нажатие превращает переключение реле в
  // двухтактную операцию. Выбор из списка и ввод значения спрашивают собой:
  // оператор видит, что именно выбирает.
  const asksItself = source === 'prompt' || source === 'list';
  const wantsConfirm = !!(spec.confirm
    && spec.confirm.text !== undefined && spec.confirm.text !== null);
  if (wantsConfirm && !asksItself) {
    const question = spec.confirm.text
      || defaultQuestion(source, params, value, label, view);
    if (!window.confirm(question)) return;
  }

  try {
    await api.write(params.tag, value);
    toast(`команда по «${params.tag}»: записано ${fmtWrite(value)}`
      + (label ? ` (${label})` : ''), 'ok');
  } catch (e) { reportError(e); }
}

/** Прочие действия, значения не пишущие. */
async function runOther(action, spec, params, { toast, reportError }) {
  if (spec.confirm && spec.confirm.text && !window.confirm(spec.confirm.text)) return;
  try {
    switch (action) {
      case 'acknowledge':
        await api.acknowledge(params.tag, params.comment || 'квитировано со схемы');
        toast('квитировано', 'ok');
        break;
      case 'navigate':
        location.hash = '#/mnemo/' + encodeURIComponent(params.target || params.id || params.mnemo || '');
        break;
      case 'open_url':
        toast('переход по внешнему адресу запрещён', 'err');
        break;
      default:
        toast(`действие «${spec.action}» не поддерживается интерфейсом`, 'err');
    }
  } catch (e) { reportError(e); }
}

/**
 * Вычисляет записываемое значение по источнику.
 *
 * `null` означает отказ от действия — оператор передумал либо значение
 * вычислить не из чего.
 */
async function decideValue(source, params, view, { toast }) {
  const current = view && typeof view.value === 'number' ? view.value : null;
  const good = !!(view && view.good);

  switch (source) {
    case 'toggle': {
      if (current === null || !good) {
        // Переключать вслепую нельзя: «обратное» вычислить не из чего, и
        // записанное было бы догадкой (FR-723.24).
        toast(`значение «${params.tag}» недостоверно — переключать нечего`, 'err');
        return null;
      }
      const on = params.on_value ?? 1;
      const off = params.off_value ?? 0;
      return { value: current === on ? off : on };
    }

    case 'step': {
      if (current === null || !good) {
        toast(`значение «${params.tag}» недостоверно — прибавлять не к чему`, 'err');
        return null;
      }
      const step = Number(params.step ?? 1);
      const next = current + step;
      const bounded = clampWrite(next, params, view);
      if (bounded !== next) {
        // Достигнут предел — об этом говорится, а не молча пишется край:
        // иначе кнопка выглядит нажимающейся, а значение не меняется.
        toast(`достигнут предел ${bounded} для «${params.tag}»`, 'warn');
      }
      return { value: bounded };
    }

    case 'prompt': {
      const limits = writeLimits(params, view);
      const units = (view && view.units) || '';
      const title = (view && view.title) || params.tag;
      const entered = window.prompt(
        `${title}\nтекущее значение: ${current === null ? 'неизвестно' : fmtWrite(current)}`
        + `${units ? ' ' + units : ''}\nдопустимо: ${limits.min}…${limits.max}`,
        // Заполняется текущим значением: уставку чаще подправляют, чем
        // задают с нуля, а ноль в поле уставки — готовая авария (FR-723.20).
        current === null ? '' : String(current),
      );
      if (entered === null) return null;
      const value = Number(String(entered).replace(',', '.'));
      if (!Number.isFinite(value)) {
        toast(`«${entered}» — не число`, 'err');
        return null;
      }
      return { value };
    }

    case 'list': {
      const items = params.items || [];
      if (!items.length) {
        toast('список значений пуст — выбирать не из чего', 'err');
        return null;
      }
      const chosen = await pickFromList(items, current, view, params);
      return chosen;
    }

    default:
      return { value: Number(params.value ?? 1) };
  }
}

/**
 * Диалог выбора значения из перечня (FR-723.21, FR-723.23).
 *
 * Текущее значение отмечено; значение, которого в перечне нет, показывается
 * как «Значение N» и не подменяется первым элементом — подмена выглядела бы
 * как «режим такой-то», хотя прибор в другом.
 */
async function pickFromList(items, current, view, params) {
  const title = (view && view.title) || params.tag;
  const units = (view && view.units) || '';
  const rows = h('div', { class: 'value-list' });
  let picked = null;

  const known = items.some((i) => Number(i.value) === current);
  if (current !== null && !known) {
    rows.append(h('div', { class: 'muted', text:
      `сейчас: Значение ${fmtWrite(current)}${units ? ' ' + units : ''} — в списке его нет` }));
  }

  for (const item of items) {
    const isCurrent = Number(item.value) === current;
    const button = h('button', {
      // Выбор отмечается, а записывается по отдельной кнопке: нажатие в
      // списке не должно двигать оборудование само по себе.
      class: 'value-list-item' + (isCurrent ? ' current' : '') + (item.dangerous ? ' danger' : ''),
      onclick: () => {
        picked = { value: Number(item.value), label: item.label || undefined };
        for (const other of rows.querySelectorAll('.value-list-item')) {
          other.classList.remove('picked');
        }
        button.classList.add('picked');
      },
    }, [
      h('span', { text: item.label || String(item.value) }),
      h('span', { class: 'muted mono', text: String(item.value) + (units ? ' ' + units : '') }),
      isCurrent ? h('span', { class: 'state-online', text: 'сейчас' }) : null,
      item.dangerous ? h('span', { class: 'state-offline', text: 'опасно' }) : null,
    ]);
    rows.append(button);
  }

  const confirmed = await modal({
    title: `${title}: выбор значения`,
    body: h('div', {}, [
      h('p', { class: 'muted', text:
        'Выбранное значение будет записано в прибор. Текущее отмечено.' }),
      rows,
    ]),
    confirmText: 'Записать выбранное',
    onConfirm: async () => {
      if (!picked) throw new Error('значение не выбрано');
      return picked;
    },
  });
  if (!confirmed || !picked) return null;
  // Опасное значение подтверждается отдельно (FR-723.28).
  const chosen = items.find((i) => Number(i.value) === picked.value);
  if (chosen && chosen.dangerous) {
    if (!window.confirm(`«${chosen.label || chosen.value}» помечено опасным. Записать?`)) return null;
  }
  return picked;
}

/** Границы записи: у действия — поверх заданных у регистра. */
function writeLimits(params, view) {
  const limits = (view && view.write_limits) || {};
  const min = params.min ?? limits.min ?? -Infinity;
  const max = params.max ?? limits.max ?? Infinity;
  if (Number.isFinite(min) && Number.isFinite(max) && min > max) {
    return { min, max, reason: `границы записи заданы наоборот: ${min} > ${max}` };
  }
  return { min, max, reason: null };
}

function clampWrite(value, params, view) {
  const { min, max } = writeLimits(params, view);
  return Math.min(max, Math.max(min, value));
}

function defaultQuestion(source, params, value, label, view) {
  const title = (view && view.title) || params.tag;
  const units = (view && view.units) || '';
  const what = `${fmtWrite(value)}${units ? ' ' + units : ''}`;
  const now = view && typeof view.value === 'number'
    ? `\nсейчас: ${fmtWrite(view.value)}${units ? ' ' + units : ''}` : '';
  if (source === 'toggle') return `Переключить «${title}» на ${what}?${now}`;
  if (source === 'step') return `Изменить «${title}» на ${what}?${now}`;
  if (label) return `Установить «${title}»: ${label} (${what})?${now}`;
  return `Записать ${what} в «${title}»?${now}`;
}

const fmtWrite = (v) => (Number.isFinite(v)
  ? v.toLocaleString('ru-RU', { maximumFractionDigits: 6 })
  : String(v));

// ── Редактор ────────────────────────────────────────────────────────

async function editor(ctx) {
  return openEditor(ctx, mnemoStore);
}


// ── Служба: состояние и перезапуск (ТЗ 13.14) ───────────────────────

/** Время работы словами: «3 ч 12 мин», а не «11520 с». */
function uptimeText(seconds) {
  const s = Number(seconds) || 0;
  if (s < 60) return `${s} с`;
  const m = Math.floor(s / 60);
  if (m < 60) return `${m} мин`;
  const h = Math.floor(m / 60);
  if (h < 24) return `${h} ч ${m % 60} мин`;
  return `${Math.floor(h / 24)} сут ${h % 24} ч`;
}

/**
 * Состояние службы и её перезапуск.
 *
 * Экран появился по прямому поводу: правка настройки отвечала «перезапустите
 * службу», а перезапустить её было нечем — у инженера на объекте нет ни
 * консоли, ни прав на диспетчер служб. Здесь видно, что именно работает,
 * откуда взята конфигурация и ждёт ли правка применения.
 */
async function service({ host, toast, reportError, hasRole }) {
  if (!hasRole('engineer')) {
    host.append(h('p', { class: 'empty', text: 'состояние службы доступно роли «инженер» и выше' }));
    return;
  }

  const body = h('div', {});
  host.append(h('h2', { text: 'Служба' }), body);

  const timer = setInterval(() => draw().catch(() => {}), 5000);
  await draw();
  return { dispose: () => clearInterval(timer) };

  async function draw() {
    let info;
    try {
      info = await api.service();
    } catch (e) {
      body.replaceChildren(h('p', { class: 'empty', text:
        'состояние службы недоступно: ' + (e && e.message ? e.message : e) }));
      return;
    }

    const fresh = h('div', {});

    // Несохранённое применение — главное, что здесь ищут.
    if (info.config_changed) {
      fresh.append(h('div', { class: 'cfg-block' }, [
        h('p', { class: 'warn-line', text:
          'Конфигурация изменена и ждёт применения. Служба работает по той, '
          + 'что была прочитана при запуске: новые приборы не опрашиваются, '
          + 'изменённые настройки не действуют.' }),
        h('div', { class: 'toolbar' }, [
          hasRole('admin')
            ? h('button', { class: 'primary', text: 'применить — перезапустить службу',
                onclick: restart })
            : h('span', { class: 'muted', text:
                'перезапуск выполняет администратор' }),
          h('span', { class: 'muted', text:
            'опрос прервётся на несколько секунд; интерфейс переподключится сам' }),
        ]),
      ]));
    }

    fresh.append(h('div', { class: 'cards' }, [
      card('Работает', uptimeText(info.uptime_s)),
      card('Каналов', String((info.channels || []).length)),
      card('Приборов', String(info.devices)),
      card('Тегов', String(info.tags)),
    ]));

    fresh.append(h('h3', { text: 'Что запущено' }));
    fresh.append(table(['Свойство', 'Значение'], [
      ['версия', info.version || '—'],
      ['конфигурация', h('span', { class: 'mono', text: info.config_path || '— не задана —' })],
      ['каталог данных', h('span', { class: 'mono', text: info.data_dir || '—' })],
      ['профили поставки', h('span', { class: 'mono',
        text: (info.profile_dirs || []).join(', ') || '— не заданы —' })],
      ['адрес интерфейса', h('span', { class: 'mono', text: info.bind || '—' })],
    ]));

    fresh.append(h('h3', { text: 'Линии' }));
    fresh.append(table(
      ['Канал', 'Транспорт', 'Порт или адрес', 'Приборов', 'Состояние'],
      (info.channels || []).map((c) => [
        c.id,
        c.simulated
          ? h('span', {}, [c.transport, ' ', h('span', { class: 'sim-tag', text: 'ИМИТАЦИЯ' })])
          : c.transport,
        h('span', { class: 'mono', text: c.address || '—' }),
        c.devices,
        h('span', {
          class: isSwitchedOff(c) ? 'state-off' : (c.running ? 'state-online' : 'state-offline'),
          text: c.port_state || (c.running ? 'работает' : 'состояние неизвестно'),
          title: c.last_error || '',
        }),
      ]),
    ));

    if ((info.stopped || []).length) {
      fresh.append(h('p', { class: 'warn-line', text:
        'Остановлены: ' + info.stopped.join(', ')
        + '. Их приборы не опрашиваются, а значения тегов недостоверны.' }));
    }

    if (hasRole('admin')) {
      fresh.append(h('h3', { text: 'Управление' }));
      fresh.append(h('div', { class: 'toolbar' }, [
        h('button', { text: 'перезапустить службу', onclick: restart }),
        h('span', { class: 'muted', text:
          info.can_restart
            ? 'перезапуск поднимает службу заново с теми же параметрами запуска'
            : 'перезапуск недоступен: служба запущена без него' }),
      ]));
    }

    // Мост MQTT: связь с верхним уровнем. Отдельным блоком здесь, а не своим
    // экраном: у него одно состояние и несколько чисел, и ради них гонять
    // человека по меню незачем.
    try {
      const mqtt = await api.mqttStatus();
      fresh.append(mqttBlock(mqtt));
    } catch {
      // Прав не хватило либо мост не поднят — блок просто не появится.
    }

    body.replaceChildren(fresh);
  }

  /** Состояние моста MQTT (ТЗ 14.5). */
  function mqttBlock(mqtt) {
    const rows = [];
    if (!mqtt.enabled) {
      rows.push(h('p', { class: 'muted', text:
        'Мост выключен. Включается в настройке объекта, раздел mqtt.' }));
    } else {
      rows.push(h('div', { class: 'toolbar' }, [
        h('span', { class: mqtt.connected ? 'ok' : 'bad',
          text: mqtt.connected ? 'связь с брокером есть' : 'связи с брокером нет' }),
        h('span', { class: 'muted', text: mqtt.target || '' }),
      ]));
      rows.push(h('table', { class: 'grid' }, [
        h('thead', {}, [h('tr', {}, ['опубликовано', 'команд исполнено', 'команд отвергнуто']
          .map((t) => h('th', { text: t })))]),
        h('tbody', {}, [h('tr', {}, [
          h('td', { text: String(mqtt.published ?? 0) }),
          h('td', { text: String(mqtt.commands ?? 0) }),
          h('td', {}, [mqtt.refused
            ? h('span', { class: 'bad', text: String(mqtt.refused) })
            : h('span', { class: 'muted', text: '0' })]),
        ])]),
      ]));
    }
    for (const problem of mqtt.problems || []) {
      rows.push(h('p', { class: 'warn-line', text: problem }));
    }
    if (mqtt.last_error) {
      rows.push(h('p', { class: 'muted', text: 'последнее: ' + mqtt.last_error }));
    }
    return h('div', { class: 'cfg-block' }, [h('h3', { text: 'Мост MQTT' }), ...rows]);
  }

  /** Перезапуск с подтверждением и ожиданием возврата. */
  async function restart() {
    const confirmed = await modal({
      title: 'Перезапустить службу?',
      body: h('div', {}, [
        h('p', { text:
          'Опрос всех линий прервётся на несколько секунд. Архив и журналы '
          + 'закроются правильно, порты освободятся, служба поднимется заново.' }),
        h('p', { class: 'muted', text:
          'Это единственный способ применить изменённую конфигурацию.' }),
      ]),
      confirmText: 'Перезапустить',
      onConfirm: async () => api.restartService(),
    });
    if (!confirmed) return;
    toast(confirmed.note || 'служба перезапускается', 'ok');
    await waitForService();
  }

  /**
   * Ожидание возврата службы.
   *
   * Без него экран замирает на «перезапускается» и выглядит зависшим: служба
   * поднимается за секунды, а понять это по молчанию нельзя.
   */
  async function waitForService() {
    body.replaceChildren(h('p', { class: 'empty', text: 'служба перезапускается, ожидание…' }));
    const until = Date.now() + 30000;
    while (Date.now() < until) {
      await new Promise((r) => setTimeout(r, 1000));
      try {
        await api.health();
        await draw();
        toast('служба поднялась', 'ok');
        return;
      } catch { /* ещё не поднялась */ }
    }
    body.replaceChildren(h('p', { class: 'warn-line', text:
      'Служба не ответила за 30 секунд. Проверьте её вручную: возможно, '
      + 'конфигурация не позволяет запуститься — тогда причина в выводе процесса.' }));
  }
}


// ── Уведомления: состояние, журнал отправок, проверка (раздел 14.6) ──

/**
 * Экран уведомлений.
 *
 * Настройка оповещения проверяется единственным способом — отправкой. Верный
 * на вид токен и живой на вид адрес чата выясняются только тогда, когда
 * сообщение доходит либо не доходит, а «не доходит» замечают по последствиям:
 * тревога была, никто не приехал. Поэтому здесь рядом стоят три вещи —
 * состояние каналов, журнал отправок с причинами и кнопка проверочной
 * отправки.
 */
async function notifications({ host, toast, reportError, hasRole }) {
  if (!hasRole('operator')) {
    host.append(h('p', { class: 'empty', text: 'уведомления доступны роли «оператор» и выше' }));
    return;
  }

  const body = h('div', {});
  host.append(h('h2', { text: 'Уведомления' }), body);

  const timer = setInterval(() => draw().catch(() => {}), 5000);
  await draw();
  return { dispose: () => clearInterval(timer) };

  async function draw() {
    let status;
    let log = { items: [] };
    try {
      status = await api.notifyStatus();
      log = await api.notifyLog(100);
    } catch (e) {
      // Служба без уведомлений — не поломка: раздел просто не заведён.
      body.replaceChildren(h('p', { class: 'empty', text:
        (e && e.code === 'NOTIFY_UNAVAILABLE')
          ? 'Служба запущена без уведомлений. Заведите раздел «notifications» в настройке '
            + 'объекта: канал (Telegram, почта либо HTTP), получатели и фильтры.'
          : ('состояние уведомлений не прочитано: ' + (e && e.message ? e.message : e)) }));
      return;
    }

    const fresh = h('div', {});

    if (!status.enabled) {
      fresh.append(h('p', { class: 'hint', text:
        'Раздел уведомлений выключен: события никому не отправляются. Включить: '
        + '«Настройка приборов» → «править как текст» → в разделе "notifications" '
        + 'поставьте "enabled": true, затем перезапуск службы.' }));
    }

    fresh.append(h('div', { class: 'cards' }, [
      card('Каналов', status.channels.length
        ? status.channels.join(', ')
        : (status.enabled ? '— ни одного —' : 'выключено')),
      card('Получателей', status.recipients_enabled === status.recipients
        ? String(status.recipients)
        : `${status.recipients_enabled} из ${status.recipients}`),
      card('В очереди', String(status.queued)),
      card('Отправлено', String(status.sent)),
      card('Отказов', String(status.failed)),
      card('Отброшено', String(status.dropped)),
    ]));

    // Жалобы на настройку — прежде журнала: пока настройка негодна, журнал
    // объясняет следствие, а не причину.
    if (status.problems && status.problems.length) {
      fresh.append(h('h3', { text: 'Настройка' }));
      fresh.append(h('ul', { class: 'problems' },
        status.problems.map((p) => h('li', { class: 'warn-line', text: p }))));
    }

    if (status.dropped > 0) {
      fresh.append(h('p', { class: 'warn-line', text:
        `Отброшено уведомлений: ${status.dropped}. Очередь переполнена — внешняя `
        + 'служба не принимает быстрее, чем возникают события. Уменьшите число '
        + 'получателей, поднимите порог приоритета либо увеличьте "queue_limit".' }));
    }
    if (status.last_error) {
      fresh.append(h('p', { class: 'warn-line', text: 'Последний отказ: ' + status.last_error }));
    }

    if (hasRole('admin')) {
      fresh.append(h('h3', { text: 'Проверочная отправка' }));
      fresh.append(probeBlock(toast, reportError, status));
      fresh.append(h('h3', { text: 'Секреты' }));
      fresh.append(await secretsBlock(toast, reportError));
    }

    fresh.append(h('h3', { text: 'Журнал отправок' }));
    const items = log.items || [];
    if (!items.length) {
      fresh.append(h('p', { class: 'empty', text:
        'отправок не было — либо событий не случалось, либо ни один получатель под них не подходит' }));
    } else {
      fresh.append(table(
        ['Время', 'Получатель', 'Канал', 'Куда', 'Итог', 'Причина', 'Текст'],
        items.map((r) => [
          timeText(r.at_us),
          r.recipient,
          r.channel || '—',
          h('span', { class: 'mono', text: r.address || '—' }),
          h('span', {
            class: r.outcome === 'отправлено' ? 'state-online'
              : (r.outcome === 'отказ' ? 'state-offline' : 'state-off'),
            text: r.outcome,
          }),
          h('span', { class: 'muted', text: r.detail || '' }),
          h('span', { class: 'muted', text: (r.text || '').slice(0, 90) }),
        ]),
      ));
    }

    body.replaceChildren(fresh);
  }
}

/** Проверочная отправка по одному каналу (FR-814.3). */
function probeBlock(toast, reportError, status) {
  const channel = selectInput(
    [['telegram', 'Telegram'], ['email', 'электронная почта'], ['http', 'исходящий HTTP']],
    'telegram', () => {},
  );
  const address = h('input', {
    style: 'width:260px',
    placeholder: 'чат, адрес почты либо адрес запроса',
  });
  const go = h('button', { class: 'primary', text: 'отправить проверочное' });

  go.addEventListener('click', async () => {
    const to = address.value.trim();
    if (!to) { toast('укажите, куда отправить', 'warn'); return; }
    go.disabled = true;
    go.textContent = 'отправляется…';
    try {
      const r = await api.notifyProbe(channel.value, to);
      toast(r.note || 'отправлено', 'ok');
    } catch (e) {
      // Отказ проверки — это и есть её польза: текст ответа службы и правят.
      reportError(e);
    } finally {
      go.disabled = false;
      go.textContent = 'отправить проверочное';
    }
  });

  return h('div', {}, [
    h('p', { class: 'muted', text:
      'Проверка идёт через настроенный канал, минуя фильтры и тихие часы: '
      + 'проверяется связь со службой, а не правила маршрутизации.' }),
    h('div', { class: 'toolbar' }, [
      field('канал', channel),
      field('куда', address),
      go,
    ]),
    status.channels.length ? null : h('p', { class: 'warn-line', text:
      'Ни один канал не настроен — отправлять нечем. Проверьте раздел '
      + '"notifications" и заданные секреты.' }),
  ]);
}

/**
 * Секреты: токены и пароли, лежащие отдельно от конфигурации.
 *
 * Показываются только имена. Токен, однажды выведенный на экран, оказывается
 * в снимке экрана, а оттуда — где угодно; и он же уйдёт вместе с файлом
 * настройки, если хранить его там.
 */
async function secretsBlock(toast, reportError) {
  const box = h('div', {});
  const name = h('input', { style: 'width:180px', placeholder: 'имя, как в настройке' });
  const value = h('input', { type: 'password', style: 'width:280px', placeholder: 'значение' });
  const save = h('button', { class: 'primary', text: 'задать' });

  async function redrawList() {
    let items = [];
    try {
      items = (await api.notifySecrets()).items || [];
    } catch (e) {
      box.replaceChildren(h('p', { class: 'warn-line', text:
        'секреты не прочитаны: ' + (e && e.message ? e.message : e) }));
      return;
    }
    box.replaceChildren(items.length
      ? table(['Имя', 'Значение', ''], items.map((n) => [
        h('span', { class: 'mono', text: n }),
        h('span', { class: 'muted', text: '••••••••  (не показывается)' }),
        h('button', {
          class: 'danger', text: 'удалить',
          onclick: async () => {
            try {
              await api.deleteNotifySecret(n);
              toast(`секрет «${n}» удалён`, 'ok');
              await redrawList();
            } catch (e) { reportError(e); }
          },
        }),
      ]))
      : h('p', { class: 'empty', text: 'секретов нет' }));
  }

  save.addEventListener('click', async () => {
    const key = name.value.trim();
    if (!key) { toast('укажите имя секрета', 'warn'); return; }
    if (!value.value) { toast('пустое значение секрета бесполезно', 'warn'); return; }
    try {
      await api.setNotifySecret(key, value.value);
      toast(`секрет «${key}» задан; чтобы применить — перезапуск службы`, 'ok');
      name.value = '';
      value.value = '';
      await redrawList();
    } catch (e) { reportError(e); }
  });

  await redrawList();

  return h('div', {}, [
    h('p', { class: 'muted', text:
      'Токен бота и пароль почты лежат в файле secrets.json рядом с данными, а не '
      + 'в настройке объекта: файл настройки правят из интерфейса, показывают в '
      + 'поддержку и выгружают архивом — секрет ушёл бы вместе с ним. В настройке '
      + 'остаётся только имя ("token_ref", "password_ref").' }),
    h('div', { class: 'toolbar' }, [field('имя', name), field('значение', value), save]),
    box,
  ]);
}

/**
 * Экран «Проекты» (ТЗ FR-910.9).
 *
 * Проект — это папка: настройка, история, учётные записи, схемы и свои
 * шаблоны приборов лежат вместе и переносятся вместе.
 *
 * Открытие другого проекта **останавливает текущий объект целиком**. Два
 * объекта одним экземпляром не обслуживаются: величины одного показывались бы
 * под именем другого, и заметили бы это не сразу.
 */
async function projects({ host, toast, reportError, hasRole }) {
  const list = h('div', {});
  const dirInput = h('input', {
    type: 'text', style: 'width:min(560px,100%)',
    placeholder: 'полный путь к папке проекта',
  });

  async function draw() {
    let items = [];
    try {
      items = await api.projects();
    } catch (e) {
      list.replaceChildren(h('p', { class: 'warn-line', text:
        'перечень проектов недоступен: ' + (e && e.message ? e.message : e) }));
      return;
    }
    list.replaceChildren(...items.map((p) => h('div', { class: 'cfg-block' }, [
      h('div', { class: 'toolbar' }, [
        h('strong', { text: p.name || p.dir }),
        p.current ? h('span', { class: 'lvl lvl-ok', text: 'открыт сейчас' }) : null,
        h('span', { class: 'spacer' }),
        p.current || !hasRole('engineer') ? null : h('button', {
          text: 'открыть',
          title: 'опрос текущего объекта будет остановлен',
          onclick: () => switchTo(p.dir, p.name || p.dir),
        }),
      ].filter(Boolean)),
      h('p', { class: 'mono muted', text: p.dir }),
      p.opened_at ? h('p', { class: 'muted', text: 'открывали ' + p.opened_at }) : null,
    ].filter(Boolean))));
  }

  async function switchTo(dir, name) {
    // Последствие называется до действия, а не после: опрос прервётся, и
    // человек должен знать об этом, пока может отказаться.
    await modal({
      title: 'Открыть другой проект?',
      body: [
        h('p', {}, ['Будет открыт проект ', h('strong', { text: name }), '.']),
        h('p', { class: 'warn-line', text:
          'Опрос текущего объекта прекратится: каналы остановятся, архив '
          + 'закроется, внешние интерфейсы отключатся. Несохранённая правка '
          + 'настройки останется в файле, но применена не будет.' }),
      ],
      confirmText: 'открыть',
      onConfirm: async () => { await api.openProject(dir); },
    });
    toast('проект открывается; окно переключится само', 'ok');
  }

  const storage = h('div', { class: 'cfg-block' });
  const startup = h('div', { class: 'cfg-block' });
  const launch = h('div', { class: 'cfg-block' });
  const assistant = h('div', { class: 'cfg-block' });

  /**
   * Параметры запуска — здесь их ищут.
   *
   * Правятся они на экране настройки приборов, вместе с остальным файлом
   * объекта: настройка одна, и второй её редактор разошёлся бы с первым. Но
   * искать «где задать адрес и порт» человек идёт сюда — на экран про объект
   * целиком, а не про приборы. Поэтому здесь они показаны и отсюда открывается
   * правка.
   */
  async function drawLaunch() {
    let info;
    try {
      info = await api.service();
    } catch (e) {
      launch.replaceChildren(h('p', { class: 'warn-line', text:
        'параметры запуска недоступны: ' + (e && e.message ? e.message : e) }));
      return;
    }
    const bind = info.bind || '—';
    const host = bind.includes(':') ? bind.slice(0, bind.lastIndexOf(':')) : bind;
    const exposed = !(host.startsWith('127.') || host === 'localhost' || host === '[::1]');
    launch.replaceChildren(...[
      h('h2', { text: 'Параметры запуска' }),
      h('table', { class: 'kv' }, [
        h('tr', {}, [h('th', { text: 'адрес и порт' }), h('td', { class: 'mono', text: bind })]),
        h('tr', {}, [h('th', { text: 'доступен' }), h('td', { text:
          exposed ? 'со всех сетевых плат этого адреса' : 'только с этой машины' })]),
        h('tr', {}, [h('th', { text: 'настройка' }), h('td', { class: 'mono', text: info.config_path || '—' })]),
        h('tr', {}, [h('th', { text: 'каталог данных' }), h('td', { class: 'mono', text: info.data_dir || '—' })]),
      ]),
      h('div', { class: 'toolbar' }, [
        h('a', { class: 'button', href: '#/setup', text: 'изменить адрес, порт и номер экземпляра' }),
      ]),
      h('p', { class: 'muted', text:
        'Правятся на экране «Настройка» и действуют '
        + 'после перезапуска службы. Несколько объектов на одной машине '
        + 'различаются номером экземпляра и портом: одинаковый порт у двух '
        + 'объектов — отказ запуска второго.' }),
    ].filter(Boolean));
  }

  /**
   * Подключение ассистента (ТЗ 14.9).
   *
   * Сервер MCP есть, но искать его человеку было негде: он живёт подкомандой
   * и в справке. Настройка, которую надо собрать руками по описанию, содержит
   * опечатку в пути — и видно это только по молчанию клиента.
   */
  async function drawAssistant() {
    let setup;
    try {
      setup = await api.mcpSetup();
    } catch (e) {
      assistant.replaceChildren(
        h('h2', { text: 'Подключение ассистента' }),
        h('p', { class: 'muted', text:
          'настройка подключения недоступна: ' + (e && e.message ? e.message : e) }),
      );
      return;
    }
    const copy = (label, text) => h('button', { class: 'small', text: label, onclick: () => {
      navigator.clipboard.writeText(text).then(
        () => toast('скопировано', 'ok'),
        () => toast('скопировать не удалось — выделите и скопируйте вручную', 'warn'),
      );
    } });
    assistant.replaceChildren(
      h('h2', { text: 'Подключение ассистента' }),
      h('p', { class: 'muted', text:
        'Настройка ниже указывает объект номером экземпляра (' + (setup.instance || 1)
        + '), а не портом: порт меняют, номер — нет. Ассистент найдёт '
        + 'работающий объект с этим номером сам.' }),
      h('p', { class: 'muted', text:
        'Ассистент видит объект тем же REST, что и этот интерфейс, и не может '
        + 'больше, чем человек с тем же ключом сеанса. Инструменты, меняющие '
        + 'объект, помечены — ассистент обязан спросить подтверждение.' }),
      h('h3', { text: 'Claude — на этой же машине' }),
      h('p', { class: 'muted', text:
        'Запускает сервер сам и говорит с ним через ввод-вывод: в сеть не '
        + 'открывается ничего. Положите это в %APPDATA%\\Claude\\claude_desktop_config.json:' }),
      h('pre', { class: 'mono', text: setup.claude_config }),
      h('div', { class: 'toolbar' }, [
        copy('скопировать настройку', setup.claude_config),
        copy('скопировать команду для Claude Code', setup.claude_command),
      ]),
      h('h3', { text: 'Codex CLI — на этой же машине' }),
      h('p', { class: 'muted', text:
        'Тот же ввод-вывод, но настройка в TOML: JSON от Claude Codex не '
        + 'прочитает. Добавьте в ~/.codex/config.toml '
        + '(в Windows — %USERPROFILE%\\.codex\\config.toml):' }),
      h('pre', { class: 'mono', text: setup.codex_config }),
      h('div', { class: 'toolbar' }, [
        copy('скопировать настройку Codex', setup.codex_config),
      ]),
      h('h3', { text: 'ChatGPT — только по HTTPS снаружи' }),
      h('p', { class: 'muted', text:
        'Машину в частной сети он не видит: понадобится туннель либо обратный '
        + 'посредник с сертификатом. Порядок целиком:' }),
      h('pre', { class: 'mono', text: setup.chatgpt }),
      h('p', { class: 'warn-line', text:
        'Открытый наружу сервер MCP — это открытая настройка объекта: за ним '
        + 'запись в приборы, правка порогов и остановка линий. Ключ сеанса '
        + 'обязателен.' }),
    );
  }

  /**
   * Автозапуск клиента визуализации.
   *
   * На посту оператора компьютер включают утром и уходят: мнемосхема должна
   * быть на экране, а не ждать, пока кто-нибудь вспомнит про ярлык. Опрос при
   * этом может идти службой круглосуточно — здесь речь про **окно**.
   */
  async function drawStartup() {
    let st;
    try {
      st = await api.autostart();
    } catch (e) {
      startup.replaceChildren(h('p', { class: 'warn-line', text:
        'состояние автозапуска недоступно: ' + (e && e.message ? e.message : e) }));
      return;
    }
    if (!st.supported) {
      startup.replaceChildren(
        h('h2', { text: 'Автозапуск' }),
        h('p', { class: 'muted', text:
          'На этой системе автозапуск настраивается её собственными средствами.' }),
      );
      return;
    }
    const box = h('input', { type: 'checkbox' });
    box.checked = st.enabled;
    box.disabled = !hasRole('admin');
    box.addEventListener('change', async () => {
      try {
        toast(await api.setAutostart(box.checked), 'ok');
      } catch (e) { reportError(e); box.checked = !box.checked; }
      await drawStartup();
    });
    // Условные элементы отсеиваются до передачи: `null` среди детей
    // превращается на экране в слово «null».
    // Соседи по машине: на посту держат несколько объектов сразу, и человек,
    // настраивая автозапуск одного, вправе знать, что при входе откроется ещё
    // и второй. Иначе два окна поверх друг друга выглядят неисправностью.
    const others = st.others || [];
    startup.replaceChildren(...[
      h('h2', { text: 'Автозапуск' }),
      h('label', {}, [box, ' открывать клиент визуализации при входе в систему']),
      st.enabled && st.project
        ? h('p', { class: 'mono muted', text: 'откроется: ' + st.project })
        : null,
      // Запись у каждого экземпляра своя: пока имя было одно на машину,
      // включение автозапуска второго объекта стирало первый.
      st.entry
        ? h('p', { class: 'mono muted', text:
            'экземпляр ' + (st.instance || 1) + ', запись автозапуска «' + st.entry + '»' })
        : null,
      others.length
        ? h('p', { class: 'muted', text:
            'При входе в систему откроются и другие объекты этой машины — '
            + others.map((o) => 'экземпляр ' + o.instance + ': ' + o.project).join('; ') })
        : null,
      h('p', { class: 'muted', text:
        'Запоминается путь к программе, каким он есть сейчас. Программа, '
        + 'запущенная из «Загрузок», пропишет в автозапуск «Загрузки» и '
        + 'перестанет открываться, как только папку почистят: ставьте её на '
        + 'место до включения автозапуска.' }),
      hasRole('admin') ? null : h('p', { class: 'muted', text:
        'автозапуск включает администратор' }),
    ].filter(Boolean));
  }

  /**
   * Хранилище проекта (ТЗ 16.7).
   *
   * Резервные копии отвечают на «верни как было», но не отвечают на «кто и
   * зачем это менял» и «чем объект отличается от соседнего». На это отвечает
   * система контроля версий.
   */
  async function drawStorage() {
    let st;
    try {
      st = await api.gitStatus();
    } catch (e) {
      storage.replaceChildren(h('p', { class: 'warn-line', text:
        'состояние хранилища недоступно: ' + (e && e.message ? e.message : e) }));
      return;
    }

    if (!st.git_available) {
      storage.replaceChildren(
        h('h2', { text: 'Версии проекта' }),
        h('p', { class: 'warn-line', text:
          'git не найден ни в PATH, ни в обычных местах установки. Проект '
          + 'работает без него полностью — недоступны только операции '
          + 'хранилища.' }),
        h('p', { class: 'muted', text:
          'Поставьте Git для Windows либо добавьте уже установленный в PATH и '
          + 'перезапустите службу.' }),
      );
      return;
    }

    if (!st.repo) {
      storage.replaceChildren(
        h('h2', { text: 'Версии проекта' }),
        h('p', { class: 'muted', text:
          'Папка проекта не под контролем версий. Заведение создаст репозиторий '
          + 'и правила исключения: секреты, учётные записи, ключи и архив не '
          + 'версионируются никогда.' }),
        h('button', { class: 'primary', text: 'завести хранилище', onclick: async () => {
          try { toast(await api.gitInit(), 'ok'); await drawStorage(); }
          catch (e) { reportError(e); }
        } }),
      );
      return;
    }

    const message = h('input', {
      type: 'text', style: 'width:min(480px,100%)',
      placeholder: 'что изменилось: «пороги цеха 1»',
    });
    const remote = h('input', {
      type: 'text', style: 'width:min(480px,100%)',
      value: st.remote || '',
      placeholder: 'адрес хранилища, например github.com/бригада/объект.git',
    });
    const token = h('input', {
      type: 'password', style: 'width:min(360px,100%)',
      placeholder: st.token_set ? 'задан — введите новый, чтобы заменить' : 'токен доступа',
    });

    let history = [];
    try { history = await api.gitLog(20); } catch { history = []; }

    storage.replaceChildren(
      h('h2', { text: 'Версии проекта' }),
      h('p', { class: 'muted', text:
        `ветка ${st.branch}` + (st.remote ? `, впереди ${st.ahead}, позади ${st.behind}` : '')
        + (st.found_at ? ` · git: ${st.found_at}` : '') }),
      st.changed.length
        ? h('div', {}, [
            h('p', { text: `Изменений с прошлой фиксации: ${st.changed.length}` }),
            h('pre', { class: 'mono', text: st.changed.slice(0, 20).join('\n') }),
          ])
        : h('p', { class: 'muted', text: 'изменений нет' }),
      h('div', { class: 'toolbar' }, [
        message,
        h('button', { class: 'primary', text: 'зафиксировать', onclick: async () => {
          if (!message.value.trim()) { toast('напишите, что изменилось', 'warn'); return; }
          try { toast(await api.gitCommit(message.value.trim()), 'ok'); await drawStorage(); }
          catch (e) { reportError(e); }
        } }),
      ]),
      h('p', { class: 'muted', text:
        'Секреты, учётные записи и ключи не версионируются никогда: попав в '
        + 'историю однажды, они остаются в ней навсегда.' }),

      h('h2', { text: 'Удалённое хранилище' }),
      h('div', { class: 'toolbar' }, [
        remote,
        h('button', { text: 'сохранить адрес', onclick: async () => {
          try { toast(await api.gitRemote(remote.value.trim()), 'ok'); await drawStorage(); }
          catch (e) { reportError(e); }
        } }),
      ]),
      hasRole('admin') ? h('div', { class: 'toolbar' }, [
        token,
        h('button', { text: st.token_set ? 'заменить токен' : 'задать токен', onclick: async () => {
          if (!token.value) { toast('введите токен', 'warn'); return; }
          try { await api.gitToken(token.value); token.value = ''; toast('токен сохранён', 'ok'); await drawStorage(); }
          catch (e) { reportError(e); }
        } }),
      ]) : h('p', { class: 'muted', text: 'токен задаёт администратор' }),
      h('p', { class: 'muted', text:
        'Токен доступа, а не пароль от учётной записи: пароль даёт доступ ко '
        + 'всему, токен ограничен одним хранилищем и отзывается отдельно. '
        + 'Обратно он не показывается — заменить можно, посмотреть нет.' }),
      h('div', { class: 'toolbar' }, [
        h('button', { text: 'отправить', onclick: async () => {
          try { toast(await api.gitPush(), 'ok'); await drawStorage(); }
          catch (e) { reportError(e); }
        } }),
        h('button', { text: 'забрать', onclick: async () => {
          try { toast(await api.gitPull(), 'ok'); await drawStorage(); }
          catch (e) { reportError(e); }
        } }),
      ]),

      h('h2', { text: 'История' }),
      history.length
        ? h('table', { class: 'cfg-regs' }, [
            h('thead', {}, h('tr', {}, headerCells(['Когда', 'Кто', 'Что']))),
            h('tbody', {}, history.map((c) => h('tr', {}, [
              h('td', { class: 'mono', text: c.at }),
              h('td', { text: c.author }),
              h('td', { text: c.message }),
            ]))),
          ])
        : h('p', { class: 'muted', text: 'фиксаций пока нет' }),
    );
  }

  host.replaceChildren(
    h('h1', { text: 'Проекты' }),
    h('p', { class: 'hint', text:
      'Проект — это папка: настройка, история, учётные записи, мнемосхемы и свои '
      + 'шаблоны приборов лежат вместе и переносятся вместе. Открытие другого '
      + 'проекта останавливает текущий объект целиком.' }),
    list,
    hasRole('engineer') ? h('div', { class: 'cfg-block' }, [
      h('h2', { text: 'Другая папка' }),
      h('div', { class: 'toolbar' }, [
        dirInput,
        h('button', { text: 'открыть', onclick: () => {
          const dir = dirInput.value.trim();
          if (!dir) { toast('укажите путь к папке', 'warn'); return; }
          switchTo(dir, dir).catch(reportError);
        } }),
        h('button', { text: 'создать здесь новый', onclick: async () => {
          const dir = dirInput.value.trim();
          if (!dir) { toast('укажите путь к пустой папке', 'warn'); return; }
          try {
            await api.createProject(dir, '');
            toast('проект заведён и открывается', 'ok');
          } catch (e) { reportError(e); }
        } }),
      ]),
      h('p', { class: 'muted', text:
        'Создание отвергается, если в папке уже есть config.json: папка, '
        + 'выбранная по ошибке, не должна стоить наладчику объекта.' }),
    ]) : h('p', { class: 'muted', text: 'смена проекта доступна инженеру и выше' }),
  );

  host.append(launch, startup, assistant, storage);
  await draw();
  await drawLaunch();
  await drawStartup();
  await drawAssistant();
  await drawStorage();
  return null;
}

/**
 * Экран «Настройка» — параметры самой программы (ТЗ 16.8).
 *
 * Прежде они стояли первым блоком на экране приборов, и найти их там было
 * нельзя: адрес, порт и номер экземпляра — это про программу, а не про
 * приборы. Заказчик спросил о них дважды, и оба раза был прав.
 *
 * Правится тот же файл настройки объекта, что и на экране приборов, — но
 * только эти поля: настройка читается заново перед каждой записью, и всё
 * остальное в ней остаётся как есть. Иначе два экрана переписывали бы работу
 * друг друга.
 */
async function settings({ host, toast, reportError, hasRole }) {
  const form = h('div', { class: 'cfg-block' });
  host.replaceChildren(
    h('h1', { text: 'Система и архив' }),
    h('p', { class: 'hint', text:
      'Параметры самой программы и её архива: как объект видно по сети, каким '
      + 'номером он отличается от соседних на этой машине, где и сколько '
      + 'хранится временной ряд. Приборы и линии — на экране «Приборы и линии».' }),
    form,
  );

  /**
   * Рисует поля. С готовым документом — без обращения к службе: кнопки адреса
   * меняют пояснение под полем, и перечитывать ради этого настройку значило бы
   * потерять всё, что человек уже набрал.
   */
  async function draw(preloaded) {
    let doc = preloaded;
    if (!doc) {
      try {
        doc = JSON.parse((await api.config()).text);
      } catch (e) {
        form.replaceChildren(h('p', { class: 'warn-line', text:
          'настройка не прочитана: ' + (e && e.message ? e.message : e) }));
        return;
      }
    }
    const gateway = doc.gateway || (doc.gateway = {});
    const web = doc.web || (doc.web = {});
    const editable = hasRole('engineer');

    const name = h('input', { type: 'text', value: gateway.instance_name || '' });
    const instance = h('input', { type: 'number', min: '1', max: '99',
      value: String(gateway.instance ?? 1) });
    const bind = h('input', { type: 'text', value: web.bind || 'local',
      placeholder: '127.0.0.1, 0.0.0.0 либо адрес платы' });
    const port = h('input', { type: 'number', min: '1', max: '65535',
      value: String(web.port ?? 8080) });
    const enabled = h('input', { type: 'checkbox' });
    enabled.checked = web.enabled !== false;
    for (const field of [name, instance, bind, port, enabled]) field.disabled = !editable;
    // Состояние хранилищ: связь, буфер, потери. Внешняя база, у которой
    // пропала связь, копит записи в буфер — и узнать об этом надо сразу, а не
    // когда буфер кончится.
    const health = h('div', { class: 'cfg-block' });
    (async () => {
      let rows = [];
      try {
        rows = await api.archiveHealth();
      } catch (e) {
        // Прав не хватило либо архив не поднят: молчим, это не отказ экрана.
        return;
      }
      if (!rows.length) return;
      health.replaceChildren(
        h('h3', { text: 'Состояние хранилищ' }),
        h('table', { class: 'grid' }, [
          h('thead', {}, [h('tr', {}, ['хранилище', 'связь', 'ждёт отправки', 'потеряно', 'замечание']
            .map((t) => h('th', { text: t })))]),
          h('tbody', {}, rows.map((r) => h('tr', {}, [
            h('td', { text: r.kind }),
            h('td', {}, [h('span', { class: r.connected ? 'ok' : 'bad',
              text: r.connected ? 'есть' : 'нет' })]),
            h('td', { text: String(r.pending) }),
            h('td', {}, [r.lost
              ? h('span', { class: 'bad', text: String(r.lost) })
              : h('span', { class: 'muted', text: '0' })]),
            h('td', { class: 'muted', text: r.note || '—' }),
          ]))),
        ]),
        h('p', { class: 'muted', text:
          'Записи, ждущие отправки, лежат в местном буфере рядом с объектом и '
          + 'дойдут, когда связь вернётся. «Потеряно» отлично от нуля бывает '
          + 'только у зеркала: его очередь ограничена, и при долгой пропаже '
          + 'связи старейшие строки выбрасываются — своё хранилище их сохранило.' }),
      );
    })();

    // Шифрование интерфейса. Раздел `web` уже объявлен выше — берём его же,
    // а не заводим второй: два взгляда на один раздел однажды разойдутся.
    const wtls = web.tls || (web.tls = {});
    const tlsOn = h('input', { type: 'checkbox' });
    tlsOn.checked = !!wtls.enabled;
    tlsOn.onchange = () => { wtls.enabled = tlsOn.checked; draw2(); };
    const tlsOwn = h('input', { type: 'checkbox' });
    tlsOwn.checked = wtls.self_signed !== false;
    tlsOwn.onchange = () => { wtls.self_signed = tlsOwn.checked; };
    const tlsCert = h('input', { class: 'wide', placeholder: 'рядом с каталогом данных',
      value: wtls.cert_file || '', oninput: (e) => { wtls.cert_file = e.target.value; } });
    const tlsKey = h('input', { class: 'wide', placeholder: 'рядом с каталогом данных',
      value: wtls.key_file || '', oninput: (e) => { wtls.key_file = e.target.value; } });
    const tlsNames = h('input', { class: 'wide', placeholder: 'ibolid.local, 10.0.0.5',
      value: (wtls.names || []).join(', '),
      oninput: (e) => {
        wtls.names = e.target.value.split(',').map((n) => n.trim()).filter(Boolean);
      } });
    for (const field of [tlsOn, tlsOwn, tlsCert, tlsKey, tlsNames]) field.disabled = !editable;

    const archive = doc.archive || (doc.archive = {});
    // Пустое значение — «вид не задан». Это **не то же**, что «sqlite»: объект
    // без заданного вида, у которого рядом лежит файл встроенной базы,
    // продолжает работать с ней. Записать сюда «sqlite» за наладчика значило бы
    // молча увести объект от уже накопленной истории.
    const STORAGE = [
      ['', 'как принято — SQLite (либо прежняя встроенная база, если она есть)'],
      ['sqlite', 'SQLite — файл, читаемый посторонними средствами'],
      ['embedded', 'встроенная база — файл рядом с объектом'],
      ['postgres', 'внешняя PostgreSQL либо TimescaleDB'],
      ['influx', 'база временных рядов — InfluxDB, VictoriaMetrics, QuestDB'],
    ];
    const STORAGE_NOTE = {
      '': 'Вид хранилища не задан. Новый объект получит SQLite. Объект, у '
        + 'которого рядом уже лежит файл встроенной базы, продолжит работать с '
        + 'ней — историю не бросают из-за смены умолчания.',
      sqlite: 'Файл на каждую линию. Принят по умолчанию: архив открывается из '
        + '1С, из Excel, из запроса наладчика — не спрашивая программу.',
      embedded: 'Файл на каждую линию, рядом с настройкой объекта. Быстрейший '
        + 'из всех, ничего не требует от машины и переносится вместе с папкой '
        + 'проекта. Формат знает только программа.',
      postgres: 'Ряд лежит не на объекте, а в общей базе. Историю нескольких '
        + 'объектов видно вместе, за сохранность отвечает служба баз данных. '
        + 'Взамен объект зависит от сети — потому и держит местный буфер: пока '
        + 'база недоступна, записи ложатся в файл рядом с объектом и доходят, '
        + 'когда связь вернётся.',
      influx: 'База временных рядов — сам архив: тренды и ведомости читаются из '
        + 'неё. Не путать с зеркалом ниже: зеркало односторонне и оставляет ряд '
        + 'у себя. Местный буфер на время обрыва здесь тот же.',
    };
    const MODES = [
      ['combined', 'по изменению, но не реже и не чаще заданного'],
      ['on_change', 'только по изменению сверх допуска'],
      ['periodic', 'периодически, независимо от изменений'],
    ];
    const storage = selectInput(STORAGE, archive.storage || '', (v) => {
      // Пустое значение убирает ключ, а не пишет пустую строку: разбор
      // настройки различает «не задано» и «задано».
      if (v) archive.storage = v;
      else delete archive.storage;
      draw2();
    });
    const mode = selectInput(MODES, archive.mode || 'combined', (v) => { archive.mode = v; });
    const period = h('input', { type: 'number', min: '1', value: String(archive.period_sec ?? 5),
      oninput: (e) => { archive.period_sec = Number(e.target.value) || 1; } });
    const minGap = h('input', { type: 'number', min: '0', value: String(archive.min_interval_sec ?? 0),
      oninput: (e) => { archive.min_interval_sec = Number(e.target.value) || 0; } });
    const maxGap = h('input', { type: 'number', min: '0', value: String(archive.max_interval_sec ?? 60),
      oninput: (e) => { archive.max_interval_sec = Number(e.target.value) || 0; } });
    const tolerance = h('input', { type: 'number', min: '0', step: 'any',
      value: String(archive.tolerance ?? 0),
      oninput: (e) => { archive.tolerance = Number(e.target.value) || 0; } });
    const keep = h('input', { type: 'number', min: '1', value: String(archive.keep_days ?? 1095),
      oninput: (e) => { archive.keep_days = Number(e.target.value) || 1; } });
    for (const field of [storage, mode, period, minGap, maxGap, tolerance, keep]) {
      field.disabled = !editable;
    }

    // Подключение к внешней базе. Раздел показывается только при выбранном
    // внешнем хранилище: занимать место под настройку, которая не действует,
    // значит заставлять читать её вхолостую.
    const pg = archive.postgres || (archive.postgres = {});
    const pgDsn = h('input', { class: 'wide', placeholder: 'host=10.0.0.5 user=ibolid password=… dbname=archive',
      value: pg.dsn || '', oninput: (e) => { pg.dsn = e.target.value; } });
    const pgTable = h('input', { value: pg.table || 'ib_archive',
      oninput: (e) => { pg.table = e.target.value; } });
    const pgHyper = h('input', { type: 'checkbox' });
    pgHyper.checked = pg.hypertable !== false;
    pgHyper.onchange = () => { pg.hypertable = pgHyper.checked; };
    const pgWait = h('input', { type: 'number', min: '1', value: String(pg.connect_timeout_sec ?? 10),
      oninput: (e) => { pg.connect_timeout_sec = Number(e.target.value) || 1; } });
    const pgRetry = h('input', { type: 'number', min: '0', value: String(pg.reconnect_pause_sec ?? 30),
      oninput: (e) => { pg.reconnect_pause_sec = Number(e.target.value) || 0; } });
    for (const field of [pgDsn, pgTable, pgHyper, pgWait, pgRetry]) field.disabled = !editable;

    // Подключение к базе временных рядов.
    const inf = archive.influx || (archive.influx = {});
    const INFLUX_API = [
      ['v1', 'InfluxDB 1.x, VictoriaMetrics, QuestDB'],
      ['v2', 'InfluxDB 2.x'],
    ];
    const infUrl = h('input', { class: 'wide', placeholder: 'http://10.0.0.5:8086',
      value: inf.url || '', oninput: (e) => { inf.url = e.target.value; } });
    const infApi = selectInput(INFLUX_API, inf.api || 'v1', (v) => { inf.api = v; draw2(); });
    const infDb = h('input', { value: inf.database || 'ibolid',
      oninput: (e) => { inf.database = e.target.value; } });
    const infOrg = h('input', { value: inf.org || '',
      oninput: (e) => { inf.org = e.target.value; } });
    const infBucket = h('input', { value: inf.bucket || '',
      oninput: (e) => { inf.bucket = e.target.value; } });
    const infToken = h('input', { type: 'password', value: inf.token || '',
      oninput: (e) => { inf.token = e.target.value; } });
    const infMeas = h('input', { value: inf.measurement || 'ibolid',
      oninput: (e) => { inf.measurement = e.target.value; } });
    const infWait = h('input', { type: 'number', min: '1', value: String(inf.connect_timeout_sec ?? 10),
      oninput: (e) => { inf.connect_timeout_sec = Number(e.target.value) || 1; } });
    const infRetry = h('input', { type: 'number', min: '0', value: String(inf.reconnect_pause_sec ?? 30),
      oninput: (e) => { inf.reconnect_pause_sec = Number(e.target.value) || 0; } });
    for (const field of [infUrl, infApi, infDb, infOrg, infBucket, infToken, infMeas,
      infWait, infRetry]) {
      field.disabled = !editable;
    }

    // Зеркало прикладывается к любому хранилищу, потому и стоит отдельно от
    // выбора хранилища, а не среди его видов.
    const mirrorOn = h('input', { type: 'checkbox' });
    mirrorOn.checked = !!archive.mirror;
    mirrorOn.disabled = !editable;
    mirrorOn.onchange = () => {
      if (mirrorOn.checked) {
        archive.mirror = archive.mirror || { api: 'v1', database: 'ibolid', measurement: 'ibolid' };
      } else {
        // Снятая птичка убирает раздел целиком: оставленный пустой раздел
        // отвергается при запуске, и объект не поднялся бы.
        delete archive.mirror;
      }
      draw2();
    };
    const mir = archive.mirror || {};
    const MIRROR_API = [
      ['v1', 'InfluxDB 1.x, VictoriaMetrics, QuestDB, Telegraf'],
      ['v2', 'InfluxDB 2.x'],
    ];
    const mirUrl = h('input', { class: 'wide', placeholder: 'http://10.0.0.5:8086',
      value: mir.url || '', oninput: (e) => { mir.url = e.target.value; } });
    const mirApi = selectInput(MIRROR_API, mir.api || 'v1', (v) => { mir.api = v; draw2(); });
    const mirDb = h('input', { value: mir.database || 'ibolid',
      oninput: (e) => { mir.database = e.target.value; } });
    const mirOrg = h('input', { value: mir.org || '',
      oninput: (e) => { mir.org = e.target.value; } });
    const mirBucket = h('input', { value: mir.bucket || '',
      oninput: (e) => { mir.bucket = e.target.value; } });
    const mirToken = h('input', { type: 'password', value: mir.token || '',
      oninput: (e) => { mir.token = e.target.value; } });
    const mirMeas = h('input', { value: mir.measurement || 'ibolid',
      oninput: (e) => { mir.measurement = e.target.value; } });
    for (const field of [mirUrl, mirApi, mirDb, mirOrg, mirBucket, mirToken, mirMeas]) {
      field.disabled = !editable;
    }

    /** Ступени прореживания: срок и разрешение. */
    function thinningTable() {
      const steps = archive.thinning || [];
      const RES = [['raw', 'не прореживать'], ['minute', 'по минутам'],
        ['hour', 'по часам'], ['day', 'по суткам'], ['week', 'по неделям']];
      return h('table', { class: 'grid' }, [
        h('thead', {}, [h('tr', {}, ['старше, суток', 'разрешение', ''].map((t) => h('th', { text: t })))]),
        h('tbody', {}, steps.length ? steps.map((step, i) => h('tr', {}, [
          h('td', {}, [h('input', { type: 'number', min: '0', disabled: !editable,
            value: String(step.older_than_days ?? 0),
            oninput: (e) => { step.older_than_days = Number(e.target.value) || 0; } })]),
          h('td', {}, [selectInput(RES, step.resolution || 'hour', (v) => { step.resolution = v; })]),
          h('td', {}, [editable
            ? h('button', { class: 'small', text: 'убрать',
                onclick: () => { steps.splice(i, 1); draw2(); } })
            : h('span', { class: 'muted', text: '—' })]),
        ])) : [h('tr', {}, [h('td', { class: 'muted', colspan: '3', text: 'как принято в подсистеме' })])]),
      ]);
    }

    async function save() {
      // Читаем заново: между открытием экрана и нажатием могли править
      // приборы, и записать здешний слепок значило бы стереть ту правку.
      let fresh;
      try {
        fresh = JSON.parse((await api.config()).text);
      } catch (e) { reportError(e); return; }
      fresh.gateway = fresh.gateway || {};
      fresh.web = fresh.web || {};
      fresh.gateway.instance_name = name.value.trim();
      fresh.gateway.instance = Number(instance.value) || 1;
      fresh.web.enabled = enabled.checked;
      fresh.web.bind = bind.value.trim() || 'local';
      fresh.web.port = Number(port.value) || 8080;
      // Шифрование правится как один документ: склеивать его по полям значило
      // бы однажды записать половину — включённое шифрование без сертификата.
      fresh.web.tls = wtls;
      // Архив пишется целиком: раздел правится как один документ, и склеивать
      // его по полям значило бы однажды записать половину.
      fresh.archive = archive;
      try {
        await api.saveConfig(JSON.stringify(fresh, null, 2));
        toast('записано; действует после перезапуска службы', 'ok');
        await draw();
      } catch (e) { reportError(e); }
    }

    const shown = (bind.value || 'local').trim();
    const local = ['local', 'localhost', '127.0.0.1', ''].includes(shown);
    const anywhere = ['any', 'all', '0.0.0.0', '*'].includes(shown);

    form.replaceChildren(...[
      h('h2', { text: 'Объект' }),
      h('div', { class: 'toolbar' }, [
        h('label', { text: 'Имя' }), name,
        h('label', { text: 'Номер экземпляра' }), instance,
      ]),
      h('p', { class: 'muted', text:
        'Номер различает несколько объектов на одном посту: служба Windows у '
        + 'первого зовётся «ibolid», у остальных — «ibolid-N», и запись '
        + 'автозапуска у каждого своя. Порт номером не подменяется — его '
        + 'задают здесь же, ниже.' }),

      h('h2', { text: 'Доступ к визуализации' }),
      h('div', { class: 'toolbar' }, [
        h('label', {}, [enabled, ' поднимать веб-интерфейс']),
      ]),
      enabled.checked === false ? null : h('div', {}, [
        h('div', { class: 'toolbar' }, [
          h('label', { text: 'Адрес' }), bind,
          h('button', { class: 'small', text: '127.0.0.1', title: 'только с этой машины',
            onclick: () => { bind.value = '127.0.0.1'; draw2(); } }),
          h('button', { class: 'small', text: '0.0.0.0', title: 'на всех сетевых платах',
            onclick: () => { bind.value = '0.0.0.0'; draw2(); } }),
          h('label', { text: 'Порт' }), port,
        ]),
        h('p', { class: 'muted', text:
          local ? 'Интерфейс будет доступен только с этой машины.'
                : anywhere ? 'Интерфейс будет доступен со всех сетевых плат.'
                : 'Интерфейс будет слушать только этот адрес.' }),
        h('h3', { text: 'Шифрование' }),
        h('div', { class: 'toolbar' }, [
          h('label', { text: 'Шифровать соединение' }), tlsOn,
        ]),
        h('p', { class: 'muted', text:
          'Без шифрования пароль при входе и пропуск сеанса идут по проводу в '
          + 'открытом виде: кто угодно на пути читает их целиком и входит под '
          + 'тем же именем. На щите в одной комнате с оператором это терпимо, '
          + 'через сеть предприятия — нет.' }),
        wtls.enabled ? h('div', { class: 'cfg-block' }, [
          h('div', { class: 'toolbar' }, [
            h('label', { text: 'Создать свой сертификат, если файлов нет' }), tlsOwn,
          ]),
          h('div', { class: 'toolbar' }, [
            h('label', { text: 'Сертификат' }), tlsCert,
          ]),
          h('div', { class: 'toolbar' }, [
            h('label', { text: 'Ключ' }), tlsKey,
          ]),
          h('div', { class: 'toolbar' }, [
            h('label', { text: 'Имена объекта' }), tlsNames,
          ]),
          h('p', { class: 'muted', text:
            'Пусто — сертификат и ключ берутся рядом с каталогом данных. Имена '
            + 'записываются в свой сертификат латиницей: кириллическое имя в '
            + 'него не попадёт, и обращаться придётся по адресу.' }),
          h('p', { class: 'warn-line', text:
            'Свой сертификат браузер не знает и предупредит о нём. Отпечаток '
            + 'печатается при запуске службы — сверьте его и только тогда '
            + 'принимайте: иначе «принять риск» означает принять и подменённый '
            + 'объект, если он на пути.' }),
        ]) : null,

        anywhere || !local ? h('p', { class: 'warn-line', text:
          'Пока учётных записей нет, вход не требуется вовсе: любой, кто видит '
          + 'этот адрес, получает полные права.' }) : null,
      ].filter(Boolean)),

      h('h2', { text: 'Архив' }),
      health,
      h('p', { class: 'muted', text:
        'Временной ряд, из которого строятся тренды, журналы учёта и счета. '
        + 'Прежде эти настройки существовали только в коде: наладчик, задавший '
        + 'суточный период, получал пятисекундный — и узнавал об этом по '
        + 'размеру файла.' }),
      h('div', { class: 'toolbar' }, [
        h('label', { text: 'Хранилище' }), storage,
        h('label', { text: 'Когда писать' }), mode,
      ]),
      h('p', { class: 'muted', text: STORAGE_NOTE[archive.storage || 'embedded'] }),

      archive.storage === 'postgres' ? h('div', { class: 'cfg-block' }, [
        h('h3', { text: 'Подключение к базе' }),
        h('div', { class: 'toolbar' }, [
          h('label', { text: 'Строка подключения' }), pgDsn,
        ]),
        h('div', { class: 'toolbar' }, [
          h('label', { text: 'Таблица' }), pgTable,
          h('label', { text: 'Разбивка по суткам (TimescaleDB)' }), pgHyper,
          h('label', { text: 'Ждать подключения, с' }), pgWait,
          h('label', { text: 'Повтор не чаще, с' }), pgRetry,
        ]),
        h('p', { class: 'muted', text:
          'Разные объекты в одной базе — разные таблицы. Разбивка по суткам '
          + 'работает, если в базе есть TimescaleDB; нет — таблица останется '
          + 'обычной, и это не помеха.' }),
        h('p', { class: 'warn-line', text:
          'Подключение идёт без шифрования: рассчитано на базу внутри той же '
          + 'сети. Через внешние сети заворачивайте в туннель. Настройку с '
          + 'sslmode=require объект отвергнет, а не подключится втихую в '
          + 'открытом виде.' }),
      ]) : null,

      archive.storage === 'influx' ? h('div', { class: 'cfg-block' }, [
        h('h3', { text: 'Подключение к базе временных рядов' }),
        h('div', { class: 'toolbar' }, [
          h('label', { text: 'Адрес' }), infUrl,
          h('label', { text: 'Вид обращения' }), infApi,
        ]),
        h('div', { class: 'toolbar' }, (inf.api === 'v2' ? [
          h('label', { text: 'Организация' }), infOrg,
          h('label', { text: 'Ведро' }), infBucket,
        ] : [
          h('label', { text: 'База' }), infDb,
        ]).concat([
          h('label', { text: 'Измерение' }), infMeas,
          h('label', { text: 'Пропуск' }), infToken,
        ])),
        h('div', { class: 'toolbar' }, [
          h('label', { text: 'Ждать подключения, с' }), infWait,
          h('label', { text: 'Повтор не чаще, с' }), infRetry,
        ]),
        h('p', { class: 'muted', text:
          'Выборка вытягивает записи окна и сводит их тем же кодом, что и для '
          + 'прочих хранилищ: числа в ведомости не зависят от вида хранилища. '
          + 'Платой становится объём — месяц секундного ряда идёт по сети '
          + 'целиком, поэтому прореживание здесь особенно уместно.' }),
        h('p', { class: 'warn-line', text:
          'Пропуск по открытому http виден в сети целиком. Объект с пропуском и '
          + 'незашифрованным адресом к запуску не примут: укажите адрес с https '
          + 'либо уберите пропуск.' }),
      ]) : null,

      h('h3', { text: 'Зеркало в базу временных рядов' }),
      h('div', { class: 'toolbar' }, [
        h('label', { text: 'Отправлять копию наружу' }), mirrorOn,
      ]),
      h('p', { class: 'muted', text:
        'Записи дополнительно уходят во внешнюю базу — InfluxDB, '
        + 'VictoriaMetrics, QuestDB, Telegraf. Читает объект по-прежнему из '
        + 'своего архива: зеркало одностороннее. Прикладывается к любому '
        + 'хранилищу.' }),
      archive.mirror ? h('div', { class: 'cfg-block' }, [
        h('div', { class: 'toolbar' }, [
          h('label', { text: 'Адрес' }), mirUrl,
          h('label', { text: 'Вид обращения' }), mirApi,
        ]),
        h('div', { class: 'toolbar' }, (mir.api === 'v2' ? [
          h('label', { text: 'Организация' }), mirOrg,
          h('label', { text: 'Ведро' }), mirBucket,
        ] : [
          h('label', { text: 'База' }), mirDb,
        ]).concat([
          h('label', { text: 'Измерение' }), mirMeas,
          h('label', { text: 'Пропуск' }), mirToken,
        ])),
      ]) : null,

      h('div', { class: 'toolbar' }, [
        h('label', { text: 'Период, с' }), period,
        h('label', { text: 'Не чаще, с' }), minGap,
        h('label', { text: 'Не реже, с' }), maxGap,
        h('label', { text: 'Допуск' }), tolerance,
      ]),
      h('p', { class: 'muted', text:
        '«Не реже» — контрольная точка: по ней видно, что объект работал и '
        + 'величина не менялась. Без неё спокойные сутки выглядят в архиве '
        + 'провалом. Допуск ноль — берётся зона нечувствительности тега.' }),
      h('div', { class: 'toolbar' }, [
        h('label', { text: 'Хранить, суток' }), keep,
      ]),
      h('h3', { text: 'Прореживание' }),
      h('p', { class: 'muted', text:
        'Данные старше указанного срока сводятся к разрешению: секундный ряд '
        + 'за три года никому не нужен, а часовой за три года — нужен. Ступени '
        + 'задаются по возрастанию срока; пусто — как принято в подсистеме '
        + '(сутки по минутам, месяц по часам, дальше по суткам).' }),
      thinningTable(),
      h('div', { class: 'toolbar' }, [
        h('button', { text: 'добавить ступень', onclick: () => {
          (archive.thinning = archive.thinning || []).push({ older_than_days: 30, resolution: 'hour' });
          draw2();
        } }),
      ]),

      editable ? h('div', { class: 'toolbar' }, [
        h('button', { class: 'primary', text: 'записать', onclick: () => save().catch(reportError) }),
      ]) : h('p', { class: 'muted', text: 'правка доступна инженеру и выше' }),
      h('p', { class: 'muted', text:
        'Адрес, порт и номер экземпляра действуют после перезапуска службы. '
        + 'Два объекта на одном порту не поднимаются: второй откажется '
        + 'запускаться и скажет почему.' }),
    ].filter(Boolean));

    // Кнопки адреса меняют пояснение под полем: набранное переносим в
    // документ и рисуем заново, ничего не теряя.
    function draw2() {
      gateway.instance_name = name.value;
      gateway.instance = Number(instance.value) || 1;
      web.bind = bind.value;
      web.port = Number(port.value) || 8080;
      web.enabled = enabled.checked;
      draw(doc).catch(reportError);
    }
  }

  draw().catch(reportError);
  return {};
}

/**
 * Экран «Журналы учёта» (ТЗ 11.10).
 *
 * Журнал учёта ведётся не ради значений — значения и так в архиве. Он ведётся
 * ради **подписи**: человек утверждает, что сутки видел и принял. Поэтому
 * первое, что показывает экран, — сколько суток не подписано, а не таблица.
 *
 * Значения приходят из архива при каждом открытии; в журнале хранится подпись
 * со снимком значений на момент, когда её ставили. Перегенерация архива
 * подписанный документ не меняет, а расхождение показывается признаком.
 */
async function reports({ host, toast, reportError, hasRole }) {
  const list = h('div', {});
  const sheet = h('div', { class: 'cfg-block' });
  let journals = [];
  let operators = [];
  let current = null;
  const now = new Date();
  let year = now.getFullYear();
  let month = now.getMonth() + 1;

  host.replaceChildren(
    h('h1', { text: 'Журналы учёта' }),
    h('p', { class: 'hint', text:
      'Суточная ведомость с подписью оператора. Значения берутся из архива при '
      + 'каждом открытии; подпись хранит снимок значений на момент подписи — '
      + 'перегенерация архива подписанный документ не меняет.' }),
    list,
    sheet,
  );

  const MONTHS = ['январь', 'февраль', 'март', 'апрель', 'май', 'июнь', 'июль',
    'август', 'сентябрь', 'октябрь', 'ноябрь', 'декабрь'];

  /** Значение колонки в виде, пригодном для чтения. */
  function cell(value, column) {
    if (value === null || value === undefined) return '—';
    const text = Number(value).toFixed(column.decimals ?? 2);
    return column.units ? `${text} ${column.units}` : text;
  }

  async function drawList() {
    try {
      [journals, operators] = await Promise.all([api.reports(), api.reportOperators()]);
    } catch (e) {
      list.replaceChildren(h('p', { class: 'warn-line', text:
        'журналы недоступны: ' + (e && e.message ? e.message : e) }));
      return;
    }
    if (!journals.length) {
      list.replaceChildren(
        h('p', { class: 'empty', text: 'Журналов учёта не заведено.' }),
        hasRole('engineer')
          ? h('p', { class: 'muted', text:
              'Завести журнал можно ниже: имя, колонки по тегам и признак '
              + 'обязательной суточной подписи.' })
          : h('p', { class: 'muted', text: 'заводит журналы инженер и выше' }),
      );
      if (hasRole('engineer')) list.append(newJournalForm());
      return;
    }
    list.replaceChildren(...journals.map(journalCard),
      ...(hasRole('engineer') ? [newJournalForm()] : []));
  }

  /** Карточка журнала: имя, колонки и — главное — сколько не подписано. */
  function journalCard(journal) {
    const overdue = journal.overdue || [];
    return h('div', { class: 'cfg-block' }, [
      h('div', { class: 'toolbar' }, [
        h('h2', { text: journal.name || journal.id }),
        h('span', { class: 'spacer' }),
        h('button', { class: 'primary', text: 'открыть месяц',
          onclick: () => { current = journal; drawSheet().catch(reportError); } }),
        hasRole('engineer')
          ? h('button', { text: 'убрать', onclick: () => remove(journal.id) })
          : null,
      ].filter(Boolean)),
      overdue.length
        ? h('p', { class: 'warn-line', text:
            `не подписано рабочих суток: ${overdue.length} — ${overdue.slice(0, 8).join(', ')}`
            + (overdue.length > 8 ? ' …' : '') })
        : h('p', { class: 'muted', text: journal.require_signature
            ? 'просроченных подписей нет' : 'подпись не требуется' }),
      h('p', { class: 'muted', text:
        'колонки: ' + journal.columns.map((c) => `${c.title} (${c.kind})`).join(', ') }),
    ]);
  }

  async function remove(id) {
    if (!confirm(`Убрать журнал «${id}» из перечня?\n\n`
      + 'Подписанные сутки останутся на диске: подпись — документ.')) return;
    try {
      toast(await api.reportRemove(id), 'ok');
      if (current && current.id === id) { current = null; sheet.replaceChildren(); }
      await drawList();
    } catch (e) { reportError(e); }
  }

  /** Месячная ведомость выбранного журнала. */
  async function drawSheet() {
    if (!current) { sheet.replaceChildren(); return; }
    let report;
    try {
      report = await api.reportMonth(current.id, year, month);
    } catch (e) {
      sheet.replaceChildren(h('p', { class: 'warn-line', text:
        'месяц не открыт: ' + (e && e.message ? e.message : e) }));
      return;
    }

    const operator = h('select', {});
    for (const o of operators.filter((o) => o.active)) {
      operator.append(h('option', { value: o.id, text: o.short_name + (o.position ? `, ${o.position}` : '') }));
    }
    const batch = h('input', { type: 'checkbox' });

    const head = h('tr', {}, [
      h('th', { text: 'сутки' }),
      ...report.columns.map((c) => h('th', { text: c.title })),
      h('th', { text: 'подпись' }),
    ]);

    const rows = report.days.map((day) => {
      const signed = Boolean(day.signed_by);
      const canSign = hasRole('operator') && !signed && operators.some((o) => o.active);
      return h('tr', { class: day.working ? '' : 'muted' }, [
        h('td', { class: 'mono', text: day.date + (day.working ? '' : ' (нерабочий)') }),
        ...report.columns.map((c) => h('td', { class: 'mono', text: cell(day.values[c.key], c) })),
        h('td', {}, [
          signed
            ? h('span', {}, [
                day.signed_by + (day.batch ? ' (пакетно)' : ''),
                day.snapshot_differs
                  ? h('span', { class: 'warn-line',
                      title: 'архив пересчитан после подписи; подписанный снимок не изменён',
                      text: ' — значения разошлись со снимком' })
                  : null,
              ].filter(Boolean))
            : canSign
              ? h('button', { class: 'small', text: 'подписать',
                  onclick: () => sign(day.date, operator.value, batch.checked) })
              : h('span', { class: 'muted', text: '—' }),
        ]),
      ]);
    });

    sheet.replaceChildren(...[
      h('div', { class: 'toolbar' }, [
        h('h2', { text: `${report.journal}: ${MONTHS[month - 1]} ${year}` }),
        h('span', { class: 'spacer' }),
        h('button', { text: '‹ предыдущий', onclick: () => shift(-1) }),
        h('button', { text: 'следующий ›', onclick: () => shift(1) }),
        h('button', { text: 'печатная форма', onclick: () => showPrintable(report) }),
        h('button', { text: 'закрыть', onclick: () => { current = null; sheet.replaceChildren(); } }),
      ]),
      report.days.length
        ? h('table', { class: 'grid' }, [h('thead', {}, [head]), h('tbody', {}, rows)])
        : h('p', { class: 'empty', text: 'за этот месяц данных в архиве нет' }),
      h('p', { class: 'muted', text: `подписано суток: ${report.signed_days} из ${report.days.length}` }),
      hasRole('operator') && operators.some((o) => o.active)
        ? h('div', { class: 'toolbar' }, [
            h('label', { text: 'подписывает' }), operator,
            h('label', {}, [batch, ' закрыть заодно предшествующие нерабочие сутки']),
          ])
        : h('p', { class: 'muted', text: operators.length
            ? 'подписывает оператор и выше'
            : 'операторы не заведены: подписывать некому' }),
    ].filter(Boolean));
  }

  function shift(step) {
    month += step;
    if (month < 1) { month = 12; year -= 1; }
    if (month > 12) { month = 1; year += 1; }
    drawSheet().catch(reportError);
  }

  async function sign(date, operatorId, batchMode) {
    if (!operatorId) { toast('выберите, кто подписывает', 'warn'); return; }
    try {
      toast(await api.reportSign(current.id, date, operatorId, batchMode), 'ok');
      await drawSheet();
      await drawList();
    } catch (e) { reportError(e); }
  }

  /** Печатная форма — текстом, как её увидит проверяющий. */
  function showPrintable(report) {
    modal({
      title: `${report.journal}: ${MONTHS[report.month - 1]} ${report.year}`,
      body: h('div', {}, [
        h('p', { class: 'muted', text:
          'Форма с обязательными реквизитами. Выделите и скопируйте либо '
          + 'напечатайте страницу.' }),
        h('pre', { class: 'mono', text: report.printable }),
      ]),
      confirmText: 'Закрыть',
      cancelText: 'Отмена',
      onConfirm: () => {},
    });
  }

  /** Заведение журнала: имя и колонки по тегам. */
  function newJournalForm() {
    const id = h('input', { type: 'text', placeholder: 'краткое имя, латиницей либо кириллицей' });
    const name = h('input', { type: 'text', placeholder: 'Суточная ведомость цеха' });
    const tags = h('input', { type: 'text', style: 'width:min(520px,100%)',
      placeholder: 'теги через запятую: цех-1.дат-1.t, цех-1.дат-2.p' });
    const kind = selectInput([
      ['среднее', 'среднее за сутки'],
      ['минимум', 'минимум за сутки'],
      ['максимум', 'максимум за сутки'],
      ['недостоверно', 'доля недостоверного'],
    ], 'среднее', () => {});
    const need = h('input', { type: 'checkbox' });
    need.checked = true;

    return h('div', { class: 'cfg-block' }, [
      h('h2', { text: 'Завести журнал' }),
      h('div', { class: 'toolbar' }, [h('label', { text: 'Имя' }), id, h('label', { text: 'Заголовок' }), name]),
      h('div', { class: 'toolbar' }, [h('label', { text: 'Теги' }), tags]),
      h('div', { class: 'toolbar' }, [
        h('label', { text: 'Колонка' }), kind,
        h('label', {}, [need, ' требуется суточная подпись']),
        h('button', { class: 'primary', text: 'завести', onclick: () => create() }),
      ]),
      h('p', { class: 'muted', text:
        'По колонке на тег. Значения берутся из суточных сводок архива: тег, '
        + 'которого в архиве нет, даст пустые сутки.' }),
    ]);

    async function create() {
      const list = tags.value.split(',').map((t) => t.trim()).filter(Boolean);
      if (!id.value.trim()) { toast('у журнала должно быть имя', 'warn'); return; }
      if (!list.length) { toast('укажите хотя бы один тег', 'warn'); return; }
      try {
        toast(await api.reportSave({
          id: id.value.trim(),
          name: name.value.trim() || id.value.trim(),
          require_signature: need.checked,
          columns: list.map((tag) => ({
            key: '', tag, title: tag, kind: kind.value, units: '', decimals: 2,
          })),
        }), 'ok');
        await drawList();
      } catch (e) { reportError(e); }
    }
  }

  await drawList();
  return {};
}

/**
 * Экран «Начисления» (ТЗ 11.12–11.14).
 *
 * Счётчик воды, тепла или электричества уже опрашивается — значения в архиве.
 * Расстояние отсюда до счёта абоненту невелико, а делают его обычно вручную,
 * раз в месяц, переписывая показания в таблицу.
 *
 * Считать по архиву не то же, что вычесть два числа: счётчик переполняется,
 * счётчик меняют, архив прерывается. Ни один из этих случаев не решается
 * догадкой — что известно, начисляется; что неизвестно, называется прямо в
 * счёте строкой «требует разбора».
 */
async function billing({ host, toast, reportError, hasRole }) {
  const setupBlock = h('div', { class: 'cfg-block' });
  const invoiceBlock = h('div', { class: 'cfg-block' });
  let setup = { subscribers: [], tariffs: [], points: [] };

  host.replaceChildren(
    h('h1', { text: 'Начисления' }),
    h('p', { class: 'hint', text:
      'Счета по счётчикам и по времени работы. Расход считается по разности '
      + 'показаний из архива; время работы — по признаку «включено». То, что не '
      + 'наблюдалось, не начисляется, а называется в счёте.' }),
    setupBlock,
    invoiceBlock,
  );

  if (!hasRole('engineer')) {
    setupBlock.replaceChildren(h('p', { class: 'empty', text:
      'начисления доступны инженеру и выше: в тарифах цена, а по ней выставляют счета' }));
    return {};
  }

  const KINDS = [['meter', 'счётчик нарастающим итогом'], ['runtime', 'время работы']];

  await load();

  async function load() {
    try {
      setup = await api.billingSetup();
    } catch (e) {
      setupBlock.replaceChildren(h('p', { class: 'warn-line', text:
        'справочники недоступны: ' + (e && e.message ? e.message : e) }));
      return;
    }
    drawSetup();
    drawInvoice();
  }

  function drawSetup() {
    setupBlock.replaceChildren(
      h('h2', { text: 'Справочники' }),
      h('h3', { text: 'Абоненты' }),
      table(['имя', 'название', 'связь', ''], (setup.subscribers || []).map((s, i) => [
        text(s, 'id'), text(s, 'name'), text(s, 'contact'),
        drop(() => { setup.subscribers.splice(i, 1); drawSetup(); }),
      ])),
      add('добавить абонента', () => {
        setup.subscribers.push({ id: '', name: '', contact: '' });
        drawSetup();
      }),

      h('h3', { text: 'Тарифы' }),
      h('p', { class: 'muted', text:
        'Цена — в рублях за единицу. Деньги считаются целыми копейками: дробные '
        + 'числа на большом счёте разъезжаются с итогом на рубли.' }),
      table(['имя', 'название', 'единица', 'цена', 'НДС, %', 'за пуск', ''],
        (setup.tariffs || []).map((t, i) => [
          text(t, 'id'), text(t, 'name'), text(t, 'unit'),
          rubles(t, 'price_kopeks'), number(t, 'vat_percent'), rubles(t, 'start_kopeks'),
          drop(() => { setup.tariffs.splice(i, 1); drawSetup(); }),
        ])),
      add('добавить тариф', () => {
        setup.tariffs.push({ id: '', name: '', unit: 'м³', price_kopeks: 0, vat_percent: 0, start_kopeks: 0 });
        drawSetup();
      }),

      h('h3', { text: 'Точки учёта' }),
      table(['имя', 'название', 'тег', 'что считаем', 'тариф', 'абонент', ''],
        (setup.points || []).map((p, i) => [
          text(p, 'id'), text(p, 'name'), text(p, 'tag'),
          selectInput(KINDS, p.kind || 'meter', (v) => { p.kind = v; }),
          selectInput((setup.tariffs || []).map((t) => [t.id, t.name || t.id]), p.tariff, (v) => { p.tariff = v; }),
          selectInput((setup.subscribers || []).map((s) => [s.id, s.name || s.id]), p.subscriber, (v) => { p.subscriber = v; }),
          drop(() => { setup.points.splice(i, 1); drawSetup(); }),
        ])),
      add('добавить точку учёта', () => {
        setup.points.push({
          id: '', name: '', tag: '', kind: 'meter',
          tariff: (setup.tariffs[0] || {}).id || '',
          subscriber: (setup.subscribers[0] || {}).id || '',
        });
        drawSetup();
      }),

      h('div', { class: 'toolbar' }, [
        h('button', { class: 'primary', text: 'записать справочники', onclick: () => save() }),
      ]),
      h('p', { class: 'muted', text:
        'У счётчика можно задать потолок (`meter.capacity`) — тогда переход через '
        + 'него считается переполнением, а не заменой. Без потолка любое падение '
        + 'показаний останавливает начисление и выносится в счёт.' }),
    );
  }

  function table(head, rows) {
    return h('table', { class: 'grid' }, [
      h('thead', {}, [h('tr', {}, head.map((t) => h('th', { text: t })))]),
      h('tbody', {}, rows.length
        ? rows.map((cells) => h('tr', {}, cells.map((c) => h('td', {}, [c]))))
        : [h('tr', {}, [h('td', { class: 'muted', text: 'пусто' })])]),
    ]);
  }

  function text(object, field) {
    return h('input', { type: 'text', value: object[field] || '',
      oninput: (e) => { object[field] = e.target.value; } });
  }

  function number(object, field) {
    return h('input', { type: 'number', min: '0', value: String(object[field] ?? 0),
      oninput: (e) => { object[field] = Number(e.target.value) || 0; } });
  }

  /** Цена показывается рублями, а хранится копейками. */
  function rubles(object, field) {
    return h('input', { type: 'number', min: '0', step: '0.01',
      value: ((object[field] ?? 0) / 100).toFixed(2),
      oninput: (e) => { object[field] = Math.round(Number(e.target.value) * 100) || 0; } });
  }

  function drop(onclick) {
    return h('button', { class: 'small', text: 'убрать', onclick });
  }

  function add(label, onclick) {
    return h('div', { class: 'toolbar' }, [h('button', { text: label, onclick })]);
  }

  async function save() {
    try {
      toast(await api.billingSave(setup), 'ok');
      await load();
    } catch (e) { reportError(e); }
  }

  /** Выставление счёта за период. */
  function drawInvoice() {
    const who = selectInput((setup.subscribers || []).map((s) => [s.id, s.name || s.id]),
      (setup.subscribers[0] || {}).id || '', () => {});
    const now = new Date();
    const first = new Date(now.getFullYear(), now.getMonth(), 1);
    const from = h('input', { type: 'date', value: first.toISOString().slice(0, 10) });
    const to = h('input', { type: 'date', value: now.toISOString().slice(0, 10) });
    const out = h('div', {});

    invoiceBlock.replaceChildren(
      h('h2', { text: 'Счёт' }),
      h('div', { class: 'toolbar' }, [
        h('label', { text: 'Абонент' }), who,
        h('label', { text: 'с' }), from,
        h('label', { text: 'по' }), to,
        h('button', { class: 'primary', text: 'посчитать', onclick: () => build() }),
      ]),
      out,
    );

    async function build() {
      if (!who.value) { toast('заведите абонента', 'warn'); return; }
      const fromUs = Date.parse(from.value) * 1000;
      const toUs = (Date.parse(to.value) + 86400000) * 1000;
      if (!(fromUs < toUs)) { toast('период задан наоборот', 'warn'); return; }
      let view;
      try {
        view = await api.billingInvoice(who.value, fromUs, toUs);
      } catch (e) { reportError(e); return; }
      const inv = view;
      out.replaceChildren(...[
        inv.needs_review
          ? h('p', { class: 'warn-line', text:
              'Счёт требует разбора: часть расхода не наблюдалась — причины под строками.' })
          : null,
        h('table', { class: 'grid' }, [
          h('thead', {}, [h('tr', {}, ['точка учёта', 'количество', 'цена', 'сумма']
            .map((t) => h('th', { text: t })))]),
          h('tbody', {}, (inv.lines || []).flatMap((l) => {
            const row = h('tr', { class: l.needs_review ? 'warn-line' : '' }, [
              h('td', { text: l.point_name || l.point }),
              h('td', { class: 'mono', text: `${l.quantity.toFixed(3)} ${l.unit}` }),
              h('td', { class: 'mono', text: (l.price_kopeks / 100).toFixed(2) }),
              h('td', { class: 'mono', text: (l.total_kopeks / 100).toFixed(2) }),
            ]);
            const notes = (l.issues || []).map((issue) => h('tr', {}, [
              h('td', {}), h('td', { class: 'muted', colspan: '3', text: '— ' + issue }),
            ]));
            return [row, ...notes];
          })),
        ]),
        h('p', { class: 'mono', text: 'Итого: ' + ((inv.total_kopeks || 0) / 100).toFixed(2) }),
        h('div', { class: 'toolbar' }, [
          h('button', { text: 'печатная форма', onclick: () => modal({
            title: 'Счёт: ' + (inv.subscriber_name || inv.subscriber),
            body: h('div', {}, [h('pre', { class: 'mono', text: view.printable })]),
            confirmText: 'Закрыть',
            onConfirm: () => {},
          }) }),
        ]),
      ].filter(Boolean));
    }
  }

  return {};
}

async function objectsEditor({ host, toast, reportError, hasRole, live }) {
  host.append(h('h2', { text: 'Технологические объекты' }));
  const editable = hasRole('engineer');
  if (!editable) host.append(h('p', {
    class: 'muted',
    text: 'Режим просмотра: изменение объектной модели доступно инженеру.',
  }));

  let model;
  try { model = JSON.parse((await api.objectModel()).text); }
  catch (error) {
    reportError(error);
    host.append(h('p', { class: 'empty', text: 'не удалось загрузить объектную модель' }));
    return;
  }
  let selected = model.objects[0]?.id || null;
  const expanded = new Set();
  let dirty = false;
  const search = h('input', { type: 'search', class: 'object-tree-search', placeholder: 'Поиск по имени, типу, ID, переменной…', 'aria-label': 'Поиск технологических объектов' });
  const tree = h('div', { class: 'object-tree', role: 'tree', 'aria-label': 'Технологические объекты' });
  const inspector = h('div', { class: 'object-inspector' });
  const text = h('textarea', { class: 'object-json-editor mono', spellcheck: 'false', readonly: editable ? null : '', 'aria-label': 'JSON объектной модели' });
  const problems = h('div', { class: 'object-diagnostics' });
  const status = h('span', { class: 'muted', text: `ревизия ${model.revision}` });
  const treeCount = h('span', { class: 'muted', text: `${model.objects.length} объектов` });
  const polledTags = new Map((live?.all?.() || []).map((tag) => [tag.name.toLocaleLowerCase('ru'), tag]));
  const jsonDetails = h('details', { class: 'object-advanced' }, [
    h('summary', { text: editable ? 'Расширенное редактирование JSON' : 'JSON объектной модели' }), text, problems,
  ]);
  const mapObjects = () => new Map(model.objects.map((object) => [object.id, object]));
  const selectedObject = () => model.objects.find((object) => object.id === selected) || null;
  const newId = () => globalThis.crypto?.randomUUID?.() || `obj-${Date.now()}-${Math.random().toString(16).slice(2)}`;

  const sync = () => {
    try {
      const next = JSON.parse(text.value);
      if (!next || !Array.isArray(next.objects)) throw new Error('ожидается поле objects: массив');
      model = next;
      if (!model.objects.some((object) => object.id === selected)) selected = model.objects[0]?.id || null;
      drawTree();
      drawInspector();
      return true;
    } catch (error) {
      problems.replaceChildren(h('p', { class: 'error', text: error.message }));
      return false;
    }
  };

  const searchMatches = () => {
    const needle = search.value.trim().toLocaleLowerCase('ru');
    if (!needle) return null;
    const map = mapObjects();
    const matches = new Set();
    for (const object of model.objects) {
      const values = [object.name, object.kind, object.id, object.template?.type_id,
        ...(object.variables || []).map((variable) => variable.name)];
      if (!values.filter(Boolean).join(' ').toLocaleLowerCase('ru').includes(needle)) continue;
      matches.add(object.id);
      let parent = object.parent;
      const seen = new Set([object.id]);
      while (parent && map.has(parent) && !seen.has(parent)) {
        seen.add(parent); matches.add(parent); parent = map.get(parent).parent;
      }
    }
    return matches;
  };

  const drawTree = () => {
    tree.replaceChildren();
    treeCount.textContent = `${model.objects.length} объектов`;
    if (!model.objects.length) {
      tree.append(h('div', { class: 'object-tree-empty' }, [
        h('strong', { text: 'Объектов пока нет' }),
        h('p', { class: 'muted', text: 'Создайте корневой технологический объект. Приборы и теги к нему можно привязать позже.' }),
      ]));
      return;
    }
    const map = mapObjects();
    const matches = searchMatches();
    const children = new Map();
    for (const object of model.objects) {
      const parentId = object.parent && map.has(object.parent) ? object.parent : '';
      if (!children.has(parentId)) children.set(parentId, []);
      children.get(parentId).push(object);
    }
    for (const list of children.values()) list.sort((a, b) => (a.name || a.id).localeCompare(b.name || b.id, 'ru'));
    const reachable = new Set();
    const markReachable = (parentId, ancestry) => {
      for (const object of children.get(parentId) || []) {
        if (ancestry.has(object.id) || reachable.has(object.id)) continue;
        reachable.add(object.id);
        const path = new Set(ancestry); path.add(object.id);
        markReachable(object.id, path);
      }
    };
    markReachable('', new Set());

    const branch = (parentId, depth, ancestry) => {
      for (const object of children.get(parentId) || []) {
        if (matches && !matches.has(object.id)) continue;
        if (ancestry.has(object.id)) {
          tree.append(h('div', { class: 'object-tree-warning', text: `Цикл иерархии: ${object.name || object.id}` }));
          continue;
        }
        const kids = children.get(object.id) || [];
        const hasChildren = kids.length > 0;
        const expandedNow = expanded.has(object.id) || !!matches;
        const row = h('div', {
          class: 'object-tree-row' + (selected === object.id ? ' is-selected' : '') + (object.enabled === false ? ' is-disabled' : ''),
          role: 'treeitem', 'aria-level': String(depth + 1), 'aria-selected': String(selected === object.id),
        });
        row.append(h('button', {
          class: 'object-tree-toggle', text: hasChildren ? (expandedNow ? '▾' : '▸') : '·',
          disabled: !hasChildren, title: hasChildren ? (expandedNow ? 'Свернуть ветвь' : 'Раскрыть ветвь') : 'Дочерних объектов нет',
          'aria-label': `${expandedNow ? 'Свернуть' : 'Раскрыть'} ${object.name || object.id}`,
          onclick: (event) => {
            event.stopPropagation();
            if (expanded.has(object.id)) expanded.delete(object.id); else expanded.add(object.id);
            drawTree();
          },
        }));
        row.append(h('button', {
          class: 'object-tree-label',
          style: `--object-depth:${Math.min(depth, 24)}`,
          onclick: () => { selected = object.id; drawTree(); drawInspector(); },
          title: `${objectPath(object, map)} · ${object.id}`,
        }, [
          h('span', { class: 'object-tree-icon', text: objectIcon(object.kind) }),
          h('span', { class: 'object-tree-copy' }, [
            h('span', { class: 'object-tree-name', text: object.name || 'Без названия' }),
            h('span', { class: 'object-tree-subtitle', text: object.kind || 'object' }),
          ]),
          h('span', { class: 'object-tree-counts', title: 'Переменные / окна / программы', text:
            `${object.variables?.length || 0} / ${object.screens?.length || 0} / ${object.programs?.length || 0}` }),
          object.enabled === false ? h('span', { class: 'object-tree-badge', text: 'ВЫКЛ' }) : null,
        ]));
        tree.append(row);
        if (hasChildren && expandedNow) {
          const path = new Set(ancestry); path.add(object.id);
          branch(object.id, depth + 1, path);
        }
      }
    };
    branch('', 0, new Set());
    const orphans = model.objects.filter((object) => !reachable.has(object.id));
    if (orphans.length) {
      tree.append(h('div', { class: 'object-tree-group-label', text: `Без корня или с циклической связью · ${orphans.length}` }));
      for (const object of orphans) {
        if (matches && !matches.has(object.id)) continue;
        tree.append(h('button', {
          class: 'object-tree-orphan' + (selected === object.id ? ' is-selected' : ''),
          text: `${object.name || object.id} · ${object.parent && map.has(object.parent) ? 'цикл или недостижимая ветвь' : `родитель ${object.parent || 'не задан'}`}`,
          onclick: () => { selected = object.id; drawTree(); drawInspector(); },
        }));
      }
    }
  };

  const refreshText = () => { text.value = JSON.stringify(model, null, 2); };
  const markDirty = () => {
    dirty = true;
    status.textContent = `черновик${model.revision ? ` · база ревизия ${model.revision}` : ''}`;
  };
  const legacyVariableTypes = { sint: 's_int', usint: 'u_s_int', uint: 'u_int', dint: 'd_int', udint: 'u_d_int', lint: 'l_int', ulint: 'u_l_int', lreal: 'l_real' };
  let normalizedLegacyTypes = false;
  for (const variable of model.objects.flatMap((object) => object.variables || [])) {
    const legacy = variable.data_type?.kind;
    if (legacyVariableTypes[legacy]) {
      variable.data_type.kind = legacyVariableTypes[legacy];
      normalizedLegacyTypes = true;
    }
  }
  if (normalizedLegacyTypes) { markDirty(); refreshText(); }
  const updateSelected = (key, value) => {
    const object = selectedObject(); if (!object) return;
    if (value === '' || value == null) delete object[key]; else object[key] = value;
    markDirty(); refreshText(); drawTree();
  };
  const field = (label, control, title = '') => h('label', { class: 'object-field', title }, [
    h('span', { text: label }), control,
  ]);
  const textInput = (value, change, attrs = {}) => {
    const input = h('input', {
      ...attrs,
      value: value ?? '',
      disabled: (!editable || attrs.disabled) ? '' : null,
    });
    input.addEventListener('change', () => change(input.value));
    return input;
  };

  function drawInspector() {
    inspector.replaceChildren();
    const object = selectedObject();
    if (!object) {
      inspector.append(h('div', { class: 'object-tree-empty' }, [
        h('strong', { text: 'Выберите объект' }),
        h('p', { class: 'muted', text: 'Свойства, переменные, окна и программы выбранного узла появятся здесь.' }),
      ]));
      return;
    }
    const map = mapObjects();
    const parent = h('select', {});
    if (!editable) parent.setAttribute('disabled', '');
    parent.append(h('option', { value: '', text: 'Корневой объект' }));
    for (const candidate of model.objects) {
      if (candidate.id === object.id || isObjectDescendant(candidate.id, object.id, map)) continue;
      parent.append(h('option', { value: candidate.id, text: objectPath(candidate, map) }));
    }
    parent.value = object.parent || '';
    parent.addEventListener('change', () => {
      const parentId = parent.value;
      if (parentId && isObjectDescendant(parentId, object.id, map)) {
        toast('нельзя вложить объект в самого себя или его потомка', 'err');
        parent.value = object.parent || '';
        return;
      }
      if (parentId) object.parent = parentId; else delete object.parent;
      markDirty(); refreshText(); drawTree(); drawInspector();
    });
    const enabled = h('input', { type: 'checkbox', checked: object.enabled !== false });
    if (!editable) enabled.setAttribute('disabled', '');
    enabled.addEventListener('change', () => { object.enabled = enabled.checked; markDirty(); refreshText(); drawTree(); });
    const props = h('div', { class: 'object-form-grid' }, [
      field('Название', textInput(object.name, (value) => updateSelected('name', value)), 'Человекочитаемое имя; UUID и ссылки при переименовании остаются прежними.'),
      field('Тип объекта', textInput(object.kind, (value) => updateSelected('kind', value)), 'Например: цех, насосная, насос, задвижка, зона.'),
      field('UUID', h('input', { value: object.id, disabled: true }), 'Неизменяемый стабильный идентификатор объекта.'),
      field('Родитель', parent, 'Перемещение меняет путь в дереве, но не UUID объекта.'),
      field('Включён', enabled, 'Выключенный объект сохраняется в модели, но его будущие программы не должны исполняться.'),
      field('Библиотечный тип', textInput(object.template?.type_id || '', () => toast('каталог шаблонов будет подключён следующим этапом', 'info'), { disabled: true, placeholder: 'библиотеки ещё не подключены' })),
    ]);
    inspector.append(
      h('div', { class: 'object-inspector-heading' }, [
        h('div', {}, [
          h('div', { class: 'object-breadcrumb', text: objectPath(object, map) }),
          h('h3', { text: object.name || 'Без названия' }),
        ]),
        h('span', { class: object.enabled === false ? 'object-badge is-disabled' : 'object-badge', text: object.enabled === false ? 'ОТКЛЮЧЁН' : 'ТЕХНОЛОГИЧЕСКИЙ ОБЪЕКТ' }),
      ]),
      props,
      h('div', { class: 'object-section-heading' }, [
        h('h3', { text: 'Переменные' }),
        h('button', { text: '+ Добавить переменную', disabled: editable ? null : '', onclick: addVariable }),
      ]),
      variableTable(object),
      h('div', { class: 'object-document-links' }, [
        h('div', {}, [h('strong', { text: 'Окна' }), h('span', { text: (object.screens || []).join(', ') || 'не назначены' })]),
        h('div', {}, [h('strong', { text: 'Программы' }), h('span', { text: (object.programs || []).join(', ') || 'не назначены' })]),
      ]),
    );
  }

  function variableTable(object) {
    const table = h('table', { class: 'object-variable-table' });
    const body = h('tbody');
    const rows = object.variables || [];
    const variableTypeOptions = [
      ['bool','BOOL (bool)'],['s_int','SINT (s_int)'],['u_s_int','USINT (u_s_int)'],['int','INT (int)'],['u_int','UINT (u_int)'],
      ['d_int','DINT (d_int)'],['u_d_int','UDINT (u_d_int)'],['l_int','LINT (l_int)'],['u_l_int','ULINT (u_l_int)'],
      ['real','REAL (real)'],['l_real','LREAL (l_real)'],['byte','BYTE (byte)'],['word','WORD (word)'],
      ['d_word','DWORD (d_word)'],['l_word','LWORD (l_word)'],['time','TIME (time)'],['date','DATE (date)'],
      ['time_of_day','TIME_OF_DAY (time_of_day)'],['date_and_time','DATE_AND_TIME (date_and_time)'],
      ['string','STRING (string)'],['w_string','WSTRING (w_string)'],
    ];
    for (const variable of rows) {
      const name = textInput(variable.name, (value) => { variable.name = value; markDirty(); refreshText(); drawTree(); });
      const type = h('select', {});
      type.title = 'IEC-имя показано первым, внутренний ключ объектной модели — в скобках.';
      if (!editable) type.setAttribute('disabled', '');
      for (const [id, label] of variableTypeOptions) type.append(h('option', { value: id, text: label }));
      type.value = legacyVariableTypes[variable.data_type?.kind] || variable.data_type?.kind || 'bool';
      type.addEventListener('change', () => {
        variable.data_type = type.value === 'string'
          ? { kind: 'string', item: { max_bytes: 255 } }
          : type.value === 'w_string'
            ? { kind: 'w_string', item: { max_code_units: 255 } }
            : { kind: type.value };
        markDirty(); refreshText();
      });
      const direction = h('select', {});
      if (!editable) direction.setAttribute('disabled', '');
      for (const [id, label] of [['internal','Внутренняя'],['input','Вход'],['output','Выход'],['in_out','Вход/выход']]) direction.append(h('option', { value: id, text: label }));
      direction.value = variable.direction || 'internal';
      direction.addEventListener('change', () => {
        variable.direction = direction.value;
        if (variable.binding?.source?.tag) {
          variable.binding.direction = direction.value === 'input' ? 'read' : direction.value === 'output' ? 'write' : 'read_write';
        }
        markDirty(); refreshText();
      });
      const picker = h('div', { class: 'object-tag-picker' });
      const tag = h('input', {
        type: 'search', value: variable.binding?.source?.tag || '',
        placeholder: 'Поиск по имени или назначению…', autocomplete: 'off',
        title: 'Ищет по имени тега и его назначению в настройке опроса.',
        'aria-label': `Поиск опрашиваемого тега для переменной ${variable.name}`,
        'aria-expanded': 'false',
      });
      const results = h('div', { class: 'object-tag-picker-results', role: 'listbox', hidden: '' });
      if (!editable) tag.setAttribute('disabled', '');
      const chooseTag = (selectedTag) => {
        tag.value = selectedTag.name;
        tag.setAttribute('aria-expanded', 'false');
        results.hidden = true;
        variable.binding = { source: { kind: 'tag', tag: selectedTag.name }, direction: variable.direction === 'input' ? 'read' : variable.direction === 'output' ? 'write' : 'read_write' };
        if (selectedTag.iec_type && variableTypeOptions.some(([kind]) => kind === selectedTag.iec_type)) {
          type.value = selectedTag.iec_type;
          variable.data_type = selectedTag.iec_type === 'string'
            ? { kind: 'string', item: { max_bytes: 255 } }
            : selectedTag.iec_type === 'w_string'
              ? { kind: 'w_string', item: { max_code_units: 255 } }
              : { kind: selectedTag.iec_type };
        }
        markDirty(); refreshText();
      };
      const showMatches = (query = tag.value) => {
        const terms = query.trim().toLocaleLowerCase('ru').split(/\s+/).filter(Boolean);
        const matches = [...polledTags.values()]
          .map((item) => ({
            item,
            searchable: [item.name, item.title, item.description, item.units, item.iec_type]
              .filter(Boolean).join(' ').toLocaleLowerCase('ru'),
          }))
          .filter(({ searchable }) => terms.every((term) => searchable.includes(term)))
          .sort((a, b) => {
            const rank = ({ item, searchable }) => {
              const title = (item.title || '').toLocaleLowerCase('ru');
              const name = item.name.toLocaleLowerCase('ru');
              const first = terms[0] || '';
              return (title.startsWith(first) ? 0 : name.startsWith(first) ? 1 : searchable.includes(first) ? 2 : 3);
            };
            return rank(a) - rank(b) || (a.item.title || a.item.name).localeCompare(b.item.title || b.item.name, 'ru');
          })
          .slice(0, 30);
        results.replaceChildren();
        if (!matches.length) {
          results.append(h('div', { class: 'object-tag-picker-empty', text: 'Совпадений нет. Ищите по имени тега или назначению.' }));
        } else {
          for (const { item: match } of matches) {
            const option = h('button', { type: 'button', class: 'object-tag-picker-option', role: 'option' }, [
              h('strong', { text: match.title || match.name }),
              h('span', { class: 'object-tag-picker-meta', text: `${match.name} · ${match.iec_type?.toUpperCase() || 'тип не задан'}${match.units ? ` · ${match.units}` : ''}` }),
            ]);
            option.addEventListener('mousedown', (event) => event.preventDefault());
            option.addEventListener('click', () => chooseTag(match));
            results.append(option);
          }
        }
        results.hidden = false;
        tag.setAttribute('aria-expanded', 'true');
      };
      tag.addEventListener('focus', () => showMatches());
      tag.addEventListener('input', () => {
        const query = tag.value.trim();
        if (!query) {
          delete variable.binding;
          markDirty(); refreshText();
        }
        showMatches(query);
      });
      tag.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          results.hidden = true; tag.setAttribute('aria-expanded', 'false');
        } else if (event.key === 'Enter' && !results.hidden) {
          const first = results.querySelector('.object-tag-picker-option');
          if (first) { event.preventDefault(); first.click(); }
        }
      });
      tag.addEventListener('blur', () => setTimeout(() => {
        results.hidden = true; tag.setAttribute('aria-expanded', 'false');
        if (variable.binding?.source?.tag) tag.value = variable.binding.source.tag;
      }, 120));
      picker.append(tag, results);
      const remove = h('button', { class: 'danger object-delete-variable', text: 'Удалить', disabled: editable ? null : '', onclick: () => {
        object.variables = rows.filter((item) => item.id !== variable.id);
        markDirty(); refreshText(); drawTree(); drawInspector();
      } });
      body.append(h('tr', {}, [h('td', {}, name), h('td', {}, type), h('td', {}, direction), h('td', {}, picker), h('td', {}, remove)]));
    }
    table.append(
      h('thead', {}, h('tr', {}, ['Имя','Тип','Направление','Привязка к тегу',''].map((label) => h('th', { text: label })))),
      body,
    );
    if (!rows.length) body.append(h('tr', {}, h('td', { class: 'muted', colspan: '5', text: 'переменных ещё нет' })));
    return table;
  }

  const addObject = () => {
    if (!editable) return;
    if (!sync()) return;
    const object = { id: newId(), kind: 'equipment', name: 'Новый объект', variables: [], screens: [], programs: [], enabled: true };
    if (selected) { object.parent = selected; expanded.add(selected); }
    model.objects.push(object); selected = object.id; markDirty(); refreshText(); drawTree(); drawInspector();
  };
  const addRoot = () => {
    if (!editable) return;
    if (!sync()) return;
    const object = { id: newId(), kind: 'site', name: 'Новый объект', variables: [], screens: [], programs: [], enabled: true };
    model.objects.push(object); selected = object.id; markDirty(); refreshText(); drawTree(); drawInspector();
  };
  const addVariable = () => {
    if (!editable) return;
    if (!sync()) return;
    const object = selectedObject();
    if (!object) { toast('сначала выберите объект', 'err'); return; }
    object.variables ||= [];
    object.variables.push({ id: newId(), name: 'Новая переменная', data_type: { kind: 'bool' }, scope: 'object', direction: 'internal', retain: false });
    markDirty(); refreshText(); drawTree(); drawInspector();
  };
  const removeObject = () => {
    if (!editable) return;
    if (!sync()) return;
    const object = selectedObject();
    if (!object) { toast('сначала выберите объект', 'err'); return; }
    const children = model.objects.filter((item) => item.parent === object.id);
    if (children.length) { toast(`сначала переместите или удалите дочерние объекты (${children.length})`, 'err'); return; }
    const refCount = model.objects.reduce((count, item) => count + (item.variables || []).filter((variable) => variable.binding?.source?.object === object.id).length, 0);
    if (refCount) { toast(`объект используется в ${refCount} привязках; удаление блокировано`, 'err'); return; }
    if (!window.confirm(`Удалить «${object.name}»? История ревизий сохранится.`)) return;
    model.objects = model.objects.filter((item) => item.id !== object.id);
