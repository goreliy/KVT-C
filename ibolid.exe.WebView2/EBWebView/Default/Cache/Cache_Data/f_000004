const h = (tag, attrs = {}, children = []) => {
  const node = document.createElement(tag);
  for (const [k, v] of Object.entries(attrs)) {
    if (v === undefined || v === null) continue;
    if (k === 'class') node.className = v;
    else if (k === 'text') node.textContent = v;
    else if (k === 'html') node.innerHTML = v;
    else if (k.startsWith('on') && typeof v === 'function') node.addEventListener(k.slice(2), v);
    else node.setAttribute(k, v);
  }
  for (const c of [].concat(children)) if (c !== null && c !== undefined) node.append(c);
  return node;
};

const card = (k, v) => h('div', { class: 'card' }, [
  h('div', { class: 'k', text: k }),
  h('div', { class: 'v', text: String(v) }),
]);

/**
 * Модальное окно с содержимым и кнопками.
 *
 * Взамен `window.prompt`: тот не показывает ни качества текущего значения, ни
 * границ, ни последствий, а операторские посты нередко работают в браузере,
 * где системные окна подавлены. Возвращает обещание с результатом либо `null`
 * при отказе.
 */
export function modal({
  title, body, confirmText = 'Выполнить', danger = false, onConfirm,
  // Окно поиска остаётся открытым: найденное надо ещё рассмотреть и добавить.
  closeOnConfirm = true,
  cancelText = 'Отмена',
}) {
  return new Promise((resolve) => {
    const dialog = h('dialog', { class: 'modal' });
    let settled = false;
    const finish = (value) => {
      if (settled) return;
      settled = true;
      dialog.close();
      resolve(value);
    };

    const confirm = h('button', {
      class: danger ? 'danger' : 'primary',
      text: confirmText,
      onclick: async () => {
        confirm.disabled = true;
        const err = dialog.querySelector('.modal-error');
        err.hidden = true;
        try {
          const value = onConfirm ? await onConfirm() : true;
          if (closeOnConfirm) finish(value);
          else confirm.disabled = false;
        } catch (e) {
          confirm.disabled = false;
          err.hidden = false;
          err.textContent = e && e.message ? e.message : String(e);
        }
      },
    });

    dialog.append(
      h('div', { class: 'modal-head' }, h('strong', { text: title })),
      h('div', { class: 'modal-body' }, [body, h('p', { class: 'error modal-error', hidden: 'hidden' })]),
      h('div', { class: 'modal-foot' }, [
        h('button', { text: cancelText, onclick: () => finish(null) }),
        h('span', { class: 'spacer' }),
        confirm,
      ]),
    );
    dialog.addEventListener('cancel', () => finish(null));
    dialog.addEventListener('close', () => { finish(null); dialog.remove(); });
    document.body.append(dialog);
    dialog.showModal();
    const first = dialog.querySelector('input, select, textarea');
    if (first) first.focus();
  });
}

function timeText(us) {
  if (!us) return '—';
  return new Date(us / 1000).toLocaleString('ru-RU');
}

/**
 * Линия или прибор сняты с опроса решением наладчика, а не отказом.
 *
 * Разница существенна для того, кто смотрит на экран: неисправность зовёт
 * искать провод, а снятая галочка — открыть настройку. Красный цвет на
 * выключенной линии посылает чинить исправное.
 */
function isSwitchedOff(view) {
  return /выключен/.test(view.port_state || view.state || '');
}

