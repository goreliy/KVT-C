    try { showCheck(await api.checkProgram(currentId, source.value)); }
    catch (error) { reportError(error); }
  };
  const autoLayout = async () => {
    if (!editable || !parse()) return;
    try {
      const result = await api.layoutProgram(currentId, source.value);
      source.value = result.text; model = JSON.parse(result.text); dirty = true;
      layoutReport = result.report; selectedNode = null; drawGraph(); showCheck(result.check);
      revision.textContent = `ревизия ${model.revision} · раскладка черновика`;
      status.textContent = `разложено сетей ${result.report.networks}, узлов ${result.report.nodes}; изменено ${result.report.changed_nodes} · не сохранено`;
    } catch (error) { reportError(error); }
  };
  const save = async () => {
    if (!editable || !parse()) return;
    try {
      const result = await api.saveProgram(currentId, model.revision, source.value);
      model.revision = result.revision; refreshText(); dirty = false;
      revision.textContent = `ревизия ${result.revision}`;
      const errorCount = result.check?.errors?.length || 0;
      status.textContent = errorCount ? `черновик сохранён · ошибок проверки: ${errorCount}` : `сохранено · ревизия ${result.revision}`;
      showCheck(result.check); syncRuntimeControls(); await refreshList();
      toast(errorCount ? `Черновик сохранён; проверка нашла ошибок: ${errorCount}` : 'IEC‑программа сохранена', 'ok');
    } catch (error) { reportError(error); }
  };
  taskRuntimeControls.replaceChildren(
    startRuntimeButton = h('button', { class: 'danger', text: '▶ Запустить задачи · контроллер Modbus', disabled: '', title: 'Запускает контроллер и разрешает запись в связанные Modbus-теги после подтверждения', onclick: startPhysicalRuntime }),
    startPhysicalRuntimeButton = h('button', { text: '▷ Запустить симуляцию', disabled: '', title: 'Только безопасная симуляция без записи в физические теги', onclick: startRuntime }),
    restartRuntimeButton = h('button', { text: '↻ Перезапустить симуляцию', disabled: '', title: 'Перезапустить планировщик в безопасной симуляции', onclick: restartRuntime }),
    stopRuntimeButton = h('button', { text: '■ Остановить задачи', disabled: '', onclick: stopRuntime }),
    autostartButton = h('button', { text: 'Автозапуск: выключен', disabled: '', title: 'Симуляция при следующем запуске I‑Bolid', onclick: toggleAutostart }),
  );
  source.addEventListener('input', () => {
    if (!parse()) { dirty = true; drawGraph(); drawTasks(); syncRuntimeControls(); return; }
    changed(); drawGraph(); drawTasks();
  });

  const toolbar = h('div', { class: 'toolbar program-toolbar' }, [
    h('button', { class: 'primary', text: '+ Новая FBD‑программа', disabled: editable ? null : '', onclick: create }),
    h('span', { class: 'spacer' }), status,
    undoButton = h('button', { text: '↶ Отменить', title: 'Ctrl+Z', disabled: '', onclick: () => restoreHistory(undoStack, redoStack) }),
    redoButton = h('button', { text: '↷ Повторить', title: 'Ctrl+Y', disabled: '', onclick: () => restoreHistory(redoStack, undoStack) }),
    h('button', { text: 'Проверить', disabled: editable ? null : '', onclick: check }),
    h('button', { text: 'Авто‑раскладка FBD', disabled: editable ? null : '', onclick: autoLayout }),
    h('button', { class: 'primary', text: 'Сохранить', disabled: editable ? null : '', onclick: save }),
  ]);
  syncHistoryButtons();
  syncRuntimeControls();
  editor.append(h('div', { class: 'program-editor-head' }, [title, revision]), ownerPanel, graph, tasksPanel, runtimeStatus,
    h('details', { class: 'program-source-details' }, [
      h('summary', { text: 'Документ программы · редактирование JSON' }), source,
    ]), diagnostics);
  host.append(toolbar, h('div', { class: 'program-editor-layout' }, [
    h('aside', { class: 'program-list-panel' }, [h('h3', { text: 'Объекты и программы' }), list, fbdOutlinePanel, fbdPaletteDock]), editor,
  ]));

  try {
    const [snapshotResult, objectsResult] = await Promise.allSettled([api.snapshot(), api.objectModel()]);
    if (snapshotResult.status === 'fulfilled') {
      liveTags = snapshotResult.value.tags || [];
      for (const tag of liveTags) liveTagByName.set(tag.name, tag);
    }
    if (objectsResult.status === 'fulfilled') objectDocument = JSON.parse(objectsResult.value.text);
    await refreshList(); if (summaries.length) await openProgram(summaries[0].id); else status.textContent = 'программ нет';
  }
  catch (error) { reportError(error); status.textContent = 'не удалось загрузить список'; }
  return {
    dispose() {
      live?.removeEventListener('tags', onLiveTags);
      if (runtimePoll != null) { clearInterval(runtimePoll); runtimePoll = null; }
    },
  };
}


function objectPath(object, map) {
  const parts = [object.name || object.id];
  let parent = object.parent;
  const seen = new Set([object.id]);
  while (parent && map.has(parent) && !seen.has(parent)) {
    seen.add(parent);
    const item = map.get(parent);
    parts.push(item.name || item.id);
    parent = item.parent;
  }
  return parts.reverse().join(' / ');
}

function objectIcon(kind) {
  const name = String(kind || '').toLowerCase();
  if (/site|building|plant|цех|здание|объект/.test(name)) return '▦';
  if (/pump|насос/.test(name)) return '◉';
  if (/valve|клапан|задвиж/.test(name)) return '◈';
  if (/zone|зона/.test(name)) return '▧';
  return '◇';
}

function isObjectDescendant(candidateId, ancestorId, map) {
  let item = map.get(candidateId);
  const seen = new Set();
  while (item?.parent && !seen.has(item.parent)) {
    if (item.parent === ancestorId) return true;
    seen.add(item.parent);
    item = map.get(item.parent);
  }
  return false;
}

