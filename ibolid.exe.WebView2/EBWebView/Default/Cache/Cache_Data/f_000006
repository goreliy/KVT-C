/** Разумное умолчание характеристики по типу элемента. */
function guessAttribute(element) {
  if (element.tag === 'text' || element.tag === 'tspan') return 'text';
  return 'fill';
}

/**
 * Предположение тега по имени элемента (FR-773.11).
 *
 * Сравнение по нормализованному имени: разделители, регистр и пробелы в
 * чертежах произвольны, а имя тега строго. Совпадение по хвосту имени тега —
 * самый частый случай: элемент называют `насос-1`, а тег `line1.dev5.насос-1`.
 */
export function guessTag(element, tagNames, tagTitles) {
  const key = normalize(element.name || element.id);
  if (!key) return '';
  let exact = null;
  let suffix = null;
  let byTitle = null;
  for (const tag of tagNames) {
    const n = normalize(tag);
    if (n === key) { exact = tag; break; }
    if (!suffix && n.endsWith('.' + key)) suffix = tag;
    if (!suffix && normalize(tag.split('.').pop()) === key) suffix = tag;
    // Совпадение по названию — последняя попытка: элементы чертежа называют
    // по-человечески («Насос 1»), и у импортированных профилей имя тега
    // машинное, так что искать в нём нечего.
    if (!byTitle && tagTitles) {
      const title = tagTitles.get ? tagTitles.get(tag) : tagTitles[tag];
      if (title && normalize(title) === key) byTitle = tag;
    }
  }
  return exact || suffix || byTitle || '';
}

const normalize = (s) => String(s || '').trim().toLowerCase().replace(/[\s_]+/g, '-');

