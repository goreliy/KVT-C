function propInput(instance, spec, onchange) {
  const current = (instance.properties || {})[spec.id];
  const commit = (value) => {
    instance.properties = instance.properties || {};
    if (value === '' || value === undefined) delete instance.properties[spec.id];
    else instance.properties[spec.id] = value;
    onchange();
  };
  if (spec.kind === 'enum') {
    const select = h('select', {}, [h('option', { value: '', text: '—' }),
      ...spec.values.map((v) => h('option', { value: v, text: v }))]);
    select.value = current ?? '';
    select.addEventListener('change', (e) => commit(e.target.value));
    return select;
  }
  if (spec.kind === 'boolean') {
    const check = h('input', { type: 'checkbox' });
    check.checked = current !== false;
    check.addEventListener('change', (e) => commit(e.target.checked));
    return check;
  }
  if (spec.kind === 'duration') {
    const fallback = spec.default || spec.min || 0;
    const selected = current === undefined || current === null ? fallback : Number(current);
    const hasPreset = spec.presets.some(([seconds]) => seconds === selected);
    const pick = h('select', {}, [
      ...spec.presets.map(([seconds, label]) => h('option', { value: String(seconds), text: label })),
      h('option', { value: 'custom', text: 'свой интервал…' }),
    ]);
    pick.value = hasPreset ? String(selected) : 'custom';
    const custom = h('input', {
      type: 'number', min: String(spec.min || 1), step: '1',
      value: String(Math.max(spec.min || 1, hasPreset ? fallback : selected)),
      title: 'значение в секундах', placeholder: 'секунд',
    });
    custom.hidden = pick.value !== 'custom';
    custom.addEventListener('change', () => {
      const value = Math.max(spec.min || 1, Number(custom.value) || fallback);
      custom.value = String(value);
      commit(value);
    });
    pick.addEventListener('change', () => {
      custom.hidden = pick.value !== 'custom';
      if (pick.value !== 'custom') commit(Number(pick.value));
      else custom.focus();
    });
    return h('div', { class: 'trend-duration-control' }, [pick, custom]);
  }
  if (spec.kind === 'number') {
    return h('input', {
      type: 'number', value: current ?? '',
      oninput: (e) => commit(e.target.value === '' ? '' : Number(e.target.value)),
    });
  }
  return h('input', { value: current ?? '', oninput: (e) => commit(e.target.value) });
}
