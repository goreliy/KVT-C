.program-runtime-status p { margin: 0; }
.fbd-canvas-wrap { display: grid; gap: 10px; margin-bottom: 12px; }
.fbd-ide-grid { display: grid; grid-template-columns: minmax(130px, 165px) minmax(360px, 1fr) minmax(130px, 165px) minmax(220px, 270px); gap: 8px; align-items: start; }
.fbd-side { min-width: 0; max-height: 76vh; overflow: auto; padding: 10px; border: 1px solid var(--line); border-radius: 7px; background: var(--panel-2); }
.fbd-io-column { position: sticky; top: 8px; }
.fbd-io-column h3 { margin: 2px 0 5px; }
.fbd-io-column > .muted { font-size: 11px; }
.fbd-io-item.is-selected { border-color: var(--accent); box-shadow: inset 3px 0 var(--accent); }
.fbd-side h3, .fbd-side h4 { margin: 2px 0 8px; }
.fbd-side h4 { padding-top: 10px; border-top: 1px solid var(--line); font-size: 12px; }
.fbd-side input[type="search"] { box-sizing: border-box; width: 100%; margin-bottom: 8px; }
.fbd-palette-item, .fbd-io-item, .fbd-variable { display: grid; gap: 3px; width: 100%; margin: 4px 0; padding: 7px 8px; text-align: left; }
.fbd-palette-item span, .fbd-variable span { color: var(--muted); font: 10px/1.3 var(--font-mono, Consolas, monospace); }
.fbd-io-item { font-size: 11px; }
.fbd-variable.is-selected { border-color: var(--accent); }
