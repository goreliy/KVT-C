.program-diagnostics { display: grid; gap: 6px; max-height: 28vh; overflow: auto; margin-top: 10px; }
.program-diagnostic { display: grid; grid-template-columns: max-content max-content 1fr; align-items: baseline; gap: 8px; border-left: 3px solid var(--line); padding: 5px 8px; font-size: 12px; }
.program-diagnostic.error { border-left-color: var(--alarm); }
.program-diagnostic.warning { border-left-color: var(--warn); }
.program-diagnostic.note { border-left-color: var(--accent); }
