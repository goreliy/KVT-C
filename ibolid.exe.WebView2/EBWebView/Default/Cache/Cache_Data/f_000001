.fbd-edit-field input:not([type="checkbox"]), .fbd-edit-field select, .fbd-edit-field textarea { box-sizing: border-box; width: 100%; color: var(--text); }
.fbd-edit-field input[type="checkbox"] { justify-self: start; }
.fbd-initial-value { display: flex; align-items: center; gap: 6px; }
.fbd-initial-value input:not([type="checkbox"]) { flex: 1; min-width: 0; }
.fbd-initial-value input[type="checkbox"] { flex: 1; }
.fbd-workspace { min-width: 0; display: grid; gap: 9px; }
.fbd-palette { max-height: 30vh; }
.fbd-palette-group { border-top: 1px solid var(--line); padding: 6px 0; }
.fbd-palette-group summary { cursor: pointer; font-weight: 600; font-size: 12px; }
.fbd-inspector { position: sticky; top: 8px; }
.fbd-network-list { display: grid; gap: 9px; }
.fbd-toolbar { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
.fbd-toolbar select { max-width: 190px; }
.fbd-delete-edge { justify-self: start; }
.fbd-network { border: 1px solid var(--line); border-radius: 7px; overflow: auto; background: var(--panel-2); }
.fbd-network-title { padding: 8px 10px 0; font-size: 12px; }
