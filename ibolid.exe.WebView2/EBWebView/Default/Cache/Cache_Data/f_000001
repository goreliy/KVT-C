}
.fbd-bound-tag-state { display: grid; gap: 3px; margin: 8px 0; padding: 8px; border: 1px solid var(--line); border-radius: 6px; background: var(--surface, var(--panel)); font-size: 12px; overflow-wrap: anywhere; }
