/* ── Уведомления ──────────────────────────────────────────────────── */

.toasts { position: fixed; right: 14px; bottom: 14px; display: grid; gap: 8px; z-index: 50; }
.toast {
  background: var(--panel); border: 1px solid var(--line); border-left-width: 3px;
  border-radius: 6px; padding: 9px 12px; font-size: 13px; max-width: 360px;
}
.toast.ok { border-left-color: var(--ok); }
.toast.err { border-left-color: var(--alarm); }
.toast.info { border-left-color: var(--accent); }

/* ── Модальные окна ───────────────────────────────────────────────── */

/* Взамен системных окон браузера: те не показывают ни качества значения,
   ни границ, ни последствий, а на операторских постах нередко подавлены. */
.modal {
  padding: 0;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--panel);
  color: var(--text);
  width: min(460px, 92vw);
}
.modal::backdrop { background: rgba(0, 0, 0, .5); }
.modal-head { padding: 12px 16px; border-bottom: 1px solid var(--line); }
.modal-body { padding: 14px 16px; display: grid; gap: 10px; }
.modal-body p { margin: 0; }
.modal-body label { display: grid; gap: 4px; font-size: 12px; color: var(--muted); }
.modal-body table td { border: none; padding: 2px 8px 2px 0; }
.modal-foot { padding: 12px 16px; border-top: 1px solid var(--line); display: flex; gap: 8px; align-items: center; }
.modal-foot .spacer { flex: 1; }
button.danger { background: var(--alarm); border-color: var(--alarm); color: #fff; }

/* ── Монитор линии ────────────────────────────────────────────────── */

.monitor { font-size: 12px; }
.monitor td { padding: 3px 8px; vertical-align: top; }
.monitor .frames { font-size: 11px; line-height: 1.35; white-space: nowrap; }
/* Отказ различается не только цветом: строка получает полосу слева. */
.monitor tr.row-bad td:first-child { border-left: 3px solid var(--alarm); }
.monitor tr.row-bad { background: color-mix(in srgb, var(--alarm) 8%, transparent); }

.muted { color: var(--muted); }
.empty { color: var(--muted); padding: 24px; text-align: center; }
code, .mono { font-family: var(--mono); }

/* Пояснение к экрану: читается как подпись, а не как содержимое. */
.hint { color: var(--muted); font-size: 13px; margin: 0 0 12px; max-width: 78ch; }
/* Предупреждение строкой — с полосой слева, чтобы отличалось не одним цветом. */
.warn-line {
  margin: 0 0 10px;
  padding: 6px 10px;
  font-size: 13px;
  color: var(--warn);
  border-left: 3px solid var(--warn);
  background: color-mix(in srgb, var(--warn) 10%, transparent);
}
button.small { padding: 2px 8px; font-size: 12px; margin-left: 6px; }

/* ── Настройка приборов ───────────────────────────────────────────── */

.cfg-block {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 10px 12px;
  margin-bottom: 12px;
}
.cfg-device {
  border-left: 3px solid var(--accent);
  padding: 8px 10px;
  margin: 8px 0 8px 10px;
  background: var(--panel-2);
  border-radius: 0 6px 6px 0;
}
/* Свой тип в палитре: рядом с ним кнопка удаления. */
.palette-own { display: flex; gap: 2px; align-items: stretch; }
.palette-own > button:first-child { flex: 1; text-align: left; }
button.palette-drop { padding: 2px 6px; color: var(--muted); }
button.palette-drop:hover { color: var(--alarm); border-color: var(--alarm); }

/* Отключённое от опроса: гаснет, но остаётся читаемым. Различие не только в
   цвете — слева полоса, потому что «почему нет данных» разбирают по виду. */
.cfg-off { opacity: .62; border-left: 3px dashed var(--muted); }
.cfg-off::before {
  content: "не опрашивается";
  display: inline-block;
  margin: 0 0 4px;
  padding: 1px 6px;
  font-size: 11px;
  color: var(--muted);
  border: 1px dashed var(--muted);
  border-radius: 3px;
}
/* Подробности регистра: параметры, к которым обращаются редко. */
.cfg-details {
  display: grid;
  gap: 4px;
  padding: 6px 8px;
  background: var(--panel-2);
  border-left: 2px solid var(--accent);
}
.cfg-details .toolbar { margin: 0; gap: 8px; }

.cfg-field { display: grid; gap: 2px; font-size: 11px; color: var(--muted); }
.cfg-field input, .cfg-field select { min-width: 90px; }
.cfg-regs { font-size: 12px; }
.cfg-regs td { padding: 3px 6px; }
.cfg-regs input, .cfg-regs select { padding: 3px 6px; }
/* ── Имитация ─────────────────────────────────────────────────────── */

/* Величина встроенного имитатора отличается от измеренной на каждом экране.
   Штриховка по краю, а не только подпись: подпись теряется среди фоновой
   графики мнемосхемы, а полоса видна периферийным зрением. */
.w-sim { outline: 1.5px dashed var(--warn); outline-offset: 1px; }

.sim-tag {
  font-size: 10px;
  padding: 0 5px;
  border-radius: 3px;
  border: 1px solid var(--warn);
  color: var(--warn);
  letter-spacing: .4px;
  white-space: nowrap;
}

/* Полоса имитации в заголовке — рядом с полосой открытого режима. */
.sim-banner {
  grid-area: open;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 6px 14px;
  background: repeating-linear-gradient(
    135deg, var(--panel-2), var(--panel-2) 10px, var(--panel) 10px, var(--panel) 20px);
  border-bottom: 1px solid var(--warn);
  color: var(--warn);
  font-size: 12px;
}

/* Строка таблицы с имитацией. */
tr.row-sim td:first-child { border-left: 3px solid var(--warn); }
/* Замечания к настройке при запуске: не ошибка, но объясняет то, что
   иначе выглядит неисправностью. */
.startup-notes {
  grid-area: notes;
  padding: 8px 14px;
  background: var(--panel);
  border-bottom: 1px solid var(--warn);
  color: var(--text);
  font-size: 13px;
}
.startup-notes p { margin: 2px 0; }
.startup-notes .head { color: var(--muted); font-size: 12px; }

/* Кнопка палитры переносится на схему: курсор говорит об этом до того,
   как человек попробует. */
.palette button[draggable="true"] { cursor: grab; }
.palette button[draggable="true"]:active { cursor: grabbing; }

/* Меню правой кнопки на схеме: слой и порядок отрисовки. */
.ctx-menu {
  position: fixed;
  z-index: 60;
  min-width: 200px;
  padding: 4px;
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 8px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.28);
  display: flex;
  flex-direction: column;
  gap: 1px;
}
.ctx-menu button {
  text-align: left;
  border: 0;
  background: transparent;
  padding: 6px 10px;
  border-radius: 5px;
}
.ctx-menu button:hover:not(:disabled) { background: var(--accent); color: #fff; }
.ctx-menu button:disabled { opacity: 0.5; cursor: default; }
.ctx-menu .menu-head {
  padding: 6px 10px 2px;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: .05em;
  color: var(--muted);
}

/* Готовая настройка для ассистента: длинная строка с путём к программе.
 *
 * Прокручивается сам блок, а не страница: путь в Windows длиннее ширины
 * колонки почти всегда, и без этого горизонтальная полоса появлялась у всего
 * экрана — уезжало и меню, и всё остальное. */
pre.mono {
  overflow-x: auto;
  margin: 8px 0;
  padding: 10px 12px;
  border: 1px solid var(--line);
  border-radius: 6px;
  background: var(--panel-2);
  font-size: 12px;
  line-height: 1.45;
  white-space: pre;
}
