.program-list-item .muted { font-size: 11px; }
.program-editor-head, .fbd-network-title { display: flex; justify-content: space-between; gap: 12px; align-items: center; margin: 2px 0 10px; }
.program-editor-head { font-size: 14px; }
.program-toolbar { flex-wrap: wrap; }
.program-runtime-status { display: grid; gap: 7px; margin: 10px 0 14px; padding: 10px; border: 1px solid var(--line); border-radius: 7px; background: var(--panel-2); }
.program-runtime-head { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
.program-runtime-values { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 6px; }
