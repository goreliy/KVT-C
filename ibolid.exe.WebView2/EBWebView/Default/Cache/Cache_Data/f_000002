// Клиент REST и подписки I-Bolid (ТЗ 14).
//
// Слой знает про сеть и ничего не знает про разметку. Два свойства, ради
// которых он вынесен отдельно:
//
//  * Токен хранится в одном месте и подставляется в каждый запрос. Забытый
//    заголовок означал бы «не авторизован» вместо данных.
//  * Состояние связи с сервером — наблюдаемая величина. Интерфейс обязан
//    отличать «величина не менялась» от «сервера нет» (ТЗ 13.3.6), и решать
//    это на глаз по времени последнего обновления нельзя.

export const API = '/api/v1';

const TOKEN_KEY = 'ibolid.token';

/** Ошибка запроса с машиночитаемым кодом сервера. */
export class ApiError extends Error {
  constructor(status, code, message) {
    super(message || code || `HTTP ${status}`);
    this.status = status;
    this.code = code || 'HTTP_' + status;
  }
}

export const session = {
  get token() { return sessionStorage.getItem(TOKEN_KEY) || ''; },
  set token(v) { v ? sessionStorage.setItem(TOKEN_KEY, v) : sessionStorage.removeItem(TOKEN_KEY); },
  login: '',
  role: '',
  /// Учётных записей ещё нет: система работает открыто (FR-903.12).
  unclaimed: false,
};

/** Есть ли доступ к данным: либо сеанс, либо открытый режим первого запуска. */
export function authorized() {
  return session.unclaimed || !!session.token;
}

/** Роли по возрастанию прав — тот же порядок, что на сервере. */
const ROLE_ORDER = ['viewer', 'operator', 'engineer', 'admin'];

/**
 * Хватает ли роли сеанса.
 *
 * Это подсказка интерфейсу, а не охрана: право всё равно проверяет сервер.
 * Нужна, чтобы не показывать кнопку, которая заведомо ответит отказом.
 */
export function hasRole(minimum) {
  const have = ROLE_ORDER.indexOf(session.role);
  const need = ROLE_ORDER.indexOf(minimum);
  return have >= 0 && need >= 0 && have >= need;
}

async function request(method, path, {
  body, query, auth = true, headers: suppliedHeaders = {},
} = {}) {
  const url = new URL(API + path, location.origin);
  if (query) {
    for (const [k, v] of Object.entries(query)) {
      if (v !== undefined && v !== null && v !== '') url.searchParams.set(k, v);
    }
  }
  const headers = { ...suppliedHeaders };
  if (body !== undefined) headers['Content-Type'] = 'application/json';
  if (auth && session.token) headers['Authorization'] = 'Bearer ' + session.token;

  let response;
  try {
    response = await fetch(url, {
      method,
      headers,
      body: body === undefined ? undefined : JSON.stringify(body),
    });
  } catch (e) {
    // Сеть недоступна — это не ошибка приложения, и путать её с отказом
    // сервера нельзя: причины разные, и действия оператора тоже.
    throw new ApiError(0, 'NETWORK', 'сервер недоступен');
  }

  if (response.status === 204) return null;

  let payload = null;
  const text = await response.text();
  if (text) {
    try { payload = JSON.parse(text); } catch { payload = null; }
  }

  if (!response.ok) {
    const code = payload && payload.code;
    const message = payload && payload.message;
    if (response.status === 401) session.token = '';
    throw new ApiError(response.status, code, message);
  }
  return payload;
}

export const api = {
