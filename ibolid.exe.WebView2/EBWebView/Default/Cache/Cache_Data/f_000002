/**
 * Живой срез значений.
 *
 * Подписка ведётся по WebSocket, а при его недоступности — опросом ресурса
 * изменений. Второй путь не «запасной для старых браузеров»: в закрытом
 * контуре между постом и сервером нередко стоит посредник, не пропускающий
 * обновление протокола, и без опроса интерфейс там просто не работал бы.
 */
export class LiveTags extends EventTarget {
  constructor() {
    super();
    this.tags = new Map();
    this.revision = 0;
    this.state = 'connecting';
    this.socket = null;
    this.timer = null;
    this.pollTimer = null;
    this.stopped = false;
    this.retryDelay = 1000;
  }

  /** Состояние связи: `live`, `connecting`, `lost`. */
  setState(state) {
    if (this.state === state) return;
    this.state = state;
    this.dispatchEvent(new CustomEvent('state', { detail: state }));
  }

  start() {
    this.stopped = false;
    this.openSocket();
  }

  stop() {
    this.stopped = true;
    if (this.socket) { this.socket.onclose = null; this.socket.close(); this.socket = null; }
    clearTimeout(this.timer);
    clearInterval(this.pollTimer);
    this.pollTimer = null;
  }

  openSocket() {
    if (this.stopped) return;
    const scheme = location.protocol === 'https:' ? 'wss:' : 'ws:';
    const url = `${scheme}//${location.host}${API}/ws?token=${encodeURIComponent(session.token)}&pattern=*`;
    let socket;
    try {
      socket = new WebSocket(url);
    } catch {
      this.fallbackToPolling();
      return;
    }
    this.socket = socket;
    this.setState('connecting');

    socket.onopen = () => {
      this.retryDelay = 1000;
      this.stopPolling();
      this.setState('live');
    };
    socket.onmessage = (e) => {
      let update;
      try { update = JSON.parse(e.data); } catch { return; }
      if (!update || !Array.isArray(update.tags)) return;
      if (update.type === 'snapshot') this.tags.clear();
      this.apply(update.tags);
    };
    socket.onerror = () => { /* обработается в onclose */ };
    socket.onclose = () => {
      this.socket = null;
      if (this.stopped) return;
      this.setState('lost');
      // Пока соединение поднимается заново, значения берутся опросом:
      // экран не должен замирать на неопределённое время.
      this.fallbackToPolling();
      this.timer = setTimeout(() => this.openSocket(), this.retryDelay);
      this.retryDelay = Math.min(this.retryDelay * 2, 15000);
    };
  }

  fallbackToPolling() {
    if (this.pollTimer || this.stopped) return;
    this.pollTimer = setInterval(() => this.pollOnce(), 2000);
    this.pollOnce();
  }

  stopPolling() {
    clearInterval(this.pollTimer);
    this.pollTimer = null;
  }

  async pollOnce() {
    try {
      const r = await api.changes(this.revision);
      if (r.truncated) {
        // Клиент отстал: накопленной очереди не хватило, и достраивать срез
        // по обрывкам нельзя — берётся полный снимок (FR-813.4).
        await this.loadSnapshot();
        return;
      }
      this.revision = r.revision;
      this.apply(r.tags);
      this.setState('live');
    } catch (e) {
      this.setState('lost');
    }
  }

  async loadSnapshot() {
    try {
      const r = await api.snapshot();
      this.revision = r.revision;
      this.tags.clear();
      this.apply(r.tags);
      this.setState('live');
    } catch {
      this.setState('lost');
    }
  }

  apply(views) {
    for (const view of views) this.tags.set(view.name, view);
    if (views.length) this.dispatchEvent(new CustomEvent('tags', { detail: views }));
  }

  get(name) { return this.tags.get(name); }
  all() { return [...this.tags.values()]; }
}
